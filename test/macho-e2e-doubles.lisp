;;;; test/macho-e2e-doubles.lisp -- libSystem, played by Linux, so the macOS host code can run
;;;; the REAL Darwin-layout image under qemu-aarch64 (test/run-macho-e2e.sh).
;;;;
;;;; Each IMPL-C-<name> takes Darwin's arguments in Darwin's layouts (flags, struct stat,
;;;; sigaction, dirent, timeval, signal numbers, errno), does the job with a Linux syscall,
;;;; and answers as Darwin would.  So host/macos/shim.lisp runs unchanged: dyld's binds are
;;;; replaced by these addresses in the GOT, nothing else.  What this proves: the host's
;;;; start-up (remap, BSS tail, syscall slot, the Linux initial stack, the keys, the fault
;;;; handler), SYSCALL-STUB and MODUS-SYSCALL serve a whole modus boot and evaluation, and
;;;; every translation round-trips.  What it cannot prove: that these doubles behave as the
;;;; real libSystem does -- their Darwin constants come from the same headers as the shim's,
;;;; so a header misread would be repeated on both sides.  Threads are not run: Linux user
;;;; space cannot give a thread its own TPIDRRO_EL0, which the image reads its delta through
;;;; (pthread_create answers EAGAIN).  The process's TSD is page 0, mapped at start-up, as on
;;;; Darwin TPIDRRO_EL0 points at the thread's TSD and the image reads key 300 at +2400.

(defasm lsys (:mov x8 x0) (:mov x0 x1) (:mov x1 x2) (:mov x2 x3) (:mov x3 x4) (:mov x4 x5)
  (:mov x5 x6) (:svc) (:ret))
(defmacro sys (nr &rest args)
  `(lsys ,nr ,@args ,@(make-list (- 6 (length args)) :initial-element 0)))

(defdata e-errno 8)
(defdata e-envp 8)
(defdata impl-mach-task-self 8)        ; mach_task_self_: the doubles ignore the task
(defdata e-keys 8)
(defdata e-heap 8)
(defdata e-heap-end 8)
(defdata e-handlers 512)                ; Darwin handler per Linux signal

(defun darwin-errno (l)
  (let ((d 1))
    (while (< d 120) (when (= (lx-errno d) l) (return d)) (setq d (+ d 1)))
    l))
(defun lin (r)
  "A Linux syscall result as libSystem answers: -1 and errno (Darwin's numbering) on failure."
  (if (and (< r 0) (> r -4096)) (progn (st32 (addr e-errno) (darwin-errno (- 0 r))) -1) r))
(defun impl-c-error () (addr e-errno))
(defun lx-dirfd (d) (if (= (sext32 d) -2) -100 (sext32 d)))
(defun lx-open-flags (f)
  (let ((o (logand f 3)))
    (when (logtest f #x200) (set-or o #x40)) (when (logtest f #x800) (set-or o #x80))
    (when (logtest f #x20000) (set-or o #x100)) (when (logtest f #x400) (set-or o #x200))
    (when (logtest f #x8) (set-or o #x400)) (when (logtest f #x4) (set-or o #x800))
    (when (logtest f #x100000) (set-or o #x4000)) (when (logtest f #x100) (set-or o #x8000))
    (when (logtest f #x1000000) (set-or o #x80000))
    o))
(defun lx-at-flags (f)
  (let ((o 0)) (when (logtest f #x20) (set-or o #x100)) (when (logtest f #x80) (set-or o #x200)) o))
(defun lx-sig (d) (let ((l 1)) (while (< l 32) (when (= (dx-sig l) d) (return l)) (setq l (+ l 1))) d))

;;; memory, strings
(defun impl-c-strlen (s) (let ((n 0)) (while (ld8 (+ s n)) (setq n (+ n 1))) n))
(defun impl-c-memcpy (d s n)
  (let ((i 0))
    (when (= (logand (logior d s) 7) 0)
      (while (<= (+ i 8) n) (st64 (+ d i) (ld64 (+ s i))) (setq i (+ i 8))))
    (while (< i n) (st8 (+ d i) (ld8 (+ s i))) (setq i (+ i 1))))
  d)
(defun impl-c-memset (d v n) (let ((i 0)) (while (< i n) (st8 (+ d i) v) (setq i (+ i 1)))) d)
(defun impl-c-malloc (n)
  (when (= (ld64 (addr e-heap)) 0)
    (let ((p (sys 222 0 #x10000000 3 #x22 -1 0)))
      (st64 (addr e-heap) p) (st64 (addr e-heap-end) (+ p #x10000000))))
  (let ((p (ld64 (addr e-heap))) (sz (logand (+ n 15) -16)))
    (when (u> (+ p sz) (ld64 (addr e-heap-end))) (return 0))
    (st64 (addr e-heap) (+ p sz))
    p))
(defun impl-c-calloc (n s) (let ((p (impl-c-malloc (* n s)))) (when p (impl-c-memset p 0 (* n s))) p))
(defun impl-c-free (p) 0)
(defun impl-c-getenv (name)
  (let ((e (ld64 (addr e-envp))) (n (impl-c-strlen name)))
    (while (ld64 e)
      (let ((s (ld64 e)) (i 0) (ok 1))
        (while (< i n) (when (/= (ld8 (+ s i)) (ld8 (+ name i))) (setq ok 0) (break)) (setq i (+ i 1)))
        (when (and ok (= (ld8 (+ s n)) 61)) (return (+ s n 1))))
      (setq e (+ e 8)))
    0))

