(defvar *syms* (loop for i below 600 collect (intern (format nil "PL-~D" i))))
(dolist (s *syms*) (setf (get s 'a) (symbol-name s)) (setf (get s 'b) 1))
(print (list :all-a (every (lambda (s) (equal (get s 'a) (symbol-name s))) *syms*)))
(dolist (s *syms*) (incf (get s 'b)))
(print (list :all-b (every (lambda (s) (eql (get s 'b) 2)) *syms*)))
(let ((s (first *syms*))) (remprop s 'a) (print (list :remprop-a (get s 'a :gone) (get s 'b))))
(let ((s (second *syms*))) (remprop s 'b) (print (list :remprop-b (get s 'a) (get s 'b :gone))))
(let ((s (third *syms*))) (setf (symbol-plist s) (list 'z 9)) (print (list :setplist (get s 'z) (get s 'a :gone) (symbol-plist s))))
(let ((u (make-symbol "U"))) (print (list :unint (get u 'q :none) (progn (setf (get u 'q) 5) (get u 'q)))))
(print (list :kw (progn (setf (get :kwp 'x) 7) (get :kwp 'x)) :nil (get nil 'zz :d)))
(let ((s (fourth *syms*))) (dotimes (i 5) (get s 'a)) (setf (get s 'a) :new) (print (list :overwrite (get s 'a))))
(print (list :count (count-if (lambda (s) (get s 'a)) *syms*)))
