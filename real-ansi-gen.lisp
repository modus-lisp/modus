            (INTERN SNAME PNAME)
            (LET ((%MVB*-TMP (MULTIPLE-VALUE-LIST (FIND-SYMBOL SNAME P))))
              (CHECK-VALUES-LENGTH %MVB*-TMP 2 '(FIND-SYMBOL SNAME P))
