(defun fcntl3 (fd cmd arg)
  (cond ((= cmd 3) (let ((r (lin (sys 25 fd 3))))
                     (if (< r 0) r (logior (logand r 3) (if (logtest r #x800) 4 0) (if (logtest r #x400) 8 0)))))
        ((= cmd 4) (lin (sys 25 fd 4 (logior (logand arg 3) (if (logtest arg 4) #x800 0) (if (logtest arg 8) #x400 0)))))
        (t (lin (sys 25 fd cmd arg)))))
(defasm impl-c-fcntl (:ldr x2 sp 0) (:b fcntl3))
(defun impl-c-poll (fds n ms)
  (with-buffers ((ts 16))
    (st64 ts (sdiv ms 1000)) (st64 ts (* (- ms (* 1000 (sdiv ms 1000))) 1000000) 8)
    (lin (sys 73 fds n (if (< (sext32 ms) 0) 0 ts) 0 8))))

;;; directories: DIR = { fd, pos, len, -, dirent @32 (Darwin's), getdents buffer @2048 }
(defun impl-c-fdopendir (fd)
  ;; Darwin's fdopendir refuses what is not a directory (ENOTDIR), as getdents64 does
  (with-buffers ((l 128))
    (when (< (lin (sys 80 fd l)) 0) (return 0))
    (when (/= (logand (ld32 l 16) #o170000) #o040000) (st32 (addr e-errno) 20) (return 0)))
  (let ((d (impl-c-calloc 1 8192))) (st64 d fd 0) d))
(defun impl-c-closedir (d) (lin (sys 57 (ld64 d 0))))
(defun impl-c-readdir (d)
  (when (>= (ld64 d 8) (ld64 d 16))
    (let ((r (sys 61 (ld64 d 0) (+ d 2048) 4096)))
      (when (<= r 0) (return 0))
      (st64 d 0 8) (st64 d r 16)))
  (let* ((rec (+ d 2048 (ld64 d 8))) (e (+ d 32)) (n (impl-c-strlen (+ rec 19))))
    (impl-c-memset e 0 32)
    (st64 e (ld64 rec 0) 0) (st16 e (ld16 rec 16) 16) (st16 e n 18) (st8 e (ld8 rec 18) 20)
    (impl-c-memcpy (+ e 21) (+ rec 19) (+ n 1))
    (st64 d (+ (ld64 d 8) (ld16 rec 16)) 8)
    e))

;;; memory maps
(defun impl-c-mmap (a l p f fd off)
  ;; MAP_JIT (0x800) has no Linux counterpart: Linux allows RWX
  (lin (sys 222 a l p (logior (logand f #x13) (if (logtest f #x1000) #x20 0)) fd off)))
(defun impl-c-munmap (a l) (lin (sys 215 a l)))
(defun impl-c-mprotect (a l p) (lin (sys 226 a l p)))
(defun impl-c-mlock (a l) (lin (sys 228 a l)))
(defun impl-c-pthread-jit-write-protect-np (x) 0)
(defun impl-c-mach-vm-allocate (task ap size flags)
  (if (= (sys 222 (ld64 ap) size 3 #x100022 -1 0) (ld64 ap)) 0 3))   ; KERN_NO_SPACE
;;; mach_vm_remap of the image: on Linux, a fixed RWX copy at the target address
(defasm impl-c-mach-vm-remap (:b remap8))
(defun remap8 (task ap size mask flags stask src copy)
  (if (/= (sys 222 (ld64 ap) size 7 #x100022 -1 0) (ld64 ap))
      3
      (progn (impl-c-memcpy (ld64 ap) src size) 0)))

;;; signals
(defun impl-c-kill (pid sig) (lin (sys 129 pid (lx-sig sig))))
(defun impl-c-sigprocmask (how set old)
  (with-buffers ((ls 8) (lo 8))
    (when set (st64 ls (lx-sigset (ld32 set))))
    (let ((r (lin (sys 135 (- how 1) (if set ls 0) lo 8))))
      (when (and (>= r 0) old) (st32 old (dx-sigset (ld64 lo))))
      r)))
(defun impl-c-sigaltstack (nw old)
  (with-buffers ((ln 24) (lo 24))
    (when nw (st64 ln (ld64 nw)) (st64 ln (if (logtest (ld32 nw 16) 4) 2 0) 8) (st64 ln (ld64 nw 8) 16))
    (let ((r (lin (sys 132 (if nw ln 0) lo))))
      (when (and (>= r 0) old)
        (st64 old (ld64 lo)) (st64 old (ld64 lo 16) 8)
        (st32 old (logior (logand (ld32 lo 8) 1) (if (logtest (ld32 lo 8) 2) 4 0)) 16))
      r)))
(defun impl-c-sigaction (dsig nw old)
  (let* ((l (lx-sig dsig)) (slot (+ (addr e-handlers) (* 16 l))))
    (when old (st64 old (ld64 slot)) (st32 old 0 8) (st32 old (ld32 slot 8) 12))
    (when nw
      (with-buffers ((ka 32))
        ;; always SA_SIGINFO (the trampoline reads siginfo and ucontext); no SA_RESTORER:
        ;; the kernel (here qemu) supplies the return path
        (let ((df (ld32 nw 12)) (f 4))
          (when (logtest df 1) (set-or f #x08000000)) (when (logtest df 2) (set-or f #x10000000))
          (when (logtest df #x10) (set-or f #x40000000)) (when (logtest df 4) (set-or f #x80000000))
          (st64 slot (ld64 nw)) (st64 slot df 8)
          (st64 ka (if (u<= (ld64 nw) 1) (ld64 nw) (addr sig-tramp)))
          (st64 ka f 8) (st64 ka 0 16) (st64 ka (lx-sigset (ld32 nw 8)) 24)
          (return (lin (sys 134 l ka 0 8))))))
    0))
;;; a Linux signal, delivered as Darwin delivers it: Darwin siginfo and ucontext/mcontext
(defun sig-tramp (lsig lsi luc)
  (with-buffers ((dsi 128) (duc 64) (dmc 832))
    (let ((i 0))
      (impl-c-memset dsi 0 128) (impl-c-memset duc 0 64) (impl-c-memset dmc 0 832)
      (st32 dsi (dx-sig lsig) 0) (st32 dsi (ld32 lsi 8) 8) (st64 dsi (ld64 lsi 16) 24)
      (st64 duc dmc 48)
      (while (< i 29) (st64 (+ dmc 16 (* 8 i)) (ld64 (+ luc 184 (* 8 i)))) (setq i (+ i 1)))
      (st64 dmc (ld64 luc (+ 184 232)) 248) (st64 dmc (ld64 luc (+ 184 240)) 256)
      (st64 dmc (ld64 luc 432) 264) (st64 dmc (ld64 luc 440) 272) (st32 dmc (ld64 luc 448) 280)
      (callptr (ld64 (+ (addr e-handlers) (* 16 lsig))) (dx-sig lsig) dsi duc))))

;;; sockets: Darwin sockaddr (u8 len, u8 family; AF_INET6 30) <-> Linux (u16 family; 10)
(defun lx-sa (d len out)
  (impl-c-memcpy out d len)
  (st16 out (if (= (ld8 d 1) 30) 10 (ld8 d 1)))
  len)
(defun dw-sa (l d lenp n)
  (when (and d lenp)
    (let ((m (if (u< n (ld32 lenp)) n (ld32 lenp))) (fam (ld16 l)))
      (impl-c-memcpy d l m)
      (when (>= m 2) (st8 d n) (st8 d (if (= fam 10) 30 fam) 1))
      (st32 lenp n)))
  0)
(defun impl-c-socket (dom type proto) (lin (sys 198 (if (= dom 30) 10 dom) type proto)))
(defun impl-c-bind (fd sa len) (with-buffers ((l 128)) (lin (sys 200 fd l (lx-sa sa len l)))))
(defun impl-c-connect (fd sa len) (with-buffers ((l 128)) (lin (sys 203 fd l (lx-sa sa len l)))))
(defun impl-c-listen (fd n) (lin (sys 201 fd n)))
(defun impl-c-shutdown (fd h) (lin (sys 210 fd h)))
(defun name-call (nr fd sa lenp)
  (with-buffers ((l 128) (n 8))
    (st32 n 128)
    (let ((r (lin (sys nr fd l n))))
      (when (>= r 0) (dw-sa l sa lenp (ld32 n)))
      r)))
(defun impl-c-accept (fd sa lenp) (name-call 202 fd sa lenp))
(defun impl-c-getsockname (fd sa lenp) (name-call 204 fd sa lenp))
(defun impl-c-getpeername (fd sa lenp) (name-call 205 fd sa lenp))
(defun lx-sockopt (lvl opt)
  (if (= lvl #xFFFF)
      (cond ((= opt 4) 2) ((= opt #x1007) 4) ((= opt #x20) 6) ((= opt #x1001) 7) ((= opt #x1002) 8)
            ((= opt 8) 9) ((= opt #x80) 13) ((= opt #x200) 15) ((= opt #x1006) 20) ((= opt #x1005) 21)
            (t -1))
      opt))
(defun impl-c-setsockopt (fd lvl opt v len)
  (when (and (= lvl #xFFFF) (= opt #x1022)) (return 0))          ; SO_NOSIGPIPE: nothing on Linux
  (let ((o (lx-sockopt lvl opt)) (ll (if (= lvl #xFFFF) 1 lvl)))
    (when (< o 0) (st32 (addr e-errno) 42) (return -1))
    (if (or (= o 20) (= o 21))
        (with-buffers ((tv 16)) (st64 tv (ld64 v)) (st64 tv (lds32 v 8) 8) (lin (sys 208 fd ll o tv 16)))
        (lin (sys 208 fd ll o v len)))))
(defun impl-c-getsockopt (fd lvl opt v lenp)
  (let ((o (lx-sockopt lvl opt)) (ll (if (= lvl #xFFFF) 1 lvl)))
    (when (< o 0) (st32 (addr e-errno) 42) (return -1))
    (lin (sys 209 fd ll o v lenp))))
(defun impl-c-sendto (fd b n fl sa len)
  (with-buffers ((l 128))
    (lin (sys 206 fd b n fl (if sa l 0) (if sa (lx-sa sa len l) 0)))))
(defun impl-c-recvfrom (fd b n fl sa lenp)
  (with-buffers ((l 128) (m 8))
    (st32 m 128)
    (let ((r (lin (sys 207 fd b n fl (if sa l 0) (if sa m 0)))))
      (when (and (>= r 0) sa) (dw-sa l sa lenp (ld32 m)))
      r)))

