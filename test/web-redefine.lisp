;;; Redefining a runtime DEFUN must reach callers already translated (web
;;; image: late-binding thunks, mvm/build-web.lisp).  Prints WEB-REDEFINE PASS/FAIL.
(defvar *fails* 0)
(defun chk (name got want)
  (unless (equal got want) (incf *fails*) (format t "~&FAIL ~A: got ~S want ~S~%" name got want)))
(defun rf (x) (+ x 1))
(defun rg (x) (rf x))
(dotimes (i 300) (rg i))
(chk :before (rg 10) 11)
(defun rf (x) (* x 100))
(chk :after (rg 10) 1000)
(dotimes (i 300) (rg i))
(chk :after-hot (rg 10) 1000)
(defun rf (x) (- x))
(dotimes (i 300) (rg i))
(chk :third (rg 10) -10)
(setf (fdefinition 'rf) (let ((k 7)) (lambda (x) (+ x k))))
(chk :closure (rg 10) 17)
(dotimes (i 300) (rg i))
(chk :closure-hot (rg 10) 17)
(fmakunbound 'rf)
(chk :unbound (handler-case (rg 10) (undefined-function () :undef)) :undef)
(defun rf (x) (list x))
(chk :rebound (rg 10) '(10))
;; a caller made AFTER the callee went native
(defun hf (x) (* 2 x))
(dotimes (i 300) (hf i))
(defun hg (x) (+ 1 (hf x)))
(dotimes (i 300) (hg i))
(chk :late-caller (hg 5) 11)
(defun hf (x) (* 3 x))
(chk :late-caller-redef (hg 5) 16)
;; mutual recursion, then redefine one side
(defun ev (n) (if (= n 0) t (od (1- n))))
(defun od (n) (if (= n 0) nil (ev (1- n))))
(dotimes (i 200) (ev 50))
(chk :mutual (list (ev 10) (ev 7)) '(t nil))
(defun od (n) (declare (ignore n)) :odd-stub)
(chk :mutual-redef (ev 10) :odd-stub)
(format t "~&WEB-REDEFINE ~A (~D failed)~%" (if (zerop *fails*) "PASS" "FAIL") *fails*)
