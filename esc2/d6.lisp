(defun say (k v) (princ (concatenate (quote string) k "=" (princ-to-string v))) (terpri) (finish-output))
(defun hx (n) (format nil "~X" n))
(defun rd32 (a) (mem-ref a :u32))
(defun wr32 (a v) (setf (mem-ref a :u32) v))
(say "A.const-read" (mem-ref #x10000C30 :u32))
(say "B.var-read"   (rd32 #x10000C30))
(say "C.dbl-read"   (rd32 (* 2 #x10000C30)))
(wr32 #x10000C30 4242)
(say "D.after-var-write" (list (rd32 #x10000C30) (rd32 (* 2 #x10000C30)) (mem-ref #x10000C30 :u32)))
(wr32 (* 2 #x10000C30) 7777)
(say "E.after-dbl-write" (list (rd32 #x10000C30) (rd32 (* 2 #x10000C30)) (mem-ref #x10000C30 :u32)))
(say "END" "ok")
