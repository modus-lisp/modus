  (puthash "CHAR>" ht #'char>)
  (puthash "CHAR<=" ht #'char<=)
  (puthash "CHAR>=" ht #'char>=)
  (puthash "CHAR/=" ht #'char/=)
  (puthash "CHAR-UPCASE" ht #'char-upcase)
