(defun %init-runtime-macros-1 ()
  (puthash 8349137 *macro-table* (LAMBDA (FORM)
                                   (LET ((CLAUSES (CDR FORM)))
                                     (IF (NULL CLAUSES)
                                         NIL
                                         (LET ((CLAUSE (CAR CLAUSES)))
                                           (IF (AND (SYMBOLP (CAR CLAUSE))
                                                    (=
                                                     (COMPUTE-NAME-HASH
                                                      (SYMBOL-NAME
                                                       (CAR CLAUSE)))
                                                     47238915))
                                               `(PROGN ,@(CDR CLAUSE))
                                               (IF (NULL (CDR CLAUSE))
                                                   (LET ((TMP
                                                          (%MVM-GENSYM
                                                           "CONDV")))
                                                     `(LET ((,TMP
                                                             ,(CAR CLAUSE)))
                                                        (IF ,TMP
                                                            ,TMP
                                                            (COND
                                                             ,@(CDR
                                                                CLAUSES)))))
                                                   `(IF ,(CAR CLAUSE)
                                                        (PROGN ,@(CDR CLAUSE))
                                                        (COND
                                                         ,@(CDR CLAUSES))))))))))
  (puthash 460426964 *macro-table* (LAMBDA (FORM)
                                     (LET ((ARGS (CDR FORM)))
                                       (COND ((NULL ARGS) T)
                                             ((NULL (CDR ARGS)) (CAR ARGS))
                                             (T
                                              `(IF ,(CAR ARGS)
                                                   (AND ,@(CDR ARGS))
                                                   NIL))))))
  (puthash 176230690 *macro-table* (LAMBDA (FORM)
                                     (LET ((ARGS (CDR FORM)))
                                       (COND ((NULL ARGS) NIL)
                                             ((NULL (CDR ARGS)) (CAR ARGS))
                                             (T
                                              (LET ((TMP (%MVM-GENSYM "OR")))
                                                `(LET ((,TMP ,(CAR ARGS)))
                                                   (IF ,TMP
                                                       ,TMP
                                                       (OR ,@(CDR ARGS))))))))))
  (puthash 253387447 *macro-table* (LAMBDA (FORM)
                                     (LET ((SLOT-SPECS (CADR FORM))
                                           (INSTANCE-FORM (CADDR FORM))
                                           (BODY (CDDDR FORM))
                                           (INST-TMP (%MVM-GENSYM "WS-INST")))
                                       `(LET ((,INST-TMP ,INSTANCE-FORM))
                                          (SYMBOL-MACROLET ,(MAPCAR
                                                             (LAMBDA (SPEC)
                                                               (IF (CONSP SPEC)
                                                                   `(,(CAR
                                                                       SPEC)
                                                                     (SLOT-VALUE
                                                                      ,INST-TMP
                                                                      ',(CADR
                                                                         SPEC)))
                                                                   `(,SPEC
                                                                     (SLOT-VALUE
                                                                      ,INST-TMP
                                                                      ',SPEC))))
                                                             SLOT-SPECS)
                                            ,@BODY)))))
  (puthash 3290562 *macro-table* (LAMBDA (FORM) `(PROGN ,@(CDDR FORM))))
  nil)
