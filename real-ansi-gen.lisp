(IN-PACKAGE "CL-TEST")
(DEFMACRO DEF-PPRINT-TABULAR-TEST
          (NAME ARGS EXPECTED-VALUE &KEY (MARGIN 100) (CIRCLE NIL) (PRE NIL))
  `(DEFTEST ,NAME
    (LET ((*PACKAGE* (FIND-PACKAGE "COMMON-LISP-USER"))
          (*PRINT-ARRAY* T)
          (*PRINT-BASE* 10)
          (*PRINT-CASE* :UPCASE)
          (*PRINT-CIRCLE* NIL)
          (*PRINT-ESCAPE* T)
          (*PRINT-GENSYM* T)
          (*PRINT-LENGTH* NIL)
          (*PRINT-LEVEL* NIL)
          (*PRINT-READABLY* T)
          (*PRINT-PRETTY* NIL)
          (*PRINT-RADIX* NIL)
          (*READ-BASE* 10)
          (*READ-SUPPRESS* NIL)
          (*READ-EVAL* T))
      (DECLARE
       (SPECIAL *PACKAGE* *PRINT-ARRAY* *PRINT-BASE* *PRINT-CASE*
        *PRINT-CIRCLE* *PRINT-ESCAPE* *PRINT-GENSYM* *PRINT-LENGTH*
        *PRINT-LEVEL* *PRINT-READABLY* *PRINT-PRETTY* *PRINT-RADIX* *READ-BASE*
        *READ-SUPPRESS* *READ-EVAL*))
      (LET ((*PRINT-PRETTY* T)
            (*PRINT-READABLY* NIL)
            (*PRINT-RIGHT-MARGIN* ,MARGIN)
            (*PACKAGE* (FIND-PACKAGE "CL-TEST"))
            (*PRINT-CIRCLE* ,CIRCLE))
        (DECLARE
         (SPECIAL *PRINT-PRETTY* *PRINT-READABLY* *PRINT-RIGHT-MARGIN*
          *PACKAGE* *PRINT-CIRCLE*))
        (LET ((S (MAKE-STRING-OUTPUT-STREAM)))
          ,@(WHEN PRE (LIST PRE))
          (PPRINT-TABULAR S ,@ARGS)
          (GET-OUTPUT-STREAM-STRING S))))
    ,EXPECTED-VALUE))
