           (w64-column (w-f0 w-g2) (w-f1-2 w-g1) (w-f2 w-g0) (w-f3-2 w-g9-19) (w-f4 w-g8-19) (w-f5-2 w-g7-19) (w-f6 w-g6-19) (w-f7-2 w-g5-19) (w-f8 w-g4-19) (w-f9-2 w-g3-19))
           (w64-add w-lo w-hi w-cl w-ch)
           (w64-carry w-r2 26)
           (w64-column (w-f0 w-g3) (w-f1 w-g2) (w-f2 w-g1) (w-f3 w-g0) (w-f4 w-g9-19) (w-f5 w-g8-19) (w-f6 w-g7-19) (w-f7 w-g6-19) (w-f8 w-g5-19) (w-f9 w-g4-19))
           (w64-add w-lo w-hi w-cl w-ch)
           (w64-carry w-r3 25)
           (w64-column (w-f0 w-g4) (w-f1-2 w-g3) (w-f2 w-g2) (w-f3-2 w-g1) (w-f4 w-g0) (w-f5-2 w-g9-19) (w-f6 w-g8-19) (w-f7-2 w-g7-19) (w-f8 w-g6-19) (w-f9-2 w-g5-19))
           (w64-add w-lo w-hi w-cl w-ch)
           (w64-carry w-r4 26)
           (w64-column (w-f0 w-g5) (w-f1 w-g4) (w-f2 w-g3) (w-f3 w-g2) (w-f4 w-g1) (w-f5 w-g0) (w-f6 w-g9-19) (w-f7 w-g8-19) (w-f8 w-g7-19) (w-f9 w-g6-19))
           (w64-add w-lo w-hi w-cl w-ch)
           (w64-carry w-r5 25)
           (w64-column (w-f0 w-g6) (w-f1-2 w-g5) (w-f2 w-g4) (w-f3-2 w-g3) (w-f4 w-g2) (w-f5-2 w-g1) (w-f6 w-g0) (w-f7-2 w-g9-19) (w-f8 w-g8-19) (w-f9-2 w-g7-19))
           (w64-add w-lo w-hi w-cl w-ch)
           (w64-carry w-r6 26)
           (w64-column (w-f0 w-g7) (w-f1 w-g6) (w-f2 w-g5) (w-f3 w-g4) (w-f4 w-g3) (w-f5 w-g2) (w-f6 w-g1) (w-f7 w-g0) (w-f8 w-g9-19) (w-f9 w-g8-19))
           (w64-add w-lo w-hi w-cl w-ch)
           (w64-carry w-r7 25)
           (w64-column (w-f0 w-g8) (w-f1-2 w-g7) (w-f2 w-g6) (w-f3-2 w-g5) (w-f4 w-g4) (w-f5-2 w-g3) (w-f6 w-g2) (w-f7-2 w-g1) (w-f8 w-g0) (w-f9-2 w-g9-19))
           (w64-add w-lo w-hi w-cl w-ch)
           (w64-carry w-r8 26)
           (w64-column (w-f0 w-g9) (w-f1 w-g8) (w-f2 w-g7) (w-f3 w-g6) (w-f4 w-g5) (w-f5 w-g4) (w-f6 w-g3) (w-f7 w-g2) (w-f8 w-g1) (w-f9 w-g0))
           (w64-add w-lo w-hi w-cl w-ch)
