(defun to-darwin-stat (l d)
  (impl-c-memset d 0 144)
  (st32 d (ld64 l 0) 0) (st16 d (ld32 l 16) 4) (st16 d (ld32 l 20) 6) (st64 d (ld64 l 8) 8)
  (st32 d (ld32 l 24) 16) (st32 d (ld32 l 28) 20) (st32 d (ld64 l 32) 24)
  (st64 d (ld64 l 72) 32) (st64 d (ld64 l 80) 40) (st64 d (ld64 l 88) 48) (st64 d (ld64 l 96) 56)
  (st64 d (ld64 l 104) 64) (st64 d (ld64 l 112) 72)
  (st64 d (ld64 l 48) 96) (st64 d (ld64 l 64) 104) (st32 d (ld32 l 56) 112)
  0)
(defun impl-c-fstatat (fd p d f)
  (with-buffers ((l 128))
    (let ((r (lin (sys 79 (lx-dirfd fd) p l (lx-at-flags f)))))
      (when (>= r 0) (to-darwin-stat l d))
      r)))
(defun impl-c-fstat (fd d)
