(defun say (k v) (princ (concatenate (quote string) k "=" (princ-to-string v))) (terpri) (finish-output))
(defun hx (n) (format nil "~X" n))
(defun badread (n) (mem-ref n :u64))
(setf (mem-ref #x10000C30 :u32) 123456)
(setf (mem-ref #x10000C40 :u32) 222222)
(setf (mem-ref #x10000C50 :u32) 333333)
(say "PRE" (list (mem-ref #x10000C30 :u32) (mem-ref #x10000C40 :u32) (mem-ref #x10000C50 :u32)))
(say "SEGV" (handler-case (badread (* 2 #x60000000000)) (t (c) :ERR)))
(say "POST" (list (hx (mem-ref #x10000C30 :u32)) (hx (mem-ref #x10000C34 :u32))
                  (hx (mem-ref #x10000C40 :u32)) (hx (mem-ref #x10000C44 :u32))
                  (hx (mem-ref #x10000C48 :u32)) (hx (mem-ref #x10000C4C :u32))
                  (hx (mem-ref #x10000C50 :u32)) (hx (mem-ref #x10000C54 :u32))))
(say "END" "ok")
