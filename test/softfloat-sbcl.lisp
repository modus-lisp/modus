;;;; softfloat-sbcl.lisp -- mvm/softfloat.lisp against SBCL's own IEEE doubles.
;;;;
;;;; sbcl --script test/softfloat-sbcl.lisp [N]     (default 20000 random cases)
;;;;
;;;; Every op (add sub mul div sqrt round32 f32 store/load itof ftoi) is compared
;;;; bit-for-bit, and + - * FLOOR ASH LOGAND LOGIOR are shadowed by versions that
;;;; ERROR on any value outside the 30-bit fixnum range, so the fixnum-only
;;;; promise the 68k code relies on is checked, not assumed.  Exit 0 = no failure.

(defpackage :sft (:use :cl) (:shadow #:+ #:- #:* #:floor #:ash #:logand #:logior))
(in-package :sft)
(defconstant +lim+ (expt 2 29))
(defun chk (x) (unless (and (integerp x) (< (abs x) +lim+)) (error "fixnum overflow: ~a" x)) x)
(defun + (&rest a) (chk (apply #'cl:+ a)))
(defun - (&rest a) (chk (apply #'cl:- a)))
(defun * (&rest a) (chk (apply #'cl:* a)))
(defun floor (a &optional (b 1)) (chk (values (cl:floor a b))))
(defun ash (a n) (chk (cl:ash a n)))
(defun logand (&rest a) (chk (apply #'cl:logand a)))
(defun logior (&rest a) (chk (apply #'cl:logior a)))
;; stubs: a float box = (vector c0 c1 c2 c3 kind)
(defun %make-float2 () (vector 0 0 0 0 :double))
(defun %make-single2 () (vector 0 0 0 0 :single))
(defun %prim-aref (f k) (svref f k))
(defun %prim-aset (f k v) (setf (svref f k) v))
(defun %u8-ref (a i) (aref a i))
(defun %u8-set (a i v) (setf (aref a i) v))
(defun %prim-array-length (a) (floor (length a) 4))
(load (merge-pathnames "../mvm/softfloat.lisp" (directory-namestring *load-truename*)))

(defun box (d) (let* ((hi (cl:logand (sb-kernel:double-float-high-bits d) #xFFFFFFFF))
                      (lo (sb-kernel:double-float-low-bits d)))
                 (vector (cl:ash hi -16) (cl:logand hi 65535) (cl:ash lo -16) (cl:logand lo 65535) :double)))
(defun unbox (f) (let ((hi (cl:logior (cl:ash (svref f 0) 16) (svref f 1)))
                       (lo (cl:logior (cl:ash (svref f 2) 16) (svref f 3))))
                   (sb-kernel:make-double-float (if (>= hi #x80000000) (cl:- hi #x100000000) hi) lo)))
(defun bits (d) (cl:logior (cl:ash (cl:logand (sb-kernel:double-float-high-bits d) #xFFFFFFFF) 32) (sb-kernel:double-float-low-bits d)))
(defun nanp (d) (/= d d))
(defun same (x y) (or (and (nanp x) (nanp y)) (= (bits x) (bits y))))
(defun rnd-double (r)
  (case (random 6 r)
    (0 (sb-kernel:make-double-float (cl:- (random (expt 2 32) r) (expt 2 31)) (random (expt 2 32) r)))
    (1 (cl:* (cl:- (random 2.0d0 r) 1d0) (expt 10d0 (cl:- (random 40 r) 20))))
    (2 (float (cl:- (random 2000 r) 1000) 1d0))
    (3 (sb-kernel:make-double-float (cl:- (random 3 r) 1) (random (expt 2 32) r))) ; tiny/denormal
    (4 (nth (random 10 r) (list 0d0 -0d0 1d0 -1d0 sb-ext:double-float-positive-infinity
                                sb-ext:double-float-negative-infinity most-positive-double-float
                                least-positive-double-float 0.5d0 3d0)))
    (t (cl:* (random 1d0 r) (expt 2d0 (cl:- (random 2100 r) 1075))))))
(defvar *fails* 0)
(defun report (op a b want got)
  (cl:incf *fails*)
  (when (< *fails* 25) (format t "~&FAIL ~a ~a ~a want ~a got ~a~%" op a b want got)))
(defun run (n)
  (let ((r (sb-ext:seed-random-state 12345)))
    (sb-int:with-float-traps-masked (:overflow :invalid :divide-by-zero :inexact :underflow)
      (dotimes (i n)
        (let ((a (rnd-double r)) (b (rnd-double r)))
          (loop for (op f g) in (list (list "add" #'%sf-add #'cl:+) (list "sub" #'%sf-sub #'cl:-)
                                      (list "mul" #'%sf-mul #'cl:*) (list "div" #'%sf-div #'cl:/))
                do (let ((want (funcall g a b)) (got (unbox (funcall f (box a) (box b)))))
                     (unless (same want got) (report op a b want got))))
          (let ((want (if (and (< a 0) (not (zerop a))) (cl:- sb-ext:double-float-positive-infinity sb-ext:double-float-positive-infinity) (sqrt a)))
                (got (unbox (%sf-sqrt (box a)))))
            (unless (same want got) (report "sqrt" a nil want got)))
          (let* ((want (if (nanp a) a (coerce (coerce a 'single-float) 'double-float)))
                 (got (unbox (%sf-round32 (box a)))))
            (unless (same want got) (report "round32" a nil want got)))
          ;; f32 lane round trip
          (let* ((arr (make-array 8 :initial-element 0)))
            (%sf-f32-store arr 1 (box a))
            (let* ((sb (cl:logior (aref arr 4) (cl:ash (aref arr 5) 8) (cl:ash (aref arr 6) 16) (cl:ash (aref arr 7) 24)))
                   (want-bits (if (nanp a) nil (sb-kernel:single-float-bits (coerce a 'single-float)))))
              (when (and want-bits (/= sb (cl:logand want-bits #xFFFFFFFF))) (report "f32-store" a nil want-bits sb))
              (let ((back (unbox (%sf-f32-load arr 1)))
                    (wantb (if (nanp a) a (coerce (coerce a 'single-float) 'double-float))))
                (unless (same back wantb) (report "f32-load" a nil wantb back)))))
          (let* ((k (cl:- (random (expt 2 30) r) (expt 2 29)))
                 (want (float k 1d0)) (got (unbox (%sf-itof k))))
            (unless (same want got) (report "itof" k nil want got)))
          (when (and (not (nanp a)) (< (abs a) 5d8))
            (let ((want (truncate a)) (got (%sf-ftoi (box a))))
              (unless (= want got) (report "ftoi" a nil want got)))))))
    (format t "~&~D cases x 10 ops: ~D failures~%" n *fails*)))
(run (parse-integer (or (second sb-ext:*posix-argv*) "20000")))
(sb-ext:exit :code (if (= *fails* 0) 0 1))
