(setq *jit-hot-only* nil)
(defun pw (pic) (declare (ignore pic)) 320) (defun ph (pic) (declare (ignore pic)) 180)
(defun pys (pic) (declare (ignore pic)) 384) (defun pcs (pic) (declare (ignore pic)) 192)
(defun copyp (pic buf) (declare (ignore pic)) (list (+ buf 12320) (+ buf 101392) (+ buf 125968)))
(defun yuv-words (pic buf dx dy dw dh)
  (let* ((sw (pw pic)) (sh (ph pic)) (ys (pys pic)) (cs (pcs pic)) (ptrs (copyp pic buf)) (ks 2100)
         (ppf (lambda (s d) (logior (ash 1 30) (ash (floor (* 65536 s) d) 8))))
         (words (list (logior (ash 1 30) (ash 28 24) 8) (logior #xFF000000 (ash dy 12) dx) (logior (ash dh 16) dw)
                      (logior (ash 1 30) (ash sh 16) sw) #xC0C0C0C0 (logior #xC0000000 (first ptrs)) (logior #xC0000000 (second ptrs)) (logior #xC0000000 (third ptrs))
                      #xC0C0C0C0 #xC0C0C0C0 #xC0C0C0C0 ys cs cs #x00f00000 #xe73304a8 #x00066604 0
                      (funcall ppf (ash sw -1) dw) (funcall ppf (ash sh -1) dh) #xC0C0C0C0 (funcall ppf sw dw) (funcall ppf sh dh) #xC0C0C0C0 ks ks ks ks #x80000000))
         (i 0))
    (dolist (w words) (setq i (+ i 1)))
    (list i words)))
(modus:jit-eager)
