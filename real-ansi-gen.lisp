                                             (SETQ N
                                                     (MULTIPLE-VALUE-LIST
                                                      (FUNCALL FN STREAM C)))
                                             (GET-OUTPUT-STREAM-STRING STREAM))
                                   UNLESS (OR (GRAPHIC-CHAR-P C)
                                              (AND (STRING= S (CHAR-NAME C))
                                                   (EQUAL N '(NIL))))
                                   COLLECT (LIST C (CHAR-NAME C) S)))) 'NIL) (t (c) (%test-crash-fail-c 23860 c)))
  (handler-case (run-test 23861 (lambda () (LET ((FN (FORMATTER "~:C")) (N NIL))
                             (LOOP FOR I FROM 0 BELOW (MIN 65536
                                                           CHAR-CODE-LIMIT)
