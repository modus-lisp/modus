           (GET-OUTPUT-STREAM-STRING S))))
    (OR (EQUALT STR EXPECTED) (LIST STR EXPECTED))))
(DEFUN PRIN1.SYMBOL.FN (SYM CASE *PRINT-CASE* EXPECTED)
