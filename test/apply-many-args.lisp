;;; Regression: calls with many arguments.  APPLY's fallthrough was an unrolled
;;; FUNCALL ladder (32, then 48 arms) that silently DROPPED every argument past
;;; it, and the #x0530 overflow-copy trap capped &rest/&key callees at 64.
;;; reel's 90-argument MAKE-DEC read its trailing slots as a stray BIT.
;;; Now: %APPLY-SPREAD (a runtime loop) to CALL-ARGUMENTS-LIMIT = 120, and a
;;; PROGRAM-ERROR past it.
(defvar *fails* 0)
(defmacro chk (name form)
  `(let ((v (handler-case ,form (error (c) (list :error (type-of c))))))
     (unless (eq v t) (setq *fails* (+ *fails* 1)) (format t "FAIL ~A => ~S~%" ,name v))))
