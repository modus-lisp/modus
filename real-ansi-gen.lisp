;; === pairlis.lsp ===
(DEFUN MY-PAIRLIS (X Y &OPTIONAL ALIST)
  (IF (NULL X)
      ALIST
      (ACONS (CAR X) (CAR Y) (MY-PAIRLIS (CDR X) (CDR Y) ALIST))))
(defun run-init-pairlis ()
  nil
)
(defun run-ansi-pairlis-chunk-1 ()
  (handler-case (run-test 11119 (lambda () (PAIRLIS NIL NIL NIL)) 'NIL) (t (c) (%test-crash-fail-c 11119 c)))
  (handler-case (run-test 11120 (lambda () (PAIRLIS '(A) '(B) NIL)) '((A . B))) (t (c) (%test-crash-fail-c 11120 c)))
  (handler-case (run-test 11121 (lambda () (LET* ((X (COPY-LIST '(A B C D E)))
                                  (XCOPY (MAKE-SCAFFOLD-COPY X))
                                  (Y (COPY-LIST '(1 2 3 4 5)))
                                  (YCOPY (MAKE-SCAFFOLD-COPY Y))
                                  (RESULT (PAIRLIS X Y))
                                  (EXPECTED (MY-PAIRLIS X Y)))
                             (AND (CHECK-SCAFFOLD-COPY X XCOPY)
                                  (CHECK-SCAFFOLD-COPY Y YCOPY)
                                  (OR (EQUAL RESULT EXPECTED)
                                      (EQUAL RESULT (REVERSE EXPECTED)))
                                  T))) 'T) (t (c) (%test-crash-fail-c 11121 c)))
  (handler-case (run-test 11122 (lambda () (LET* ((X (COPY-LIST '(A B C D E)))
                                  (XCOPY (MAKE-SCAFFOLD-COPY X))
                                  (Y (COPY-LIST '(1 2 3 4 5)))
                                  (YCOPY (MAKE-SCAFFOLD-COPY Y))
                                  (Z '((X . 10) (Y . 20)))
                                  (ZCOPY (MAKE-SCAFFOLD-COPY Z))
                                  (RESULT (PAIRLIS X Y Z))
                                  (EXPECTED (MY-PAIRLIS X Y Z)))
                             (AND (CHECK-SCAFFOLD-COPY X XCOPY)
                                  (CHECK-SCAFFOLD-COPY Y YCOPY)
                                  (CHECK-SCAFFOLD-COPY Z ZCOPY)
                                  (EQT (CDR (CDDR (CDDR RESULT))) Z)
                                  (OR (EQUAL RESULT EXPECTED)
                                      (EQUAL RESULT
                                             (APPEND
                                              (REVERSE (SUBSEQ EXPECTED 0 5))
                                              (SUBSEQ EXPECTED 5))))
                                  T))) 'T) (t (c) (%test-crash-fail-c 11122 c)))
  (handler-case (run-test 11123 (lambda () (HANDLER-CASE (PROGN (PAIRLIS) NIL) (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 11123 c)))
  (handler-case (run-test 11124 (lambda () (HANDLER-CASE (PROGN (PAIRLIS NIL) NIL)
                                         (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 11124 c)))
  (handler-case (run-test 11125 (lambda () (HANDLER-CASE (PROGN (PAIRLIS NIL NIL NIL NIL) NIL)
                                         (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 11125 c)))
  (handler-case (run-test 11126 (lambda () (HANDLER-CASE (PROGN (PAIRLIS 'A '(1)) NIL)
                                         (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 11126 c)))
)
