;;; round-trips chosen to cover every head size and the NSM request/response shapes
(load "lib/cbor.lisp")
(defun chk (name hex x)
  (let* ((enc (cbor-encode x)) (dec (cbor-decode (cbor-from-hex hex))))
    (format t "~A enc=~A ~A dec=~A~%" name (if (string= (cbor-hex enc) hex) "OK" (cbor-hex enc)) (if (equalp dec x) "OK" dec) "-")))
(chk "small int" "0a" 10)
(chk "u8" "1864" 100)
(chk "u16" "1903e8" 1000)
(chk "u32" "1a000f4240" 1000000)
(chk "u64" "1b000000e8d4a51000" 1000000000000)
(chk "neg" "3863" -100)
(chk "bytes" "4401020304" (cbor-from-hex "01020304"))
(chk "text" "6449455446" "IETF")
(chk "array" "83010203" (list 1 2 3))
(chk "map" "a26161016162820203" (list :map (cons "a" 1) (cons "b" (list 2 3))))
(chk "tag" "d818456449455446" (cons :tag (cons 24 (cbor-from-hex "6449455446"))))
(chk "simple" "f5" :true)
;; the NSM attestation request: {"Attestation": {"user_data": h'..', "nonce": h'..', "public_key": null}}
(format t "req=~A~%" (cbor-hex (cbor-encode (list :map (cons "Attestation" (list :map (cons "user_data" (cbor-from-hex "aabb")) (cons "nonce" (cbor-from-hex "0102")) (cons "public_key" :null)))))))
(format t "CBOR-PROBE-END~%")
