(DEFMACRO DEF-UNEXPORT-TEST (TEST-NAME NAME-FORM)
  `(DEFTEST ,TEST-NAME
    (LET ((NAME ,NAME-FORM))
      (SAFELY-DELETE-PACKAGE NAME)
      (LET* ((P (MAKE-PACKAGE NAME :USE NIL)) (R (EXPORT (INTERN "X" P) P)))
        (LET ((%MVB*-TMP (MULTIPLE-VALUE-LIST (FIND-SYMBOL "X" P))))
          (CHECK-VALUES-LENGTH %MVB*-TMP 2 '(FIND-SYMBOL "X" P))
          (LET ((SYM1
                 (IF (< 0 (LENGTH %MVB*-TMP))
                     (NTH 0 %MVB*-TMP)
                     NIL))
                (ACCESS1
                 (IF (< 1 (LENGTH %MVB*-TMP))
                     (NTH 1 %MVB*-TMP)
                     NIL)))
            (UNEXPORT (LIST SYM1) NAME)
            (LET ((%MVB*-TMP (MULTIPLE-VALUE-LIST (FIND-SYMBOL "X" P))))
              (CHECK-VALUES-LENGTH %MVB*-TMP 2 '(FIND-SYMBOL "X" P))
              (LET ((SYM2
                     (IF (< 0 (LENGTH %MVB*-TMP))
                         (NTH 0 %MVB*-TMP)
                         NIL))
                    (ACCESS2
                     (IF (< 1 (LENGTH %MVB*-TMP))
                         (NTH 1 %MVB*-TMP)
                         NIL)))
                (AND (EQT SYM1 SYM2) (EQT R T) (EQT ACCESS1 :EXTERNAL)
                     (EQT ACCESS2 :INTERNAL) (EQUAL (SYMBOL-NAME SYM1) "X")
                     T)))))))
    T))
