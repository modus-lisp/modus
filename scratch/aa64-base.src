                                     (LET ((KEYFORM (CADR FORM))
                                           (CLAUSES (CDDR FORM))
                                           (TMP (%MVM-GENSYM "CASE")))
                                       `(LET ((,TMP ,KEYFORM))
                                          (COND
                                           ,@(MAPCAR
                                              (LAMBDA (CLAUSE)
                                                (LET* ((KEYS (CAR CLAUSE))
                                                       (BODY (CDR CLAUSE))
                                                       (EFFECTIVE-BODY
                                                        (OR BODY '(NIL))))
                                                  (COND
                                                   ((OR (EQ KEYS T)
                                                        (AND (SYMBOLP KEYS)
                                                             (=
                                                              (COMPUTE-NAME-HASH
                                                               (SYMBOL-NAME
                                                                KEYS))
                                                              101669203)))
                                                    `(T ,@EFFECTIVE-BODY))
                                                   ((LISTP KEYS)
                                                    `((OR
                                                       ,@(MAPCAR
                                                          (LAMBDA (K)
                                                            `(EQL ,TMP ',K))
                                                          KEYS))
                                                      ,@EFFECTIVE-BODY))
                                                   (T
