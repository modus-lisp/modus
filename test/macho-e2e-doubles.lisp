")

;;; start: page 0 is the TSD; then the host's MAIN, as dyld would call it
(defun e2e-main (sp)
  (when (/= (sys 222 0 #x4000 3 #x32 -1 0) 0) (sys 94 97))
  (let* ((argc (ld64 sp)) (argv (+ sp 8)) (envp (+ argv (* 8 (+ argc 1)))))
    (st64 (addr e-envp) envp)
    (main argc argv envp 0)))
(defasm e2e-start (:mov x0 sp) (:bl e2e-main) (:brk 1))
