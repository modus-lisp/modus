;; === in-package.lsp ===
(DEFMACRO DEF-IN-PACKAGE-TEST (TEST-NAME NAME-FORM)
  `(DEFTEST ,TEST-NAME
    (LET ((NAME ,NAME-FORM))
      (SAFELY-DELETE-PACKAGE NAME)
      (PROG1
          (LET* ((P (MAKE-PACKAGE NAME :USE NIL))
                 (*PACKAGE* *PACKAGE*)
                 (P2 (EVAL `(IN-PACKAGE ,NAME))))
            (DECLARE (SPECIAL *PACKAGE*))
            (LIST (EQT P P2) (EQT P *PACKAGE*)))
        (SAFELY-DELETE-PACKAGE NAME)))
    (T T)))
