(DEFMACRO DEF-WITH-PACKAGE-ITERATOR-TEST (TEST-NAME NAME-FORM)
  `(DEFTEST ,TEST-NAME
    (LET ((NAME ,NAME-FORM))
      (SAFELY-DELETE-PACKAGE NAME)
      (LET* ((P (MAKE-PACKAGE NAME :USE NIL)) (RESULT NIL) (S (INTERN "X" P)))
        (LET* ((#:WPI-PKGS301
                (LET ((__P NAME))
                  (COND ((LISTP __P) (MAPCAR #'FIND-PACKAGE __P))
                        ((OR (STRINGP __P) (SYMBOLP __P))
                         (LIST (FIND-PACKAGE __P)))
                        (T (LIST __P)))))
               (#:WPI-ENTRIES302 NIL))
          (DOLIST (#:WPI-PK303 #:WPI-PKGS301)
            (DOLIST (#:WPI-E304 (%PKG-INTERNAL #:WPI-PK303))
              (SETQ #:WPI-ENTRIES302
                      (CONS (LIST (CDR #:WPI-E304) :INTERNAL #:WPI-PK303)
                            #:WPI-ENTRIES302))))
          (FLET ((X ()
                   (COND ((NULL #:WPI-ENTRIES302) (VALUES NIL NIL NIL NIL))
                         (T
                          (LET ((#:WPI-TOP306 (CAR #:WPI-ENTRIES302)))
                            (SETQ #:WPI-ENTRIES302 (CDR #:WPI-ENTRIES302))
                            (VALUES T (CAR #:WPI-TOP306) (CADR #:WPI-TOP306)
                                    (CADDR #:WPI-TOP306)))))))
            (LOOP
             (MULTIPLE-VALUE-BIND (GOOD? SYM)
                 (X)
               (UNLESS GOOD?
                 (SAFELY-DELETE-PACKAGE NAME)
                 (RETURN (EQUALT (LIST S) RESULT)))
               (PUSH SYM RESULT)))))))
    T))
