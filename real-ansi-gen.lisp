                                              (GET-OUTPUT-STREAM-STRING
                                               STREAM))
                                   FOR S2 = (FORMAT NIL "~:@C" C)
                                   UNLESS (AND (EQL (SEARCH S1 S2) 0)
                                               (EQUAL N '((1 2))))
                                   COLLECT (LIST C S1 S2 N)))) 'NIL) (t (c) (%test-crash-fail-c 23863 c)))
