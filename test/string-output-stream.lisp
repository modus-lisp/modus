;;; String-output streams over a growing code buffer (cl-streams.lisp %SOS-ADD and friends): it was a list, one
;;; cons per character.  Everything that reads the buffer -- GET-OUTPUT-STREAM-STRING, FILE-POSITION, FRESH-LINE
;;; and ~&, ~T's column, an echo stream's PEEK-CHAR -- checked against SBCL.  Run: ./modus --script THIS
(defpackage :sos-test (:use :cl))
(in-package :sos-test)
(defvar *fails* 0)
(defvar *checks* 0)
(defmacro check (name form expect)
  `(let ((got (handler-case ,form (error () :error))))
     (incf *checks*)
     (unless (equalp got ,expect)
       (incf *fails*)
       (format t "FAIL ~a: got ~s want ~s~%" ,name got ,expect))))

(check "empty" (with-output-to-string (s)) "")
(check "chars and strings" (with-output-to-string (s) (write-char #\a s) (write-string "bcd" s) (princ 42 s) (write-sequence "xy" s)) "abcd42xy")
(check "growth past the first buffer" (let ((r (with-output-to-string (s) (dotimes (i 1000) (write-string "0123456789" s)))))
                                        (list (length r) (subseq r 0 12) (subseq r 9990)))
       (list 10000 "012345678901" "0123456789"))
(check "write-string :start :end" (with-output-to-string (s) (write-string "abcdefg" s :start 2 :end 5)) "cde")
(check "non-ascii" (with-output-to-string (s) (write-char (code-char 955) s) (write-string (coerce (list (code-char 8364) #\z) 'string) s))
       (coerce (list (code-char 955) (code-char 8364) #\z) 'string))
(check "get-output-stream-string resets" (let ((s (make-string-output-stream)))
                                           (write-string "one" s)
                                           (let ((a (get-output-stream-string s)))
                                             (write-string "two" s)
                                             (list a (get-output-stream-string s) (get-output-stream-string s))))
       (list "one" "two" ""))
(check "file-position" (let ((s (make-string-output-stream))) (write-string "hello" s) (prog1 (file-position s) (get-output-stream-string s))) 5)
(check "fresh-line" (with-output-to-string (s) (fresh-line s) (write-string "a" s) (fresh-line s) (fresh-line s) (write-string "b" s) (terpri s) (fresh-line s))
       (format nil "a~%b~%"))
(check "format ~&" (format nil "~&x~&~&y~%~&z") (format nil "x~%y~%z"))
(check "format ~T columns" (format nil "ab~10Tc~%~5Td") (format nil "ab        c~%     d"))
(check "format ~T after text" (format nil "abcdef~3Tg") "abcdef g")
(check "echo peek-char" (let* ((in (make-string-input-stream "xyz")) (out (make-string-output-stream)) (e (make-echo-stream in out)))
                          (list (peek-char nil e) (read-char e) (read-char e) (get-output-stream-string out)))
       (list #\x #\x #\y "xy"))
(check "fill-pointer target" (let ((str (make-array 2 :element-type 'character :fill-pointer 0 :adjustable t)))
                               (with-output-to-string (s str) (write-string "abc" s) (princ 7 s))
                               str)
       "abc7")
(check "element-type nil" (length (get-output-stream-string (make-string-output-stream :element-type nil))) 0)
(check "princ-to-string" (list (princ-to-string '(a "b" #\c 1.5)) (prin1-to-string "q")) (list "(A b c 1.5)" "\"q\""))

;; the first buffer holds 64 codes: a newline, FRESH-LINE and a column that straddle its end
(check "newline ends the first buffer" (with-output-to-string (s) (write-string (make-string 63 :initial-element #\a) s) (terpri s) (fresh-line s) (write-string "b" s))
       (concatenate 'string (make-string 63 :initial-element #\a) (string #\newline) "b"))
(check "column across buffers" (let ((r (with-output-to-string (s) (write-string (make-string 60 :initial-element #\a) s) (terpri s)
                                                   (write-string "0123456789" s) (format s "~15Tx~3Ty"))))
                                 (subseq r 61))
       "0123456789     x y")
(check "long line column" (length (format nil "~a~100Tz" (make-string 70 :initial-element #\c))) 101)
(check "char by char past several buffers" (let ((r (with-output-to-string (s) (dotimes (i 300) (write-char (code-char (+ 65 (mod i 26))) s)))))
                                             (list (length r) (char r 0) (char r 64) (char r 299)))
       (list 300 #\A #\M #\N))

(format t "string-output-stream: ~d checks, ~d failed~%" *checks* *fails*)
(if (zerop *fails*) (format t "PASS~%") (format t "FAIL~%"))
