;;;; crypto-fast.lisp — Fast field element ops (every target, 30- and 62-bit fixnums)
;;;;
;;;; Load AFTER crypto.lisp (last-defun-wins), in its package.
;;;;
;;;; Replaces the fe-* functions with straight-line versions over a
;;;; 40-slot vector whose slots 0..9 hold the ten limbs (alternating
;;;; 26/25 bits) as ordinary FIXNUMS, read and written with SVREF.
;;;;
;;;; THE LIMBS ARE TAGGED, NOT RAW, AND NO OBJECT ADDRESS IS EVER TAKEN.  This
;;;; file used to store raw u32 limbs through MEM-REF at an address computed
;;;; from the vector, which is only correct if nothing can move the vector
;;;; between taking the address and the last access.  On a 30-bit tower
;;;; (i386, arm32, riscv32, 68k) the 26x26-bit products are BIGNUMS, so a
;;;; collection inside FE-MUL moved the arrays under the cached address:
;;;; measured on bare i386, every X25519 that saw a collection was wrong.
;;;; Taking each address after the last allocation cut that to ~1 in 40 but
;;;; not to zero (docs/w32.md, M4); with tagged slots the collector sees and
;;;; forwards everything, on every target, by construction.  (The 32-bit
;;;; splice that used to replace this file, crypto-32-fast.lisp, is deleted.)
;;;;
;;;; NOTE: We do NOT override buf-read-u32 globally because ip.lisp needs
;;;; the big-endian version for network packet parsing.

(in-package :modus.crypto)

;; ================================================================
;; fe-from-bytes: Convert 32 LE bytes to field element (10 limbs)
;; ================================================================
(declaim (overridable fe-from-bytes))
(defun fe-from-bytes (bytes)
  (let ((fe (make-array 40)))
    (declare (simple-vector fe) (optimize (safety 0)))
    (let ((l0 (logand (buf-read-u32-le bytes 0) #x3FFFFFF))
          (l1 (logand (ash (buf-read-u32-le bytes 3) -2) #x1FFFFFF))
          (l2 (logand (ash (buf-read-u32-le bytes 6) -3) #x3FFFFFF))
          (l3 (logand (ash (buf-read-u32-le bytes 9) -5) #x1FFFFFF))
          (l4 (logand (ash (buf-read-u32-le bytes 12) -6) #x3FFFFFF))
          (l5 (logand (buf-read-u32-le bytes 16) #x1FFFFFF))
          (l6 (logand (ash (buf-read-u32-le bytes 19) -1) #x3FFFFFF))
          (l7 (logand (ash (buf-read-u32-le bytes 22) -3) #x1FFFFFF))
          (l8 (logand (ash (buf-read-u32-le bytes 25) -4) #x3FFFFFF))
          (l9 (logand (ash (buf-read-u32-le bytes 28) -6) #x1FFFFFF)))
      (setf (svref fe 0) l0)
      (setf (svref fe 1) l1)
      (setf (svref fe 2) l2)
      (setf (svref fe 3) l3)
      (setf (svref fe 4) l4)
      (setf (svref fe 5) l5)
      (setf (svref fe 6) l6)
      (setf (svref fe 7) l7)
      (setf (svref fe 8) l8)
      (setf (svref fe 9) l9))
    fe))

;; ================================================================
;; fe-from-int: Convert integer to field element
;; ================================================================
(declaim (overridable fe-from-int))
(defun fe-from-int (n)
  (let ((fe (make-array 40)))
    (declare (simple-vector fe) (optimize (safety 0)))
    (dotimes (i 40) (aset fe i 0))
    (setf (svref fe 0) (logand n #x3FFFFFF))
    (setf (svref fe 1) (logand (ash n -26) #x1FFFFFF))
    fe))

;; ================================================================
;; fe-copy: Copy field element limbs
;; ================================================================
(declaim (overridable fe-copy))
(defun fe-copy (dst src)
  (declare (simple-vector dst src) (optimize (safety 0)))
  (setf (svref dst 0) (svref src 0))
  (setf (svref dst 1) (svref src 1))
  (setf (svref dst 2) (svref src 2))
  (setf (svref dst 3) (svref src 3))
  (setf (svref dst 4) (svref src 4))
  (setf (svref dst 5) (svref src 5))
  (setf (svref dst 6) (svref src 6))
  (setf (svref dst 7) (svref src 7))
  (setf (svref dst 8) (svref src 8))
  (setf (svref dst 9) (svref src 9))
  dst)

;; ================================================================
;; fe-add: Add two field elements
;; ================================================================
(declaim (overridable fe-add))
(defun fe-add (dst a b)
  (declare (simple-vector dst a b) (optimize (safety 0)))
  (setf (svref dst 0) (+ (svref a 0) (svref b 0)))
  (setf (svref dst 1) (+ (svref a 1) (svref b 1)))
  (setf (svref dst 2) (+ (svref a 2) (svref b 2)))
  (setf (svref dst 3) (+ (svref a 3) (svref b 3)))
  (setf (svref dst 4) (+ (svref a 4) (svref b 4)))
  (setf (svref dst 5) (+ (svref a 5) (svref b 5)))
  (setf (svref dst 6) (+ (svref a 6) (svref b 6)))
  (setf (svref dst 7) (+ (svref a 7) (svref b 7)))
  (setf (svref dst 8) (+ (svref a 8) (svref b 8)))
  (setf (svref dst 9) (+ (svref a 9) (svref b 9)))
  dst)

;; ================================================================
;; fe-sub: Subtract field elements, add 2p to keep non-negative
;; ================================================================
(declaim (overridable fe-sub))
(defun fe-sub (dst a b)
  (declare (simple-vector dst a b) (optimize (safety 0)))
  (setf (svref dst 0) (+ (- (svref a 0) (svref b 0)) 134217690))
  (setf (svref dst 1) (+ (- (svref a 1) (svref b 1)) 67108862))
  (setf (svref dst 2) (+ (- (svref a 2) (svref b 2)) 134217726))
  (setf (svref dst 3) (+ (- (svref a 3) (svref b 3)) 67108862))
  (setf (svref dst 4) (+ (- (svref a 4) (svref b 4)) 134217726))
  (setf (svref dst 5) (+ (- (svref a 5) (svref b 5)) 67108862))
  (setf (svref dst 6) (+ (- (svref a 6) (svref b 6)) 134217726))
  (setf (svref dst 7) (+ (- (svref a 7) (svref b 7)) 67108862))
  (setf (svref dst 8) (+ (- (svref a 8) (svref b 8)) 134217726))
  (setf (svref dst 9) (+ (- (svref a 9) (svref b 9)) 67108862))
  (fe-carry dst))

;; ================================================================
;; fe-carry: Carry propagation (even limbs 26 bits, odd 25 bits)
;; ================================================================
(declaim (overridable fe-carry))
(defun fe-carry (h)
  (declare (simple-vector h) (optimize (safety 0)))
  (let* ((v0 (svref h 0))
           (c0 (ash v0 -26))
           (r0 (logand v0 #x3FFFFFF))
           (v1 (+ (svref h 1) c0))
           (c1 (ash v1 -25))
           (r1 (logand v1 #x1FFFFFF))
           (v2 (+ (svref h 2) c1))
           (c2 (ash v2 -26))
           (r2 (logand v2 #x3FFFFFF))
           (v3 (+ (svref h 3) c2))
           (c3 (ash v3 -25))
           (r3 (logand v3 #x1FFFFFF))
           (v4 (+ (svref h 4) c3))
           (c4 (ash v4 -26))
           (r4 (logand v4 #x3FFFFFF))
           (v5 (+ (svref h 5) c4))
           (c5 (ash v5 -25))
           (r5 (logand v5 #x1FFFFFF))
           (v6 (+ (svref h 6) c5))
           (c6 (ash v6 -26))
           (r6 (logand v6 #x3FFFFFF))
           (v7 (+ (svref h 7) c6))
           (c7 (ash v7 -25))
           (r7 (logand v7 #x1FFFFFF))
           (v8 (+ (svref h 8) c7))
           (c8 (ash v8 -26))
           (r8 (logand v8 #x3FFFFFF))
           (v9 (+ (svref h 9) c8))
           (c9 (ash v9 -25))
           (r9 (logand v9 #x1FFFFFF))
           (r0w (+ r0 (* c9 19)))
           (c0b (ash r0w -26))
           (r0f (logand r0w #x3FFFFFF))
           (r1f (+ r1 c0b)))
      (setf (svref h 0) r0f)
      (setf (svref h 1) r1f)
      (setf (svref h 2) r2)
      (setf (svref h 3) r3)
      (setf (svref h 4) r4)
      (setf (svref h 5) r5)
      (setf (svref h 6) r6)
      (setf (svref h 7) r7)
      (setf (svref h 8) r8)
      (setf (svref h 9) r9))
  h)

;; ================================================================
;; fe-reduce: Full reduction mod p = 2^255 - 19
;; ================================================================
(declaim (overridable fe-reduce))
(defun fe-reduce (h)
  (declare (simple-vector h) (optimize (safety 0)))
  (fe-carry h)
  (fe-carry h)
  (let* ((t0 (+ (svref h 0) 19))
           (c0 (ash t0 -26))
           (t0m (logand t0 #x3FFFFFF))
           (t1 (+ (svref h 1) c0))
           (c1 (ash t1 -25))
           (t1m (logand t1 #x1FFFFFF))
           (t2 (+ (svref h 2) c1))
           (c2 (ash t2 -26))
           (t2m (logand t2 #x3FFFFFF))
           (t3 (+ (svref h 3) c2))
           (c3 (ash t3 -25))
           (t3m (logand t3 #x1FFFFFF))
           (t4 (+ (svref h 4) c3))
           (c4 (ash t4 -26))
           (t4m (logand t4 #x3FFFFFF))
           (t5 (+ (svref h 5) c4))
           (c5 (ash t5 -25))
           (t5m (logand t5 #x1FFFFFF))
           (t6 (+ (svref h 6) c5))
           (c6 (ash t6 -26))
           (t6m (logand t6 #x3FFFFFF))
           (t7 (+ (svref h 7) c6))
           (c7 (ash t7 -25))
           (t7m (logand t7 #x1FFFFFF))
           (t8 (+ (svref h 8) c7))
           (c8 (ash t8 -26))
           (t8m (logand t8 #x3FFFFFF))
           (t9 (+ (svref h 9) c8))
           (c9 (ash t9 -25))
           (t9m (logand t9 #x1FFFFFF)))
      (when (not (zerop c9))
        (setf (svref h 0) t0m)
        (setf (svref h 1) t1m)
        (setf (svref h 2) t2m)
        (setf (svref h 3) t3m)
        (setf (svref h 4) t4m)
        (setf (svref h 5) t5m)
        (setf (svref h 6) t6m)
        (setf (svref h 7) t7m)
        (setf (svref h 8) t8m)
        (setf (svref h 9) t9m)))
  h)

;; ================================================================
;; fe-to-bytes: Convert field element to 32 LE bytes
;; ================================================================
(declaim (overridable fe-to-bytes))
(defun fe-to-bytes (fe)
  (declare (simple-vector fe) (optimize (safety 0)))
  (fe-reduce fe)
  (let ((r (make-array 32)))
    (let ((l0 (svref fe 0))
          (l1 (svref fe 1))
          (l2 (svref fe 2))
          (l3 (svref fe 3))
          (l4 (svref fe 4))
          (l5 (svref fe 5))
          (l6 (svref fe 6))
          (l7 (svref fe 7))
          (l8 (svref fe 8))
          (l9 (svref fe 9)))
      (aset r 0 (logand l0 #xFF))
      (aset r 1 (logand (ash l0 -8) #xFF))
      (aset r 2 (logand (ash l0 -16) #xFF))
      (aset r 3 (logand (logior (ash l0 -24) (ash l1 2)) #xFF))
      (aset r 4 (logand (ash l1 -6) #xFF))
      (aset r 5 (logand (ash l1 -14) #xFF))
      (aset r 6 (logand (logior (ash l1 -22) (ash l2 3)) #xFF))
      (aset r 7 (logand (ash l2 -5) #xFF))
      (aset r 8 (logand (ash l2 -13) #xFF))
      (aset r 9 (logand (logior (ash l2 -21) (ash l3 5)) #xFF))
      (aset r 10 (logand (ash l3 -3) #xFF))
      (aset r 11 (logand (ash l3 -11) #xFF))
      (aset r 12 (logand (logior (ash l3 -19) (ash l4 6)) #xFF))
      (aset r 13 (logand (ash l4 -2) #xFF))
      (aset r 14 (logand (ash l4 -10) #xFF))
      (aset r 15 (logand (ash l4 -18) #xFF))
      (aset r 16 (logand l5 #xFF))
      (aset r 17 (logand (ash l5 -8) #xFF))
      (aset r 18 (logand (ash l5 -16) #xFF))
      (aset r 19 (logand (logior (ash l5 -24) (ash l6 1)) #xFF))
      (aset r 20 (logand (ash l6 -7) #xFF))
      (aset r 21 (logand (ash l6 -15) #xFF))
      (aset r 22 (logand (logior (ash l6 -23) (ash l7 3)) #xFF))
      (aset r 23 (logand (ash l7 -5) #xFF))
      (aset r 24 (logand (ash l7 -13) #xFF))
      (aset r 25 (logand (logior (ash l7 -21) (ash l8 4)) #xFF))
      (aset r 26 (logand (ash l8 -4) #xFF))
      (aset r 27 (logand (ash l8 -12) #xFF))
      (aset r 28 (logand (logior (ash l8 -20) (ash l9 6)) #xFF))
      (aset r 29 (logand (ash l9 -2) #xFF))
      (aset r 30 (logand (ash l9 -10) #xFF))
      (aset r 31 (logand (ash l9 -18) #xFF))
      r)))

;; ================================================================
;; fe-store-fixed / fe-load-fixed
;; ================================================================
;; Limbs to / from ten raw u32 words at a FIXED address (not heap memory,
;; so nothing can move it): the Ed25519 constants at (e1000-state-base).
(declaim (overridable fe-store-fixed))
(defun fe-store-fixed (fe addr)
  (declare (simple-vector fe) (optimize (safety 0)))
  (setf (mem-ref addr :u32) (svref fe 0))
  (setf (mem-ref (+ addr 4) :u32) (svref fe 1))
  (setf (mem-ref (+ addr 8) :u32) (svref fe 2))
  (setf (mem-ref (+ addr 12) :u32) (svref fe 3))
  (setf (mem-ref (+ addr 16) :u32) (svref fe 4))
  (setf (mem-ref (+ addr 20) :u32) (svref fe 5))
  (setf (mem-ref (+ addr 24) :u32) (svref fe 6))
  (setf (mem-ref (+ addr 28) :u32) (svref fe 7))
  (setf (mem-ref (+ addr 32) :u32) (svref fe 8))
  (setf (mem-ref (+ addr 36) :u32) (svref fe 9)))

(declaim (overridable fe-load-fixed))
(defun fe-load-fixed (dst addr)
  (declare (simple-vector dst) (optimize (safety 0)))
  (setf (svref dst 0) (mem-ref addr :u32))
  (setf (svref dst 1) (mem-ref (+ addr 4) :u32))
  (setf (svref dst 2) (mem-ref (+ addr 8) :u32))
  (setf (svref dst 3) (mem-ref (+ addr 12) :u32))
  (setf (svref dst 4) (mem-ref (+ addr 16) :u32))
  (setf (svref dst 5) (mem-ref (+ addr 20) :u32))
  (setf (svref dst 6) (mem-ref (+ addr 24) :u32))
  (setf (svref dst 7) (mem-ref (+ addr 28) :u32))
  (setf (svref dst 8) (mem-ref (+ addr 32) :u32))
  (setf (svref dst 9) (mem-ref (+ addr 36) :u32))
  dst)

;; ================================================================
;; fe-mul: donna32 schoolbook
;; ================================================================
;; Single function matching original crypto.lisp structure exactly,
;; but reading limb slots with SVREF instead of buf-read-u32.
;; Uses: let (20 limbs) → let (14 precomputed)
;;     → let* (50+ products/carry) → 10 writes
;; Total ~90 frame slots, well within 120 limit.
;;
;; TWO FORMS OF ONE PRODUCT (docs/w32.md, M3b).  On a 64-bit target every
;; product and column sum below is a fixnum, and FE-MUL compiles exactly the
;; generic body.  On a 30-bit tower the 26x26-bit products are bignums: every
;; FE-MUL allocated ~100 of them and an X25519 took 5-6.5 s on bare i386.
;; There, (%IF-W32 ...) picks a body in raw 32-bit words instead: each product
;; is W32-MUL / W32-MULHU into a (lo, hi) pair, each column a 64-bit sum with
;; its carries, the carry chain 64-bit shifts -- no allocation, no call, so
;; no raw word is live across a GC point (spec C3).  The raw words live in
;; the W- variables (W32-REF reads one, a W32-RAW root writes one), which
;; hold nothing a Lisp form may touch.
;;
;; The W32 body needs every limb in [0, 2^27): then 2*f < 2^28, 19*g < 2^31.3
;; (one word), a product < 2^59.3 and a column < 2^62.6 (two words), and
;; every result limb < 2^26 + 2^16 (a fixnum).  X25519's inputs always are
;; (fe-add of two carried elements); Ed25519's FE-ADD chains can pass it,
;; and those take the generic body, unchanged.
(defmacro fe-mul-generic-body ()
  `(let ((f0 (svref f 0))
            (f1 (svref f 1))
            (f2 (svref f 2))
            (f3 (svref f 3))
            (f4 (svref f 4))
            (f5 (svref f 5))
            (f6 (svref f 6))
            (f7 (svref f 7))
            (f8 (svref f 8))
            (f9 (svref f 9))
            (g0 (svref g 0))
            (g1 (svref g 1))
            (g2 (svref g 2))
            (g3 (svref g 3))
            (g4 (svref g 4))
            (g5 (svref g 5))
            (g6 (svref g 6))
            (g7 (svref g 7))
            (g8 (svref g 8))
            (g9 (svref g 9)))
        (let ((f1-2 (* 2 f1))
              (f3-2 (* 2 f3))
              (f5-2 (* 2 f5))
              (f7-2 (* 2 f7))
              (f9-2 (* 2 f9))
              (g1-19 (* 19 g1))
              (g2-19 (* 19 g2))
              (g3-19 (* 19 g3))
              (g4-19 (* 19 g4))
              (g5-19 (* 19 g5))
              (g6-19 (* 19 g6))
              (g7-19 (* 19 g7))
              (g8-19 (* 19 g8))
              (g9-19 (* 19 g9)))
          (let* ((h0 (+ (* f0 g0) (* f1-2 g9-19) (* f2 g8-19) (* f3-2 g7-19) (* f4 g6-19)
                       (* f5-2 g5-19) (* f6 g4-19) (* f7-2 g3-19) (* f8 g2-19) (* f9-2 g1-19)))
                 (h1 (+ (* f0 g1) (* f1 g0) (* f2 g9-19) (* f3 g8-19) (* f4 g7-19)
                       (* f5 g6-19) (* f6 g5-19) (* f7 g4-19) (* f8 g3-19) (* f9 g2-19)))
                 (h2 (+ (* f0 g2) (* f1-2 g1) (* f2 g0) (* f3-2 g9-19) (* f4 g8-19)
                       (* f5-2 g7-19) (* f6 g6-19) (* f7-2 g5-19) (* f8 g4-19) (* f9-2 g3-19)))
                 (h3 (+ (* f0 g3) (* f1 g2) (* f2 g1) (* f3 g0) (* f4 g9-19)
                       (* f5 g8-19) (* f6 g7-19) (* f7 g6-19) (* f8 g5-19) (* f9 g4-19)))
                 (h4 (+ (* f0 g4) (* f1-2 g3) (* f2 g2) (* f3-2 g1) (* f4 g0)
                       (* f5-2 g9-19) (* f6 g8-19) (* f7-2 g7-19) (* f8 g6-19) (* f9-2 g5-19)))
                 (h5 (+ (* f0 g5) (* f1 g4) (* f2 g3) (* f3 g2) (* f4 g1)
                       (* f5 g0) (* f6 g9-19) (* f7 g8-19) (* f8 g7-19) (* f9 g6-19)))
                 (h6 (+ (* f0 g6) (* f1-2 g5) (* f2 g4) (* f3-2 g3) (* f4 g2)
                       (* f5-2 g1) (* f6 g0) (* f7-2 g9-19) (* f8 g8-19) (* f9-2 g7-19)))
                 (h7 (+ (* f0 g7) (* f1 g6) (* f2 g5) (* f3 g4) (* f4 g3)
                       (* f5 g2) (* f6 g1) (* f7 g0) (* f8 g9-19) (* f9 g8-19)))
                 (h8 (+ (* f0 g8) (* f1-2 g7) (* f2 g6) (* f3-2 g5) (* f4 g4)
                       (* f5-2 g3) (* f6 g2) (* f7-2 g1) (* f8 g0) (* f9-2 g9-19)))
                 (h9 (+ (* f0 g9) (* f1 g8) (* f2 g7) (* f3 g6) (* f4 g5)
                       (* f5 g4) (* f6 g3) (* f7 g2) (* f8 g1) (* f9 g0)))
                 ;; Carry chain
                 (c0 (ash h0 -26)) (r0 (logand h0 #x3FFFFFF))
                 (h1b (+ h1 c0))
                 (c1 (ash h1b -25)) (r1 (logand h1b #x1FFFFFF))
                 (h2b (+ h2 c1))
                 (c2 (ash h2b -26)) (r2 (logand h2b #x3FFFFFF))
                 (h3b (+ h3 c2))
                 (c3 (ash h3b -25)) (r3 (logand h3b #x1FFFFFF))
                 (h4b (+ h4 c3))
                 (c4 (ash h4b -26)) (r4 (logand h4b #x3FFFFFF))
                 (h5b (+ h5 c4))
                 (c5 (ash h5b -25)) (r5 (logand h5b #x1FFFFFF))
                 (h6b (+ h6 c5))
                 (c6 (ash h6b -26)) (r6 (logand h6b #x3FFFFFF))
                 (h7b (+ h7 c6))
                 (c7 (ash h7b -25)) (r7 (logand h7b #x1FFFFFF))
                 (h8b (+ h8 c7))
                 (c8 (ash h8b -26)) (r8 (logand h8b #x3FFFFFF))
                 (h9b (+ h9 c8))
                 (c9 (ash h9b -25)) (r9 (logand h9b #x1FFFFFF))
                 (r0w (+ r0 (* c9 19)))
                 (c0b (ash r0w -26))
                 (r0f (logand r0w #x3FFFFFF))
                 (r1f (+ r1 c0b)))
            (setf (svref dst 0) r0f)
            (setf (svref dst 1) r1f)
            (setf (svref dst 2) r2)
            (setf (svref dst 3) r3)
            (setf (svref dst 4) r4)
            (setf (svref dst 5) r5)
            (setf (svref dst 6) r6)
            (setf (svref dst 7) r7)
            (setf (svref dst 8) r8)
            (setf (svref dst 9) r9)))))

;; The (lo, hi) pair arithmetic, over the W- variables of FE-MUL's W32 body.
(defmacro w64-mul (lo hi a b)              ; (lo, hi) = a * b
  `(progn (setq ,lo (%w32 (w32-raw (w32-mul (w32-ref ,a) (w32-ref ,b)))))
          (setq ,hi (%w32 (w32-raw (w32-mulhu (w32-ref ,a) (w32-ref ,b)))))))
(defmacro w64-add (lo hi alo ahi)          ; (lo, hi) += (alo, ahi); AHI NIL = 0
  `(progn (setq ,lo (%w32 (w32-raw (w32-add (w32-ref ,lo) (w32-ref ,alo)))))
          ;; the carry out of the low word, a FIXNUM 0 or 1
          (setq w-cy (%w32 (w32-ltu (w32-ref ,lo) (w32-ref ,alo))))
          (setq ,hi (%w32 (w32-raw (w32-add (w32-add (w32-ref ,hi) (w32-from-fix w-cy))
                                            ,(if ahi `(w32-ref ,ahi) '(w32-li 0))))))))
(defmacro w64-column (&rest terms)         ; (w-lo, w-hi) = sum of a*b over TERMS
  `(progn (w64-mul w-lo w-hi ,(car (car terms)) ,(cadr (car terms)))
          ,@(mapcar (lambda (tm) `(progn (w64-mul w-pl w-ph ,(car tm) ,(cadr tm))
                                         (w64-add w-lo w-hi w-pl w-ph)))
                    (cdr terms))))
(defmacro w64-carry (r n)                  ; r = (w-lo, w-hi) mod 2^n; (w-cl, w-ch) = (w-lo, w-hi) >> n
  `(progn (setq ,r (%w32 (w32-raw (w32-and (w32-ref w-lo) (w32-li ,(- (ash 1 n) 1))))))
          (setq w-cl (%w32 (w32-raw (w32-or (w32-shr (w32-ref w-lo) ,n)
                                            (w32-shl (w32-ref w-hi) ,(- 32 n))))))
          (setq w-ch (%w32 (w32-raw (w32-shr (w32-ref w-hi) ,n))))))

(declaim (overridable fe-mul))
