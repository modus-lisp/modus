;;;
;;;   MODUS_EXTRA_SOURCE=test/w32-interp-diff.lisp sbcl ... mvm/build-riscv32-cli.lisp
;;;   qemu-riscv32-static IMAGE --eval '(modus-int::w32-diff)' --quit

