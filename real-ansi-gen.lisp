                                                  (SETQ N
                                                          (MULTIPLE-VALUE-LIST
                                                           (FUNCALL FN STREAM C
                                                                    5)))
                                                  (GET-OUTPUT-STREAM-STRING
                                                   STREAM)))
                                   UNLESS (OR (NOT C) (GRAPHIC-CHAR-P C)
                                              (AND (STRING= S (CHAR-NAME C))
                                                   (EQUAL N '((5)))))
                                   COLLECT (LIST C (CHAR-NAME C) S)))) 'NIL) (t (c) (%test-crash-fail-c 23861 c)))
  (handler-case (run-test 23862 (lambda () (LET ((FN (FORMATTER "~@C")) (N NIL))
                             (LOOP FOR C ACROSS +STANDARD-CHARS+
                                   FOR S = (LET ((STREAM
