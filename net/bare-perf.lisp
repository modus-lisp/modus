(defconstant +perf-stub-lit+ 16)
(defconstant +perf-handler+ 24)
(defconstant +perf-ctl-lit+ 312)
(defconstant +perf-arm+ 320)
(defconstant +perf-disarm+ 416)
(defconstant +perf-vbar+ 468)
(defconstant +perf-barrier+ 548)
(defconstant +perf-stub-bytes+ 24)    ; the vector stub, literal included
;;; ---- END GENERATED ----

;;; the page: FIQ code at 0, trampolines at #x800 (32 bytes each), the control blocks at #x1000
;;; (64 bytes per core, then the frame bounds), scratch for the system-register probe at #x1200
;;; (64 bytes per core)
(defconstant +perf-page-bytes+ #x2000)
(defconstant +perf-tramps+ #x800)
(defconstant +perf-ctl+ #x1000)
(defconstant +perf-scratch+ #x1200)

(defvar *perf-page* nil "The exec page holding the perf code and control blocks, once made.")
(defvar *perf-rings* nil "(base . bytes-per-core): the sample rings, four cores' worth.")
(defvar *perf-vector-installed* nil)

(defun %perf-u64 (a)
  (+ (mem-ref a :u32) (* (mem-ref (+ a 4) :u32) 4294967296)))
(defun %perf-set-u64 (a v)
  (setf (mem-ref a :u32) (logand v #xFFFFFFFF))
  (setf (mem-ref (+ a 4) :u32) (logand (floor v 4294967296) #xFFFFFFFF))
  v)

(defun %perf-poke (addr words)
  (dotimes (i (length words)) (setf (mem-ref (+ addr (* 4 i)) :u32) (aref words i)))
  addr)

(defun %perf-tramp (slot entry x3)
  "A trampoline at slot SLOT: X3 = X3 (movz + three movk), then B to ENTRY.  Its address."
  (let* ((at (+ *perf-page* +perf-tramps+ (* 32 slot)))
         (w (lambda (i word) (setf (mem-ref (+ at (* 4 i)) :u32) word))))
    (dotimes (hw 4)
      (funcall w hw (logior (if (zerop hw) #xD2800003 #xF2800003) (ash hw 21)
                            (ash (logand (floor x3 (expt 2 (* 16 hw))) #xFFFF) 5))))
    (funcall w 4 (logior #x14000000 (logand (floor (- entry (+ at 16)) 4) #x3FFFFFF)))
    (%jit-icache-flush at 32)
    at))

(defun %perf-ctl (core) (+ *perf-page* +perf-ctl+ (* 64 core)))
(defun %perf-scratch (core) (+ *perf-page* +perf-scratch+ (* 64 core)))
(defun perf-setup ()
  "Make the perf page (once): the code, the trampolines, the control blocks.  T."
  (unless *perf-page*
    (let ((p (%mmap-exec-page +perf-page-bytes+)))
      (dotimes (i (floor +perf-page-bytes+ 4)) (setf (mem-ref (+ p (* 4 i)) :u32) 0))
      (%perf-poke p *perf-fiq-words*)
      (%perf-set-u64 (+ p +perf-stub-lit+) (+ p +perf-handler+))
      (%perf-set-u64 (+ p +perf-ctl-lit+) (+ p +perf-ctl+))
      (%jit-icache-flush p #x800)
      (setq *perf-page* p)))
  t)

;;; trampoline slots: 8+core probe, 18 barrier, 24+core arm, 28+core disarm
(defun %perf-call (slot entry x3) (%jit-call (%perf-tramp slot entry x3)))

(defun %perf-probe (&optional (core 0))
  "Read VBAR_EL2, CurrentEL, CNTFRQ, the core number, DAIF and HCR_EL2 into CORE's scratch."
  (perf-setup)
  (%perf-call (+ 8 core) (+ *perf-page* +perf-vbar+) (%perf-scratch core)))

(defun %perf-probe-read (&optional (core 0))
  (let ((s (%perf-scratch core)))
    (list :vbar (mem-ref s :u64) :el (ash (mem-ref (+ s 8) :u64) -2) :cntfrq (mem-ref (+ s 16) :u64)
          :core (mem-ref (+ s 24) :u64) :daif (mem-ref (+ s 32) :u64) :hcr (mem-ref (+ s 40) :u64))))

(defun perf-info ()
  "What the sampler will run on: (:vbar :el :cntfrq :core :daif :hcr) of the calling core."
  (%perf-probe) (%perf-probe-read))

;;; ---- sampling ------------------------------------------------------------------------------

(defun perf-install-vector ()
  "Point the FIQ vector (VBAR_EL2 + #x300) at the handler.  Refuses unless that entry is the
   bare `B .' it has always been: anything else is somebody else's handler."
  (perf-setup)
  (unless *perf-vector-installed*
    (let* ((vbar (getf (perf-info) :vbar)) (entry (+ vbar #x300)))
      (unless (= (mem-ref entry :u32) #x14000000)
        (error "perf: the FIQ vector at #x~x is not `B .' (#x~8,'0x) -- not installing"
               entry (mem-ref entry :u32)))
      (dotimes (i (floor +perf-stub-bytes+ 4))
        (unless (= i 0)
          (setf (mem-ref (+ entry (* 4 i)) :u32) (mem-ref (+ *perf-page* (* 4 i)) :u32))))
      ;; the first word last: until it changes, the entry is still `B .'
      (setf (mem-ref entry :u32) (mem-ref *perf-page* :u32))
      (%jit-icache-flush entry +perf-stub-bytes+)
      (setq *perf-vector-installed* entry)))
  *perf-vector-installed*)

(defun %perf-map-local ()
  "Map the BCM2836 local controller (PA #x40000000) if this image has not: the boot's tables map
   the first gigabyte only, through L2, and leave L1[1] -- #x40000000..#x7FFFFFFF -- empty.  That
   gigabyte becomes one Device-nGnRnE block (AttrIdx 1, AF).  An L1[1] already in use is left alone."
  (let ((d (%perf-u64 #x70008)))
    (cond ((zerop d)
           (%perf-set-u64 #x70008 #x40000405)
           (%perf-call 18 (+ *perf-page* +perf-barrier+) 0)
           :mapped)
          (t :present))))

(defun %perf-on-core (core code)
  "Run the native CODE (an address: a trampoline, built beforehand on this thread) on CORE: here
   for core 0 (the main thread's), else on that core's executor.  Only a %JIT-CALL crosses: an
   executor must not run interpreted code (its stores into shared memory are refused)."
  (let ((ex (case core
              (1 (and (boundp '*kz-usb*) (symbol-value '*kz-usb*)))
              (2 (and (boundp '*kz-scr*) (symbol-value '*kz-scr*)))
              (t nil))))
    (cond ((= core 0) (%jit-call code))
          (ex (bt-call ex (lambda () (%jit-call code) 0)))
          (t nil))))

(defun perf-start (&key (hz 1000) (depth 12) (cores '(0)) (ring-kb 512)
                        (lo #x1000) (hi #x20000000))
  "Sample CORES HZ times a second, DEPTH frames deep, into RING-KB per core.  Starts afresh."
  (perf-install-vector)
  (%perf-map-local)
  (let* ((bytes (* ring-kb 1024))
         (rings (or (and *perf-rings* (= (cdr *perf-rings*) bytes) *perf-rings*)
                    (setq *perf-rings* (cons (%mmap-exec-page (* 4 bytes)) bytes))))
         (ticks (max 1 (floor (getf (perf-info) :cntfrq) hz)))
         (bounds (+ *perf-page* +perf-ctl+ 256)))
    (%perf-set-u64 bounds lo)
    (%perf-set-u64 (+ bounds 8) hi)
    (dolist (core cores)
      (let ((c (%perf-ctl core)) (base (+ (car rings) (* core bytes))))
        (%perf-set-u64 c base)
        (%perf-set-u64 (+ c 8) (+ base bytes))
        (%perf-set-u64 (+ c 16) base)
        (%perf-set-u64 (+ c 24) ticks)
        (%perf-set-u64 (+ c 32) depth)
        (%perf-set-u64 (+ c 40) 0)
        (%perf-set-u64 (+ c 48) 0)
        (%perf-set-u64 (+ c 56) 0)
        (%perf-on-core core (%perf-tramp (+ 24 core) (+ *perf-page* +perf-arm+) 0))))
    (perf-status cores)))

(defun perf-stop (&optional (cores '(0 1 2 3)))
  "Stop sampling: each core's handler disarms its timer on the next tick; then FIQs are masked."
  (when *perf-page*
    (dolist (core cores) (%perf-set-u64 (+ (%perf-ctl core) 56) 1))
    (dolist (core cores)
      (%perf-on-core core (%perf-tramp (+ 28 core) (+ *perf-page* +perf-disarm+) 0))
))
  (perf-status cores))

(defun perf-status (&optional (cores '(0 1 2 3)))
  "Per core: (core samples dropped)."
  (when *perf-page*
    (loop for core in cores
          for c = (%perf-ctl core)
          collect (list core (%perf-u64 (+ c 40)) (%perf-u64 (+ c 48))))))

(defun perf-report (&key (cores '(0 1 2 3)) (top 40) (stream *standard-output*) alloc
                        (alloc-max #x4000000))
  "Fold the rings into stacks and print the TOP: `count pc;x30;ret0;ret1...' in hex, leaf
   first.  Also a flat top by PC.  The host symbolizes (net/bare-perf-report.py).
   With ALLOC, a sample's weight is not 1 but the BYTES its core allocated since the core's
   previous sample (each record carries the allocation pointer, x24 -- which holds the address
   HALVED, a fixnum): an allocation profile on the same samples, read by the same host script.
   On core 0 a step counts only when both samples lie in the same semispace of region 0 and
   it goes up: a collection between them moves the pointer to the other space, and the first
   attempt, which only capped the step, charged those jumps to whatever ran next (the
   collector's caller) -- most of the total.  Elsewhere a step must be under ALLOC-MAX.  So the
   bytes are a sample of what was allocated, not all of it."
  (let ((stacks (make-hash-table :test 'equal)) (flat (make-hash-table)) (n 0))
    (dolist (core cores)
      (let* ((c (%perf-ctl core)) (base (%perf-u64 c)) (wp (%perf-u64 (+ c 16)))
             (depth (%perf-u64 (+ c 32))) (rec (* 8 (+ 3 depth))) (prev nil)
             (rcb (and alloc (= core 0) (%conv-addr #x10000040)))
             (sz (and rcb (%gc-read64 (+ rcb 16))))
             (spaces (and rcb (list (%gc-read64 rcb) (%gc-read64 (+ rcb 8))))))
        (when (plusp base)
          (loop for r from base below wp by rec
                do (let* ((pc (%perf-u64 (+ r 8)))
                          (ap (* 2 (ash (%perf-u64 r) -16)))
                          (w (if alloc
                                 (let ((d (and prev (- ap prev))))
                                   (cond ((or (null d) (< d 0)) 0)
                                         (spaces
                                          (if (find-if (lambda (s) (and (<= s prev) (< ap (+ s sz))))
                                                       spaces)
                                              d 0))
                                         ((<= d alloc-max) d)
                                         (t 0)))
                                 1))
                          (frames (loop for i from 0 below depth
                                        for f = (%perf-u64 (+ r 24 (* 8 i)))
                                        until (zerop f) collect f))
                          (key (format nil "~x;~x~{;~x~}" pc (%perf-u64 (+ r 16)) frames)))
                     (setq prev ap)
                     (when (plusp w)
                       (incf n w)
                       (incf (gethash pc flat 0) w)
                       (incf (gethash key stacks 0) w)))))))
    (flet ((top-of (h)
             (let ((l '())) (maphash (lambda (k v) (push (cons v k) l)) h)
               (subseq (sort l #'> :key #'car) 0 (min top (length l))))))
      (format stream "~&PERF samples ~d~%" n)
      (dolist (e (top-of flat)) (format stream "PERF-PC ~d ~x~%" (car e) (cdr e)))
      (dolist (e (top-of stacks)) (format stream "PERF-STACK ~d ~a~%" (car e) (cdr e)))
      (finish-output stream)
      n)))
