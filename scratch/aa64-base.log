POST-REPLACE REAL.3:
(run-test 14335 (lambda () (LOOP FOR I = 4 THEN (ASH I 1)
                                 FOR TP = `(REAL 0 ,(EXACT-DIVIDE I 3))
                                 REPEAT 55
                                 UNLESS (AND (NOT (TYPEP -1 TP))
                                             (NOT (TYPEP -1.0e-4 TP))
                                             (TYPEP 0 TP) (TYPEP 1.0e-4 TP)
                                             (TYPEP 1 TP)
                                             (TYPEP (EXACT-DIVIDE I 3) TP)
                                             (NOT
                                              (TYPEP
                                               (EXACT-DIVIDE (GENERIC-1+ I) 3)
                                               TP)))
                                 COLLECT (LIST I TP))) 'NIL)

      14336 = REAL.4

POST-REPLACE REAL.4:
(run-test 14336 (lambda () (LOOP FOR I = 4 THEN (ASH I 1)
                                 FOR TP = `(REAL ,(GENERIC-NEGATE (EXACT-DIVIDE I 3)) 0)
                                 REPEAT 55
                                 UNLESS (AND
                                         (NOT
                                          (TYPEP
                                           (GENERIC-SUBTRACT -1
                                            (EXACT-DIVIDE I 3))
                                           TP))
                                         (TYPEP
                                          (GENERIC-NEGATE (EXACT-DIVIDE I 3))
                                          TP)
                                         (TYPEP -1 TP) (TYPEP 0 TP)
                                         (NOT (TYPEP 1 TP))
                                         (NOT (TYPEP (EXACT-DIVIDE I 3) TP))
                                         (NOT
                                          (TYPEP
                                           (GENERIC-1+ (EXACT-DIVIDE I 3))
                                           TP)))
                                 COLLECT (LIST I TP))) 'NIL)

