;;; = < > <= >= /= + - * MAX MIN as FUNCTIONS (FUNCALL, APPLY, :TEST #'=, REDUCE): every arity, and two arguments
;;; without consing an &rest list (cl-types.lisp =, cl-eval.lisp MAX).  Calls the compiler sees are open-coded;
;;; these are the function objects.  Checked on SBCL too.  Run: ./modus --script THIS
(defpackage :variadic-arith-test (:use :cl))
(in-package :variadic-arith-test)
(defvar *fails* 0)
(defvar *checks* 0)
(defmacro check (name form expect)
  `(let ((got (handler-case ,form (error () :error))))
     (incf *checks*)
     (unless (equalp got ,expect)
       (incf *fails*)
       (format t "FAIL ~a: got ~s want ~s~%" ,name got ,expect))))
(defun call (f &rest args) (apply f args))
(defvar *nums* (list 0 1 -1 2 5 7/2 2.5 2.5d0 (expt 2 70) (- (expt 2 70)) most-positive-fixnum most-negative-fixnum))

(dolist (op '(= /= < > <= >=))
  (let ((f (symbol-function op)))
    (check (list op "pairs")
           (loop for a in *nums* append (loop for b in *nums* collect (funcall f a b)))
           (loop for a in *nums* append (loop for b in *nums* collect (eval (list op a b)))))
    (check (list op "one") (funcall f 3) t)
    (check (list op "three") (list (funcall f 1 2 3) (funcall f 3 2 1) (funcall f 2 2 2) (funcall f 1 2 1))
           (list (eval (list op 1 2 3)) (eval (list op 3 2 1)) (eval (list op 2 2 2)) (eval (list op 1 2 1))))
    (check (list op "apply 5") (apply f '(1 2 3 4 5)) (eval (list* op '(1 2 3 4 5))))
    (check (list op "not a number") (funcall f 1 'x) :error)))
(check "= one non-number" (funcall #'= 'x) :error)
(check "= float int" (funcall #'= 2 2.0) t)
(check "/= distinct" (list (funcall #'/= 1 2 3) (funcall #'/= 1 2 1)) (list t nil))

(check "+ arities" (list (call #'+) (call #'+ 3) (call #'+ 3 4) (call #'+ 1 2 3 4) (call #'+ 1/2 0.5) (call #'+ most-positive-fixnum 1))
       (list 0 3 7 10 1.0 (1+ most-positive-fixnum)))
(check "+ -0.0 alone" (call #'+ -0.0) -0.0)
(check "- arities" (list (call #'- 3) (call #'- 10 4) (call #'- 10 1 2 3) (call #'- most-negative-fixnum 1)) (list -3 6 4 (1- most-negative-fixnum)))
(check "* arities" (list (call #'*) (call #'* 3) (call #'* 3 4) (call #'* 1 2 3 4) (call #'* (expt 2 40) (expt 2 40))) (list 1 3 12 24 (expt 2 80)))
(check "max min" (list (call #'max 3) (call #'max 1 5) (call #'max 5 1) (call #'max 1 9 3) (call #'min 3) (call #'min 1 5) (call #'min 5 1) (call #'min 4 0 9))
       (list 3 5 5 9 3 1 1 0))
(check "reduce +" (reduce #'+ '(1 2 3 4 5)) 15)
(check "sort <" (sort (list 3 1 2) #'<) (list 1 2 3))
(check "find :test =" (find 3 (vector 1 2 3 4) :test #'=) 3)
(check "position :test = float" (position 2 (vector 1 2.0 3) :test #'=) 1)

(format t "variadic-arith: ~d checks, ~d failed~%" *checks* *fails*)
(if (zerop *fails*) (format t "PASS~%") (format t "FAIL~%"))
