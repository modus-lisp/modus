;; === typep.lsp ===
(IN-PACKAGE "CL-TEST")
(DEFUN TYPEP.19-FN (REPS &OPTIONAL (PROB 0.5))
  (LET* ((VEC "abcdefghijklmnopqrstuvwxyz"))
    (FLET ((%MAKE-RANDOM-TYPE ()
             `(AND CHARACTER
                   (MEMBER
                    ,@(LOOP FOR E ACROSS VEC
                            WHEN (< (RANDOM 1.0) PROB)
                            COLLECT E)))))
      (LOOP FOR T1 = (%MAKE-RANDOM-TYPE)
            FOR T2 = (%MAKE-RANDOM-TYPE)
            FOR T3 = `(AND ,T1 ,T2)
            FOR RESULT1 = (LOOP FOR E ACROSS VEC
                                WHEN (IF (TYPEP E T3)
                                         (OR (NOT (TYPEP E T1))
                                             (NOT (TYPEP E T2)))
                                         (AND (TYPEP E T1) (TYPEP E T2)))
                                COLLECT E)
            REPEAT REPS
            WHEN RESULT1
            NCONC (LIST RESULT1 T1 T2 T3)))))
