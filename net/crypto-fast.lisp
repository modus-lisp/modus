           (setf (svref dst 1) (logior (ash (the fixnum f1) 16) (the fixnum g1)))
           (setf (svref dst 2) (logior (ash (the fixnum f2) 16) (the fixnum g2)))
           (setf (svref dst 3) (logior (ash (the fixnum f3) 16) (the fixnum g3)))
           (setf (svref dst 4) (logior (ash (the fixnum f4) 16) (the fixnum g4)))
           (setf (svref dst 5) (logior (ash (the fixnum f5) 16) (the fixnum g5)))
           (setf (svref dst 6) (logior (ash (the fixnum f6) 16) (the fixnum g6)))
           (setf (svref dst 7) (logior (ash (the fixnum f7) 16) (the fixnum g7)))
           (setf (svref dst 8) (logior (ash (the fixnum f8) 16) (the fixnum g8)))
           (setf (svref dst 9) (logior (ash (the fixnum f9) 16) (the fixnum g9))))
         (fe-mul-generic-body)))
   (fe-mul-generic-body))
  dst)

(declaim (overridable fe-sq))
(defun fe-sq (dst f)
  (fe-mul dst f f))

;; ================================================================
;; x25519: Override to fix byte-order mismatch
;; ================================================================
;; Original uses buf-write-u32 (big-endian) to init FE arrays, but our
;; fe-mul/fe-add etc. read limb slots. Fix by using x25519-init-fe, which
;; writes the limbs into their slots.

(defun x25519-init-fe (dst n)
  (declare (simple-vector dst) (optimize (safety 0)))
  ;; Initialize pre-allocated field element to integer n
  (setf (svref dst 0) (logand n #x3FFFFFF))
  (setf (svref dst 1) (logand (ash n -26) #x1FFFFFF))
  (setf (svref dst 2) 0)
  (setf (svref dst 3) 0)
  (setf (svref dst 4) 0)
  (setf (svref dst 5) 0)
  (setf (svref dst 6) 0)
  (setf (svref dst 7) 0)
  (setf (svref dst 8) 0)
  (setf (svref dst 9) 0)
  dst)

(declaim (overridable x25519))
(defun x25519 (k u)
  (let ((kc (make-array 32))
        (x1 (make-array 40))
        (x2 (make-array 40)) (z2 (make-array 40))
        (x3 (make-array 40)) (z3 (make-array 40))
        (a (make-array 40)) (aa (make-array 40))
        (b (make-array 40)) (bb (make-array 40))
        (fe-e (make-array 40)) (c (make-array 40))
        (d (make-array 40)) (da (make-array 40))
        (cb (make-array 40)) (t1 (make-array 40))
        (t2 (make-array 40)) (a24 (make-array 40))
        (swap 0) (pos 254))
    (dotimes (i 32) (aset kc i (aref k i)))
    (aset kc 0 (logand (aref kc 0) #xF8))
    (aset kc 31 (logand (aref kc 31) #x7F))
    (aset kc 31 (logior (aref kc 31) #x40))
    ;; Initialize FEs limb by limb (not buf-write-u32, which is BE bytes)
    (fe-copy x1 (fe-from-bytes u))
    (x25519-init-fe x2 1)
    (x25519-init-fe z2 0)
    (fe-copy x3 x1)
    (x25519-init-fe z3 1)
    (x25519-init-fe a24 121665)
    ;; Montgomery ladder: 255 iterations
    (dotimes (iter 255)
      (let* ((byte-idx (ash pos -3))
             (bit-idx (logand pos 7))
             (byte-val (aref kc byte-idx))
             (mask (ash 1 bit-idx))
             (kt (if (zerop (logand byte-val mask)) 0 1)))
        (when (not (= kt swap))
          (fe-copy t1 x2) (fe-copy x2 x3) (fe-copy x3 t1)
          (fe-copy t1 z2) (fe-copy z2 z3) (fe-copy z3 t1))
        (setf swap kt)
        (fe-add a x2 z2)
        (fe-sq aa a)
        (fe-sub b x2 z2)
        (fe-sq bb b)
        (fe-sub fe-e aa bb)
        (fe-add c x3 z3)
        (fe-sub d x3 z3)
        (fe-mul da d a)
        (fe-mul cb c b)
        (fe-add t1 da cb)
        (fe-sq x3 t1)
        (fe-sub t1 da cb)
        (fe-sq t2 t1)
        (fe-mul z3 x1 t2)
        (fe-mul x2 aa bb)
        (fe-mul t1 a24 fe-e)
        (fe-add t2 aa t1)
        (fe-mul z2 fe-e t2))
      (setf pos (- pos 1))
      (when (zerop (logand iter 31)) (usb-keepalive)))
    (when (not (zerop swap))
      (fe-copy t1 x2) (fe-copy x2 x3) (fe-copy x3 t1)
      (fe-copy t1 z2) (fe-copy z2 z3) (fe-copy z3 t1))
    (fe-mul t1 x2 (fe-invert z2))
    (fe-to-bytes t1)))
