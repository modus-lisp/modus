(defun sq (x) (* x x))
(defun greet (name) (format nil "Hello, ~A!" name))
(defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(fib 20)
(defmacro twice (x) (list (quote progn) x x))
(let ((n 0)) (twice (incf n)) n)
(defun tak (x y z) (if (not (< y x)) z (tak (tak (1- x) y z) (tak (1- y) z x) (tak (1- z) x y))))
(tak 18 12 6)
(fib 25)
