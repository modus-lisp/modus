(defvar *n* "narrow literal string")
(defvar *w* (make-string 5 :initial-element #\λ))
(print (list :sub (subseq *n* 0 6) (subseq *n* 7) (subseq *n* 3 3) (subseq *w* 1 3) (subseq (concatenate 'string *n* *w*) 18 24)))
(print (list :types (type-of (subseq *n* 0 6)) (type-of (subseq *w* 1 3))))
(print (list :mut (let ((s (subseq *n* 0 6))) (setf (char s 0) #\λ) s) *n*))
(print (list :err (handler-case (subseq *n* 5 100) (error () :bounds)) (handler-case (subseq *n* -1 2) (error () :neg))))
(print (list :read (read-from-string "(\"abc\" foo-bar |MiXed|)") (symbol-name (read-from-string "pkg-sym-name-long"))))
(print (list :fmt (format nil "~A-~(~A~)-~:@(~A~)" "Abc" "XyZ" "hello world") (string-upcase "narrow") (string-trim " " "  pad  ")))
(print (list :search (search "lit" *n*) (position #\s *n*) (string= (subseq *n* 0 6) "narrow") (equal (subseq *n* 7 14) "literal")))
(print (list :long (length (subseq (make-string 1000 :initial-element #\a) 10 900))))
