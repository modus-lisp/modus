(defun mvm-sub-checked (buf vd va vb)
  (encode-instruction buf +op-sub-checked+ vd va vb))

(defun mvm-div (buf vd va vb)
  (encode-instruction buf +op-div+ vd va vb))

(defun mvm-mod (buf vd va vb)
