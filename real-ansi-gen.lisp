  (handler-case (run-test 23863 (lambda () (LET ((N NIL) (FN (FORMATTER "~@:c")))
                             (LOOP FOR C ACROSS +STANDARD-CHARS+
                                   FOR S1 = (LET ((STREAM
                                                   (MAKE-STRING-OUTPUT-STREAM)))
                                              (SETF N
                                                      (MULTIPLE-VALUE-LIST
