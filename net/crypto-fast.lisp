           (setq w-f2 (%w32 (w32-raw (w32-from-fix f2))))
           (setq w-f3 (%w32 (w32-raw (w32-from-fix f3))))
           (setq w-f4 (%w32 (w32-raw (w32-from-fix f4))))
           (setq w-f5 (%w32 (w32-raw (w32-from-fix f5))))
           (setq w-f6 (%w32 (w32-raw (w32-from-fix f6))))
           (setq w-f7 (%w32 (w32-raw (w32-from-fix f7))))
           (setq w-f8 (%w32 (w32-raw (w32-from-fix f8))))
           (setq w-f9 (%w32 (w32-raw (w32-from-fix f9))))
