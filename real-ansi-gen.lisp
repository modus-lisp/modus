(DEFMACRO DEF-WRITE-SEQUENCE-BV-TEST (NAME INPUT ARGS EXPECTED)
  `(DEFTEST ,NAME
    (LET ((S ,INPUT) (EXPECTED ,EXPECTED))
      (LET ((OS
             (OPEN "tmp.dat" :DIRECTION :OUTPUT :ELEMENT-TYPE
                   '(UNSIGNED-BYTE 8) :IF-EXISTS :SUPERSEDE)))
        (WHEN OS
          (LET ((%WOF-RESULT
                 (PROGN (ASSERT (EQ (WRITE-SEQUENCE S OS ,@ARGS) S)))))
            (CLOSE OS)
            %WOF-RESULT)))
      (LET ((IS
             (OPEN "tmp.dat" :DIRECTION :INPUT :ELEMENT-TYPE
                   '(UNSIGNED-BYTE 8))))
        (WHEN IS
          (LET ((%WOF-RESULT
                 (PROGN
                  (LOOP FOR I FROM 0 BELOW (LENGTH EXPECTED)
                        FOR E = (ELT EXPECTED I)
                        ALWAYS (EQL (READ-BYTE IS) E)))))
            (CLOSE IS)
            %WOF-RESULT))))
    T))
