(DEFUN VECTOR-PUSH-ERROR-TEST (SEQ VAL)
  (DECLARE (OPTIMIZE (SAFETY 3)))
  (HANDLER-CASE
   (EVAL
    `(LET ((A (COPY-SEQ ,SEQ)))
       (DECLARE (OPTIMIZE (SAFETY 3)))
       (OR (NOTNOT (ARRAY-HAS-FILL-POINTER-P A)) (VECTOR-PUSH ',VAL A))))
   (ERROR NIL T)))
