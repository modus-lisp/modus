;;;; tree.lisp PROFDIR PHASE [THRESHOLD] [MAXDEPTH] -- PHASE's samples as inclusive
;;;; and self time per function and a call tree (branches at or over THRESHOLD %,
;;;; default 4, at most MAXDEPTH deep, default 30).  Names from PROFDIR/idx.json
;;;; (mkidx).  It replaced tree.py (2026-11-21).
(load (merge-pathnames "prof-common.lisp" *load-truename*))
(in-package #:mac68k-prof)
(destructuring-bind (dir phase &optional (th "4.0") (maxd "30")) (argv)
  (let ((idx (read-idx dir)) (phase (parse-integer phase))
        (th (let ((*read-default-float-format* 'double-float)) (float (read-from-string th) 1d0)))
        (maxd (parse-integer maxd))
        (incl (make-counter)) (selfc (make-counter)) (n 0) (tree (list :root)))
    (flet ((nm (i) (if (>= i 0) (gethash i idx "?") "<res/native>")))
      (dolist (l (lines (format nil "~A/samples.txt" dir)))
        (let ((q (words l)))
          (when (and (>= (length q) 4) (= (parse-integer (first q)) phase))
            (incf n)
            (let ((path (collapse (append (reverse (mapcar (lambda (x) (nm (parse-integer x))) (nthcdr 4 q)))
                                          (list (nm (parse-integer (fourth q))))))))
              (dolist (f (remove-duplicates path :test #'string= :from-end t)) (bump incl f))
              (bump selfc (car (last path)))
              (tree-add tree path))))))
    (format t "samples ~D~%--- inclusive~%" n)
    (loop for (f . c) in (most-common incl 45)
          do (format t "~5,1F%  self ~4,1F%  ~A~%" (pct c n) (pct (count-of selfc f) n) f))
    (format t "--- tree (>= ~,1F%)~%" th)
    (tree-walk tree n th maxd "~A~4,1F% ~A~%")))
