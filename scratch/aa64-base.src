             (let* ((raw (aref sequence i))
                    (elem (if (and string-p (integerp raw)) (code-char raw) raw)))
               (let ((test-val (if key (funcall key elem) elem)))
                 (when (funcall predicate test-val)
                   (if from-end (setq result i) (return i)))))
             (setq i (+ i 1)))))))))

