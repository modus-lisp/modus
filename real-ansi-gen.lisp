;; === name-char.lsp ===
(defun run-init-name-char ()
  nil
)
(defun run-ansi-name-char-chunk-1 ()
  (handler-case (run-test 16548 (lambda () (NAME-CHAR.1.BODY)) 'NIL) (t (c) (%test-crash-fail-c 16548 c)))
  (handler-case (run-test 16549 (lambda () (LOOP FOR S IN '("RubOut" "PAGe" "BacKspace"
                                            "RetUrn" "Tab" "LineFeed" "SpaCE"
                                            "NewLine")
                                 UNLESS (LET ((C1
                                               (NAME-CHAR (STRING-UPCASE S)))
                                              (C2
                                               (NAME-CHAR (STRING-DOWNCASE S)))
                                              (C3
                                               (NAME-CHAR
                                                (STRING-CAPITALIZE S)))
                                              (C4 (NAME-CHAR S)))
                                          (AND (EQLT C1 C2) (EQLT C2 C3)
                                               (EQLT C3 C4)))
                                 COLLECT S)) 'NIL) (t (c) (%test-crash-fail-c 16549 c)))
  (handler-case (run-test-mv 16550 (lambda () (multiple-value-list (LET ((I 0))
                                                     (VALUES
                                                      (NAME-CHAR
                                                       (PROGN
                                                        (INCF I)
                                                        "Space"))
                                                      I)))) '(#\  1)) (t (c) (%test-crash-fail-c 16550 c)))
  (handler-case (run-test 16551 (lambda () (LOOP FOR ETYPE IN '(STANDARD-CHAR BASE-CHAR
                                                CHARACTER)
                                 APPEND (LOOP FOR S IN '("Rubout" "Page"
                                                         "Backspace" "Return"
                                                         "Tab" "Linefeed"
                                                         "Space" "Newline")
                                              FOR S2 = (MAKE-ARRAY (LENGTH S)
                                                                   :ELEMENT-TYPE
                                                                   'BASE-CHAR
                                                                   :INITIAL-CONTENTS
                                                                   S)
                                              UNLESS (EQL (NAME-CHAR S)
                                                          (NAME-CHAR S2))
                                              COLLECT (LIST S S2)))) 'NIL) (t (c) (%test-crash-fail-c 16551 c)))
  (handler-case (run-test 16552 (lambda () (LOOP FOR ETYPE IN '(STANDARD-CHAR BASE-CHAR
                                                CHARACTER)
                                 APPEND (LOOP FOR S IN '("Rubout" "Page"
                                                         "Backspace" "Return"
                                                         "Tab" "Linefeed"
                                                         "Space" "Newline")
                                              FOR S2 = (MAKE-ARRAY (LENGTH S)
                                                                   :ELEMENT-TYPE
                                                                   ETYPE
                                                                   :ADJUSTABLE
                                                                   T
                                                                   :INITIAL-CONTENTS
                                                                   S)
                                              UNLESS (EQL (NAME-CHAR S)
                                                          (NAME-CHAR S2))
                                              COLLECT (LIST ETYPE S S2)))) 'NIL) (t (c) (%test-crash-fail-c 16552 c)))
  (handler-case (run-test 16553 (lambda () (LOOP FOR ETYPE IN '(STANDARD-CHAR BASE-CHAR
                                                CHARACTER)
                                 APPEND (LOOP FOR S IN '("Rubout" "Page"
                                                         "Backspace" "Return"
                                                         "Tab" "Linefeed"
                                                         "Space" "Newline")
                                              FOR S2 = (MAKE-ARRAY
                                                        (+ 3 (LENGTH S))
                                                        :ELEMENT-TYPE ETYPE
                                                        :FILL-POINTER
                                                        (LENGTH S)
                                                        :INITIAL-CONTENTS
                                                        (CONCATENATE 'STRING S
                                                                     "   "))
                                              UNLESS (EQL (NAME-CHAR S)
                                                          (NAME-CHAR S2))
                                              COLLECT (LIST ETYPE S S2)))) 'NIL) (t (c) (%test-crash-fail-c 16553 c)))
  (handler-case (run-test 16554 (lambda () (LOOP FOR ETYPE IN '(STANDARD-CHAR BASE-CHAR
                                                CHARACTER)
                                 APPEND (LOOP FOR S IN '("Rubout" "Page"
                                                         "Backspace" "Return"
                                                         "Tab" "Linefeed"
                                                         "Space" "Newline")
                                              FOR S1 = (MAKE-ARRAY
                                                        (+ 4 (LENGTH S))
                                                        :ELEMENT-TYPE ETYPE
                                                        :INITIAL-CONTENTS
                                                        (CONCATENATE 'STRING
                                                                     "  " S
                                                                     "  "))
                                              FOR S2 = (MAKE-ARRAY (LENGTH S)
                                                                   :ELEMENT-TYPE
                                                                   ETYPE
                                                                   :DISPLACED-TO
                                                                   S1
                                                                   :DISPLACED-INDEX-OFFSET
                                                                   2)
                                              UNLESS (EQL (NAME-CHAR S)
                                                          (NAME-CHAR S2))
                                              COLLECT (LIST ETYPE S S2)))) 'NIL) (t (c) (%test-crash-fail-c 16554 c)))
  (handler-case (run-test 16555 (lambda () (HANDLER-CASE (PROGN (NAME-CHAR) NIL) (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 16555 c)))
