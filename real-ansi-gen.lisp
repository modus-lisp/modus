                                                               (MULTIPLE-VALUE-LIST
                                                                (APPLY FN
                                                                       STREAM C
                                                                       IGNORED)))
                                                       (GET-OUTPUT-STREAM-STRING
                                                        STREAM))))
                                               (UNLESS
                                                   (AND (STRING= S (STRING C))
                                                        (EQUAL N
                                                               (LIST IGNORED)))
                                                 (LIST S IGNORED N))))
                                   COLLECT IT))) 'NIL) (t (c) (%test-crash-fail-c 23858 c)))
  (handler-case (run-test 23859 (lambda () (LET ((FN (FORMATTER "~:C")))
                             (LOOP WITH
                                   COUNT = 0
                                   FOR I FROM 0 BELOW (MIN 65536
                                                           CHAR-CODE-LIMIT)
                                   FOR C = (CODE-CHAR I)
                                   FOR IGNORED = (LOOP FOR J BELOW (RANDOM 10)
                                                       COLLECT J)
                                   WHEN (AND C (EQL (CHAR-CODE C) (CHAR-INT C))
                                             (GRAPHIC-CHAR-P C)
                                             (NOT (EQL C #\ ))
                                             (LET* (N
                                                    (S
                                                     (LET ((STREAM
                                                            (MAKE-STRING-OUTPUT-STREAM)))
                                                       (SETQ N
                                                               (MULTIPLE-VALUE-LIST
                                                                (APPLY FN
                                                                       STREAM C
                                                                       IGNORED)))
                                                       (GET-OUTPUT-STREAM-STRING
                                                        STREAM))))
                                               (UNLESS
                                                   (AND (STRING= S (STRING C))
                                                        (EQUAL N
                                                               (LIST IGNORED)))
                                                 (INCF COUNT)
                                                 (LIST I C S IGNORED N))))
                                   COLLECT IT
                                   WHEN (> COUNT 100)
                                   COLLECT "count limit exceeded"
                                   AND
                                   DO (LOOP-FINISH)))) 'NIL) (t (c) (%test-crash-fail-c 23859 c)))
  (handler-case (run-test 23860 (lambda () (LET ((FN (FORMATTER "~:C")) (N NIL))
                             (LOOP FOR C ACROSS +STANDARD-CHARS+
                                   FOR S = (LET ((STREAM
