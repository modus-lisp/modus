(defun w32-diff ()
  "Print NAME native interp want, one line each, and a verdict."
  (let ((bad 0))
    (let ((a (w32d-w01-native)) (b (w32d-w01-interp)))
      (format t "~&~A native=~D interp=~D want=31~%" "w01" a b)
      (unless (and (eql a 31) (eql b 31)) (setq bad (+ bad 1))))
    (let ((a (w32d-w02-native)) (b (w32d-w02-interp)))
      (format t "~&~A native=~D interp=~D want=63~%" "w02" a b)
      (unless (and (eql a 63) (eql b 63)) (setq bad (+ bad 1))))
    (let ((a (w32d-w03-native)) (b (w32d-w03-interp)))
      (format t "~&~A native=~D interp=~D want=255~%" "w03" a b)
      (unless (and (eql a 255) (eql b 255)) (setq bad (+ bad 1))))
    (let ((a (w32d-w04-native)) (b (w32d-w04-interp)))
      (format t "~&~A native=~D interp=~D want=31~%" "w04" a b)
      (unless (and (eql a 31) (eql b 31)) (setq bad (+ bad 1))))
    (let ((a (w32d-w05-native)) (b (w32d-w05-interp)))
      (format t "~&~A native=~D interp=~D want=1023~%" "w05" a b)
      (unless (and (eql a 1023) (eql b 1023)) (setq bad (+ bad 1))))
    (let ((a (w32d-w06-native)) (b (w32d-w06-interp)))
      (format t "~&~A native=~D interp=~D want=15~%" "w06" a b)
      (unless (and (eql a 15) (eql b 15)) (setq bad (+ bad 1))))
    (format t "~&w32-diff: ~D mismatch~:P~%" bad)
    bad))
