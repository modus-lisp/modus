;;; Declared (simple-array (unsigned-byte N) (*)) for N other than 8 and 32 --
;;; the widths the runtime stores in the packed u32 vector -- takes the typed
;;; access path (compiler.lisp %U32-SIMPLE-ARRAY-DECL-P).  Same answers as SBCL.
;;; Run: ./modus --script test/typed-narrow-uint-aref.lisp  (also SBCL).
(defvar *fails* 0)
(defvar *checks* 0)
(defmacro check (name form expect)
  `(let ((got (handler-case ,form (error () :error))))
     (incf *checks*)
     (unless (equal got ,expect)
       (incf *fails*)
       (format t "FAIL ~a: got ~s want ~s~%" ,name got ,expect))))

(defun sum16 (a)
  (declare (type (simple-array (unsigned-byte 16) (*)) a))
  (let ((s 0)) (dotimes (i (length a) s) (incf s (aref a i)))))
(defun fill16 (a)
  (declare (type (simple-array (unsigned-byte 16) (*)) a))
  (dotimes (i (length a) a) (setf (aref a i) (* i 1000))))
(defun get-the (a i) (aref (the (simple-array (unsigned-byte 16) (*)) a) i))
(defun sum-the (a)
  (let ((s 0)) (dotimes (i (length a) s) (incf s (aref (the (simple-array (unsigned-byte 16) (*)) a) i)))))
(defun sum-the-u8 (a)
  (let ((s 0)) (dotimes (i (length a) s) (incf s (aref (the (simple-array (unsigned-byte 8) (*)) a) i)))))
(defstruct bx (data (make-array 16 :element-type '(unsigned-byte 8) :initial-element 2)
                 :type (simple-array (unsigned-byte 8) (*)))
               (words (make-array 4 :initial-element 5) :type simple-vector))
(defun bx-sum (b) (let ((s 0)) (dotimes (i 16 s) (incf s (aref (bx-data b) i)))))
(defun bx-poke (b) (dotimes (i 16 b) (setf (aref (bx-data b) i) (+ i 100))))
(defun bx-word (b i) (aref (bx-words b) i))
(defun bx-order (b)
  (let ((log nil))
    (setf (aref (progn (push :arr log) (bx-data b)) (progn (push :idx log) 0))
          (progn (push :val log) 7))
    (reverse log)))
(defun sum12 (a)
  (declare (type (simple-array (unsigned-byte 12) (*)) a))
  (let ((s 0)) (dotimes (i (length a) s) (incf s (aref a i)))))
(defun get31 (a i)
  (declare (type (simple-array (unsigned-byte 31) (*)) a))
  (aref a i))

(let ((a (make-array 64 :element-type '(unsigned-byte 16))))
  (fill16 a)
  (check "fill/sum u16" (sum16 a) (* 1000 (/ (* 63 64) 2)))
  (check "max u16 element" (progn (setf (aref a 3) 65535) (get-the a 3)) 65535)
  (check "THE u16" (get-the a 10) 10000)
  (check "THE u16 loop" (sum-the a) (+ (* 1000 (/ (* 63 64) 2)) (- 65535 3000)))
  (check "index past end" (get-the a 64) :error)
  (check "negative index" (get-the a -1) :error))
(let ((a (make-array 300 :element-type '(unsigned-byte 8) :initial-element 3)))
  (check "THE u8 loop" (sum-the-u8 a) 900))
(let ((b (make-bx)))
  (check "slot u8 read" (bx-sum b) 32)
  (check "slot u8 write" (progn (bx-poke b) (bx-sum b)) (+ 1600 120))
  (check "slot simple-vector read" (bx-word b 3) 5)
  (check "slot index past end" (bx-word b 4) :error)
  (check "store order arr idx val" (bx-order b) '(:arr :idx :val))
  (check "store landed" (aref (bx-data b) 0) 7))
(let ((a (make-array 5 :element-type '(unsigned-byte 12) :initial-contents '(1 2 3 4095 0))))
  (check "u12" (sum12 a) 4101))
(let ((a (make-array 3 :element-type '(unsigned-byte 31) :initial-element (1- (expt 2 31)))))
  (check "u31 top value" (get31 a 2) (1- (expt 2 31))))

(format t "typed-narrow-uint-aref: ~d checks, ~d failed~%" *checks* *fails*)
(if (zerop *fails*) (format t "PASS~%") (format t "FAIL~%"))
