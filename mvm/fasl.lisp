;;;; fasl.lisp — the FASL cache: a loaded file's compiled MVM modules, kept so the
;;;; next load of the same file skips the compiler.
;;;;
;;;; WHAT IS CACHED.  Modus compiles each toplevel form of a loaded file to one
;;;; MVM bytecode module and runs it (mvm-eval-forms).  Bytecode is the portable
;;;; layer -- the same bytes run on the interpreter of every target, and the JIT
;;;; translates them per architecture -- so the cache keeps BYTECODE, never native
;;;; code, and a cache written by one image can serve another (host, QEMU, board)
;;;; whose compiler is the same.  Per toplevel form the cache holds either:
;;;;
;;;;   a MODULE: the bytecode, its function / runtime-call / lambda tables, the
;;;;     DEFUN names it publishes, and the literal constants it loads -- each
;;;;     described portably (a symbol by package and name, a global variable's
;;;;     cell by its key, data recursively); or
;;;;   SOURCE: just the form's span of the file, read and evaluated as usual.
;;;;
;;;; A form is cached as a module only when its COMPILE had no lasting effect of
;;;; its own: anything the compiler registers while compiling (a macro, a special,
;;;; a setf function, an inline definition, a struct accessor, a deftype, a
;;;; declaim) calls %FASL-TAINT, and a tainted form is kept as source.  That is
;;;; compile-file's rule too -- a fasl replays what a form DOES, not what
;;;; compiling it did -- and side effects of user macroexpanders are not replayed,
;;;; exactly as on SBCL.  Definition heads are kept as source outright as a second
;;;; guard (*FASL-SOURCE-HEADS*).
;;;;
;;;; THE KEY.  A file's cache entry is found by a hash of: the compiler
;;;; fingerprint (%FASL-COMPILER-FINGERPRINT, baked at build), *FEATURES* (the
;;;; reader saw them), the package the load started in, the file's text, and the
;;;; LOAD CHAIN -- every file loaded before it in this session.  Change any file
;;;; and everything loaded after it misses; nothing stale can be replayed.
;;;; (Not chained: forms evaluated outside a file, e.g. --eval.  Documented risk.)
;;;;
;;;; WHERE.  Hosted: $MODUS_FASL_DIR, else ~/.cache/modus/fasl/, one KEY.mfasl per
;;;; file.  Bare metal has no writable filesystem: *FASL-MEM* is an in-memory
;;;; table a loader (kiln) fills with fasls built on the host.  MODUS_FASL=0 turns
;;;; the cache off; MODUS_FASL=verify recompiles every file and compares.

(defvar *fasl-depth* nil "mvm-eval-forms nesting depth (see %MVM-EVAL-FORMS-1).")
(defvar *fasl-base* nil "*FASL-DEPTH* at the load loop's current EVAL.")
(defvar *fasl-outer* nil "Outermost mvm-eval-forms calls made by the current form.")
(defvar *fasl-slot* nil "The current form's record slot, taken by its first compile.")
(defvar *fasl-chain* nil "Hash of every file loaded so far this session.")
(defvar *fasl-mem* nil "Bare metal / pushed fasls: alist KEY -> bytes.")
(defvar *fasl-stats* nil "(hits misses modules sources rejected) this session.")
(defvar *fasl-bad* nil)
(defvar *fasl-times* nil "alist phase -> internal time spent")
(defun %fasl-time (phase t0)
  (let ((d (- (get-internal-real-time) t0)) (hit (assoc phase *fasl-times*)))
    (if hit (setf (cdr hit) (+ (cdr hit) d)) (setq *fasl-times* (cons (cons phase d) *fasl-times*)))))
(defvar *fasl-reasons* nil "Why forms were kept as source: alist reason -> count.")

;; *FASL-TAINT* / %FASL-TAINT live in compiler.lisp: the compiler calls it, on
;; the build host too.

;; %FASL-COMPILER-FINGERPRINT is generated by the build (build-cli-common.lisp,
;; *FASL-FINGERPRINT-SOURCE*): a hash of the compiler and macro sources.

(defun %fasl-stat (i)
  (unless *fasl-stats* (setq *fasl-stats* (list 0 0 0 0 0)))
  (let ((c (nthcdr i *fasl-stats*))) (setf (car c) (+ (car c) 1))))

;;; ------------------------------------------------------------------
;;; Hashing: two independent 32-bit FNV-1a lanes, fixnum arithmetic only.
;;; ------------------------------------------------------------------

(defun %fasl-hash-string (s)
  (let ((a 2166136261) (b 3735928559) (n (length s)) (i 0))
    (loop
      (when (>= i n) (return nil))
      (let ((c (char-code (char s i))))
        (setq a (logand (* (logxor a c) 16777619) 4294967295))
        (setq b (logand (* (logxor b (logand (+ c 41) 65535)) 16777619) 4294967295)))
      (setq i (+ i 1)))
    (format nil "~8,'0x~8,'0x~x" a b n)))

;;; ------------------------------------------------------------------
;;; A growable byte buffer: (vector . fill).
;;; ------------------------------------------------------------------

(defun %fb-new () (cons (make-array 4096 :element-type '(unsigned-byte 8)) 0))

(defun %fb-byte (fb b)
  (let ((v (car fb)) (n (cdr fb)))
    (when (>= n (length v))
      (let ((g (make-array (* 2 (length v)) :element-type '(unsigned-byte 8))))
        (replace g v)
        (setf (car fb) g)
        (setq v g)))
    (setf (aref v n) b)
    (setf (cdr fb) (+ n 1))))

(defun %fb-bulk (fb v)
  "Append byte vector V with one REPLACE (a per-byte loop made a file record
   cost seconds)."
  (let ((need (+ (cdr fb) (length v))))
    (when (> need (length (car fb)))
      (let ((g (make-array (max need (* 2 (length (car fb)))) :element-type '(unsigned-byte 8))))
        (replace g (car fb) :end2 (cdr fb))
        (setf (car fb) g)))
    (replace (car fb) v :start1 (cdr fb))
    (setf (cdr fb) need)))

(defun %fb-bytes (fb)
  (let ((r (make-array (cdr fb) :element-type '(unsigned-byte 8))))
    (replace r (car fb) :end2 (cdr fb))
    r))

(defun %fb-uint (fb n)
  "Unsigned LEB128."
  (loop
    (let ((low (logand n 127)))
      (setq n (ash n -7))
      (if (zerop n)
          (progn (%fb-byte fb low) (return nil))
          (%fb-byte fb (logior low 128))))))

(defun %fb-sint (fb n)
  (%fb-uint fb (if (< n 0) (- (* -2 n) 1) (* 2 n))))

(defun %fb-string (fb s)
  (let ((n (length s)))
    (%fb-uint fb n)
    (dotimes (i n) (%fb-uint fb (char-code (char s i))))))

;;; ------------------------------------------------------------------
;;; Value encoding.  Anything not listed REJECTS the form (it stays source).
;;; ------------------------------------------------------------------

(defun %fasl-reject (why)
  (throw '%fasl-reject why))

;; THE LITERALS MUST BE A TREE.  The encoder writes each reference out in full,
;; so a constant that SHARES a cons or vector comes back as two objects -- and
;; (#1=(0) #1#) prints "((0) (0))" under *PRINT-CIRCLE* -- and one that is
;; CIRCULAR through both car and cdr, #1=(#1# . #1#), is walked exponentially:
;; the ANSI printer tests hung a load for hours at exactly that literal.  So the
;; form's constants are walked ONCE with an identity table first, and any
;; cons or vector reached twice keeps the form as source.  The table is keyed by
;; address, so a collection during the walk voids it: reject then too.  The
;; walk is bounded at 2000 nodes, because that table is linear (see NOTE).
(defun %fasl-check-tree (consts)
  (let ((seen (make-hash-table :test (function eq)))
        (n 0)
        (e0 (and (fboundp (quote %gc-epoch)) (funcall (quote %gc-epoch)))))
    (labels ((note (v)
               (when (gethash v seen) (%fasl-reject "shared or circular constant"))
               (setf (gethash v seen) t)
               (setq n (+ n 1))
               ;; An EQ table keyed by a cons has no index here -- PUTHASH and
               ;; GETHASH scan its entry list -- so this walk is QUADRATIC in
               ;; the nodes it notes.  At 1,000,000 a big literal in the ANSI
               ;; pprint tests pinned a load for an hour; at 2000 the worst
               ;; case is ~4M comparisons.  A larger constant stays source.
               (when (> n 2000) (%fasl-reject "constant too large")))
             (walk (v d)
               ;; down the cdr chain iteratively, so a long list is not deep;
               ;; the car depth is bounded as the encoder bounds it
               (when (> d 2000) (%fasl-reject "too deep"))
               (loop
                 (cond ((or (null v) (symbolp v) (pathnamep v) (%fasl-cell-key v))
                        ;; atoms to the encoder: a global's cell is encoded
                        ;; by key and replays as the same live cell
                        (return nil))
                       ((consp v) (note v) (walk (car v) (+ d 1)) (setq v (cdr v)))
                       ((and (vectorp v) (not (stringp v))
                             (not (equal (array-element-type v) '(unsigned-byte 8))))
                        (note v)
                        (when (simple-vector-p v)
                          (dotimes (i (length v)) (walk (svref v i) (+ d 1))))
                        (return nil))
                       (t (return nil))))))
      (dolist (c consts) (walk c 0)))
    (when (and e0 (not (eql e0 (funcall (quote %gc-epoch)))))
      (%fasl-reject "collection during constant check"))
    t))

(defun %fasl-cell-key (v)
  "V's key when V is the live (key . value) cell of a global variable."
  ;; IGNORE-ERRORS: %GV-CELL signals TYPE-ERROR for an integer that is no name
  ;; key at all -- an ordinary (offset . name) pair reaches here
  ;; FIXNUM, not INTEGERP: a global's key is a name-hash fixnum, and %GV-CELL
  ;; hashes its argument with fixnum arithmetic -- a literal with a BIGNUM car
  ;; sent it a heap pointer, and the fault was only hidden by IGNORE-ERRORS
  (and (consp v) (typep (car v) 'fixnum)
       (fboundp (quote %gv-cell))
       (ignore-errors (eq v (funcall (quote %gv-cell) (car v))))
       (car v)))

(defun %fasl-enc (fb v unint depth)
  "Encode V.  UNINT is a (list) whose CAR is the uninterned symbols seen so far
   in this record, so one gensym stays one object."
  (when (> depth 2000) (%fasl-reject "too deep"))
  (handler-case (%fasl-enc-1 fb v unint depth)
    (error (e) (setq *fasl-bad* v) (%fasl-reject (format nil "enc ~a at depth ~d: ~a" (ignore-errors (type-of v)) depth
                                     (ignore-errors (princ-to-string e)))))))

(defun %fasl-enc-1 (fb v unint depth)
  (cond
    ((null v) (%fb-byte fb 0))
    ((eq v t) (%fb-byte fb 1))
    ;; CONSP FIRST: an image that still honours cons array wrappers calls a
    ;; (fixnum . string) pair a STRING -- and runtime-call tables are made of them
    ((consp v)
     (let ((key (%fasl-cell-key v)))
       (if key
           (progn (%fb-byte fb 10) (%fb-sint fb key))
           ;; a list: its proper elements, then its tail
           (let ((n 0) (c v))
             (loop (if (and (consp c) (< n 1000000)) (progn (setq n (+ n 1)) (setq c (cdr c))) (return nil)))
             (when (consp c) (%fasl-reject "circular list"))
             (%fb-byte fb 7) (%fb-uint fb n)
             (let ((c v))
               (dotimes (i n) (%fasl-enc fb (car c) unint (+ depth 1)) (setq c (cdr c)))
               (%fasl-enc fb c unint (+ depth 1)))))))
    ((integerp v) (%fb-byte fb 2) (%fb-sint fb v))
    ((characterp v) (%fb-byte fb 3) (%fb-uint fb (char-code v)))
    ;; RANK FIRST: a zero- or multi-dimensional array is not a vector, but a 0-d
    ;; character array answers STRINGP here, so it was written as the
    ;; one-character string "x" and replayed as one -- ADJUST-ARRAY.STRING.17's
    ;; #.(make-array nil :element-type 'character) then faulted the harness's
    ;; comparison on a warm cache only.  Such a constant stays source.
    ((and (typep v 'array) (not (eql (array-rank v) 1)))
     (%fasl-reject "array of rank /= 1"))
    ;; any string, by its contents: a literal's identity and fill pointer do not
    ;; matter to code that loads it (and reader-made strings are not SIMPLE here)
    ((stringp v) (%fb-byte fb 4) (%fb-string fb v))
    ;; before CONSP / the vector arms: a pathname is cons-shaped here, and a
    ;; struct or CLOS instance is a #x32 array that would decode as a vector
    ((pathnamep v) (%fb-byte fb 14) (%fb-string fb (namestring v)))
    ((and (fboundp (quote %struct-instance-p)) (funcall (quote %struct-instance-p) v))
     (%fasl-reject "struct constant"))
    ((symbolp v)
     (let ((p (symbol-package v)))
       (if p
           (progn (%fb-byte fb 5) (%fb-string fb (package-name p))
                  (%fb-string fb (symbol-name v)))
           (let ((pos (position v (car unint))))
             (if pos
                 (progn (%fb-byte fb 15) (%fb-uint fb pos))
                 (progn (setf (car unint) (append (car unint) (list v)))
                        (%fb-byte fb 6) (%fb-string fb (symbol-name v))))))))
    ;; ELEMENT TYPE, not TYPEP: in modus (typep v '(simple-array (unsigned-byte 8)
    ;; (*))) answers T for a general vector too.
    ((and (vectorp v) (equal (array-element-type v) '(unsigned-byte 8)))
     (%fb-byte fb 9) (%fb-uint fb (length v))
     (%fb-bulk fb v))
    ;; a CLASS, instance, generic function, method combination or COMPLEX is
    ;; a vector here with a marker in slot 0: encoded as a vector it replayed
    ;; as one -- ANSI ETYPECASE.12's #.(find-class 'symbol nil) inside a
    ;; DEFTEST body came back a plain vector and the clause stopped matching
    ((and (simple-vector-p v) (> (length v) 0) (symbolp (svref v 0))
          (member (symbol-name (svref v 0))
                  '("%CLOS-INSTANCE" "%STRUCT-INSTANCE" "%CLOS-CLASS" "%CLASS-PROXY"
                    "%GENERIC-FUNCTION" "%METHOD-COMBINATION" "%METHOD-COMBINATION-LONG"
                    "%COMPLEX-MARKER")
                  :test (function string=)))
     (%fasl-reject "object constant"))
    ((and (simple-vector-p v) (eq (array-element-type v) t))
     (%fb-byte fb 8) (%fb-uint fb (length v))
     (dotimes (i (length v)) (%fasl-enc fb (svref v i) unint (+ depth 1))))
    ((typep v 'ratio)
     (%fb-byte fb 11) (%fb-sint fb (numerator v)) (%fb-sint fb (denominator v)))
    ((typep v 'double-float)
     (multiple-value-bind (m e s) (integer-decode-float v)
       (%fb-byte fb 12) (%fb-sint fb m) (%fb-sint fb e) (%fb-sint fb s)))
    ((typep v 'single-float)
     (multiple-value-bind (m e s) (integer-decode-float v)
       (%fb-byte fb 13) (%fb-sint fb m) (%fb-sint fb e) (%fb-sint fb s)))
    (t (%fasl-reject "unencodable constant"))))

;;; Decoding: a cursor (vector . position).

(defun %fd-byte (cur)
  (let ((v (car cur)) (p (cdr cur)))
    (when (>= p (length v)) (%fasl-reject "truncated"))
    (setf (cdr cur) (+ p 1))
    (aref v p)))

(defun %fd-uint (cur)
  (let ((n 0) (shift 0))
    (loop
      (let ((b (%fd-byte cur)))
        (setq n (logior n (ash (logand b 127) shift)))
        (setq shift (+ shift 7))
        (when (< b 128) (return n))))))

(defun %fd-sint (cur)
  (let ((z (%fd-uint cur)))
    (if (oddp z) (- (ash (+ z 1) -1)) (ash z -1))))

(defun %fd-string (cur)
  (let* ((n (%fd-uint cur)) (s (make-string n)))
    (dotimes (i n) (setf (char s i) (code-char (%fd-uint cur))))
    s))

(defun %fasl-dec (cur unint)
  (let ((tag (%fd-byte cur)))
    (case tag
      (0 nil)
      (1 t)
      (2 (%fd-sint cur))
      (3 (code-char (%fd-uint cur)))
      (4 (%fd-string cur))
      (5 (let* ((pn (%fd-string cur)) (nm (%fd-string cur)) (p (find-package pn)))
           (unless p (%fasl-reject "no package"))
           (intern nm p)))
      (6 (let ((s (make-symbol (%fd-string cur))))
           (setf (car unint) (append (car unint) (list s)))
           s))
      (15 (nth (%fd-uint cur) (car unint)))
      (7 (let* ((n (%fd-uint cur)) (head nil) (tail nil))
           (dotimes (i n)
             (let ((cell (list (%fasl-dec cur unint))))
               (if tail (setf (cdr tail) cell) (setq head cell))
               (setq tail cell)))
           (let ((end (%fasl-dec cur unint)))
             (if tail (progn (setf (cdr tail) end) head) end))))
      (8 (let* ((n (%fd-uint cur)) (v (make-array n)))
           (dotimes (i n) (setf (svref v i) (%fasl-dec cur unint)))
           v))
      (9 (let* ((n (%fd-uint cur)) (v (make-array n :element-type '(unsigned-byte 8)))
                (p (cdr cur)))
           (when (> (+ p n) (length (car cur))) (%fasl-reject "truncated"))
           (replace v (car cur) :start2 p :end2 (+ p n))
           (setf (cdr cur) (+ p n))
           v))
      (10 (let* ((key (%fd-sint cur))
                 (c (and (fboundp (quote %gv-cell)) (funcall (quote %gv-cell) key))))
            (unless (consp c) (%fasl-reject "no global cell"))
            c))
      (11 (let ((n (%fd-sint cur))) (/ n (%fd-sint cur))))
      (12 (let* ((m (%fd-sint cur)) (e (%fd-sint cur)) (s (%fd-sint cur)))
            (* s (scale-float (float m 1d0) e))))
      ;; a single-float decodes to a double-width mantissa here: rebuild exactly
      ;; as a double, then narrow
      (13 (let* ((m (%fd-sint cur)) (e (%fd-sint cur)) (s (%fd-sint cur)))
            (coerce (* s (scale-float (float m 1d0) e)) 'single-float)))
      (14 (pathname (%fd-string cur)))
      (otherwise (%fasl-reject "bad tag")))))

(defun %fasl-encode (v)
  (let ((fb (%fb-new))) (%fasl-enc fb v (list nil) 0) (%fb-bytes fb)))

(defun %fasl-decode (bytes)
  (%fasl-dec (cons bytes 0) (list nil)))

;;; ------------------------------------------------------------------
;;; Recording one form's module (called by %MVM-EVAL-FORMS-2 after the build,
;;; before the run).
;;; ------------------------------------------------------------------

(defun %fasl-source-heads ()
  "Toplevel heads always kept as source -- the second guard, for compile-time
   behaviour no registry write announces: DEFPACKAGE's package work,
   DEFCONSTANT's compile-time EVAL, EVAL-WHEN, DEFSTRUCT's accessor tables,
   the setf-expander definers, and the macro definers (also tainted).  DEFVAR,
   DECLAIM, IN-PACKAGE and the CLOS definers are not here: what their compile
   registers is data (%FASL-EFFECT) or nothing, and the taint catches the rest."
  '("DEFMACRO" "DEFINE-COMPILER-MACRO" "DEFINE-SYMBOL-MACRO" "DEFSTRUCT"
    "DEFSETF" "DEFINE-SETF-EXPANDER" "DEFINE-MODIFY-MACRO" "DEFCONSTANT"
    "DEFPACKAGE" "EVAL-WHEN" "DEFINE-PACKAGE" "DEFSYSTEM"))

(defun %fasl-source-head-p (forms)
  (let ((f (car forms)))
    (and (consp f) (symbolp (car f))
         (member (symbol-name (car f)) (%fasl-source-heads) :test (function string=)))))

(defun %fasl-walk-bc (bc fn)
  "Call FN with (opcode operands end-position) for each instruction of BC."
  (let ((pos 0) (n (length bc)))
    (loop
      (when (>= pos n) (return nil))
      (multiple-value-bind (op operands np) (decode-instruction-mv bc pos)
        (unless (and (integerp np) (> np pos)) (%fasl-reject "undecodable bytecode"))
        (funcall fn op operands np)
        (setq pos np)))))

(defun %fasl-put-u64 (bc end v)
  "Store V little-endian in the 8 bytes ending at END."
  (dotimes (k 8)
    (setf (aref bc (+ (- end 8) k)) (logand (ash v (* -8 k)) 255))))

(defun %fasl-record (slot forms bc entry ft-list fn-table rt-table lam-offsets
                     persist-names lam-bearing taint0)
  "Encode this module into SLOT's CAR, or leave it NIL (the form stays source)."
  (let ((t0 (get-internal-real-time)))
    (prog1 (%fasl-record-1 slot forms bc entry ft-list fn-table rt-table lam-offsets
                           persist-names lam-bearing taint0)
      (%fasl-time :record t0))))

(defun %fasl-record-1 (slot forms bc entry ft-list fn-table rt-table lam-offsets
                       persist-names lam-bearing taint0)
  (let ((r (catch '%fasl-reject
             (handler-case
                 (progn
                   (unless (eql taint0 *fasl-taint*)
                     (%fasl-reject (format nil "compile registered something (~a)" *fasl-taint-who*)))
                   (when (%fasl-source-head-p forms)
                     (%fasl-reject (format nil "definition head ~a" (car (car forms)))))
                   ;; constants: renumber every pool index this bytecode loads,
                   ;; densely, in first-use order -- and two indices holding ONE
                   ;; object share a number.  A special's per-site cache cons
                   ;; (%LET-SPECIAL-SITE, the global-read sites) is quoted by
                   ;; every access to it, each quote its own pool index: as two
                   ;; constants it was a "shared constant" and kept every DEFUN
                   ;; that reads a special as source, recompiled at each load.
                   ;; One number replays it as one object, still shared.
                   (let ((bc2 (copy-seq bc)) (idxs nil) (objs nil) (k 0))
                     (%fasl-walk-bc bc2
                       (lambda (op operands np)
                         (cond
                           ((or (eql op +op-li-addr+) (eql op +op-li-taddr+))
                            (%fasl-reject "layout address"))
                           ((eql op +op-li-const+)
                            (let* ((idx (cadr operands)) (hit (assoc idx idxs)))
                              (unless hit
                                (let* ((obj (gethash idx *e2-const-pool*))
                                       (pos (position obj objs :test (function eq))))
                                  (if pos
                                      (setq hit (cons idx (- k 1 pos)))
                                      (progn (setq hit (cons idx k))
                                             (setq objs (cons obj objs))
                                             (setq k (+ k 1))))
                                  (setq idxs (cons hit idxs))))
                              (%fasl-put-u64 bc2 np (cdr hit)))))))
                     (let ((consts (reverse objs))
                           (rt nil) (lam nil))
                       (%fasl-check-tree consts)
                       ;; the runtime-call names (positive keys; the negative ones
                       ;; are per-process call caches, rebuilt on replay)
                       (maphash (lambda (key v) (when (and (integerp key) (> key 0)) (push (cons key v) rt)))
                                rt-table)
                       (maphash (lambda (key v) (push (cons key v) lam)) lam-offsets)
                       (let ((rec (list 1 bc2 entry ft-list fn-table rt lam persist-names
                                       (and (or lam-bearing (%mvm-forms-define-methods-p forms)) t)
                                       consts
                                       (and (consp *fasl-effects*) (reverse (car *fasl-effects*))))))
                         (%fasl-encode rec)))))
               (error (e) (%fasl-reject (format nil "error while recording: ~a"
                                                (ignore-errors (princ-to-string e)))))))))
    (if (stringp r)
        (progn (%fasl-stat 4)
               (let ((hit (assoc r *fasl-reasons* :test (function string=))))
                 (if hit (setf (cdr hit) (+ (cdr hit) 1))
                     (setq *fasl-reasons* (cons (cons r 1) *fasl-reasons*)))))
        (setf (car slot) r))))

;;; ------------------------------------------------------------------
;;; Replaying one module.
;;; ------------------------------------------------------------------

(defun %fasl-prepare (bytes)
  "Decode a recorded module and make it runnable here: constants re-registered
   in this process's quote pool, the bytecode's pool indices moved to them.
   Throws %FASL-REJECT (caught by the caller, which then compiles the source)."
  (let* ((rec (%fasl-decode bytes)))
    (unless (and (consp rec) (eql (car rec) 1)) (%fasl-reject "bad record"))
    (let* ((bc (copy-seq (nth 1 rec))) (entry (nth 2 rec)) (ft-list (nth 3 rec))
           (fn-table (nth 4 rec)) (rt (nth 5 rec)) (lam (nth 6 rec))
           (persist (nth 7 rec)) (lam-bearing (nth 8 rec)) (consts (nth 9 rec))
           (idx (mapcar (function %e2-const-register) consts))
           (rt-table (make-hash-table)) (lam-offsets (make-hash-table)))
      (%fasl-walk-bc bc
        (lambda (op operands np)
          (when (eql op +op-li-const+)
            (%fasl-put-u64 bc np (nth (cadr operands) idx)))))
      (dolist (p rt)
        (setf (gethash (car p) rt-table) (cdr p))
        (setf (gethash (- (car p)) rt-table) (cons nil 0)))
      (dolist (p lam) (setf (gethash (car p) lam-offsets) (cdr p)))
      (list bc entry ft-list fn-table rt-table lam-offsets persist lam-bearing (nth 10 rec)))))

(defun %fasl-apply-effect (e)
  "Redo one logged compile-time registration (see %FASL-EFFECT)."
  (let ((k (car e)) (a (cdr e)))
    (cond ((eq k :special) (%note-runtime-special (car a)))
          ((eq k :optimize) (%declaim-note-optimize (car a)))
          ((eq k :declaim-special) (%declaim-note-special (car a)))
          ((eq k :declaim-inline) (%declaim-note-inline (car a)))
          ((eq k :declaim-type) (%declaim-note-type (car a)))
          ((eq k :inline-defun) (%inline-record-defun (car a) (cadr a) (caddr a)))
          ((eq k :setf-function) (%register-setf-function (car a))))))

(defun %fasl-run-prepared (p)
  "Called from %MVM-EVAL-FORMS-2 (the marker form): redo the module's logged
   compile-time registrations, then publish and run it."
  (dolist (e (nth 8 p)) (%fasl-apply-effect e))
  (%mvm-eval-publish-and-run nil (nth 0 p) (nth 1 p) (nth 2 p) (nth 3 p) (nth 4 p)
                             (nth 5 p) (nth 6 p) (nth 7 p) nil))

;;; ------------------------------------------------------------------
;;; Storage.
;;; ------------------------------------------------------------------

(defun %fasl-mode ()
  "NIL (off), :ON or :VERIFY."
  (let ((v (ignore-errors (%cli-getenv "MODUS_FASL"))))
    (cond ((and v (string= v "0")) nil)
          ((and v (string-equal v "verify")) :verify)
          (t :on))))

(defun %fasl-dir ()
  (let ((d (ignore-errors (%cli-getenv "MODUS_FASL_DIR"))))
    (if (and d (> (length d) 0))
        (if (char= (char d (- (length d) 1)) #\/) d (concatenate 'string d "/"))
        (let ((h (ignore-errors (%cli-getenv "HOME"))))
          (and h (> (length h) 0) (concatenate 'string h "/.cache/modus/fasl/"))))))

(defun fasl-mem-put (key bytes)
  "Make BYTES the fasl for KEY in this image (bare metal: kiln pushes them)."
  (setq *fasl-mem* (cons (cons key bytes) (remove key *fasl-mem* :key (function car) :test (function string=))))
  key)

(defun %fasl-get (key)
  (or (cdr (assoc key *fasl-mem* :test (function string=)))
      (let ((d (%fasl-dir)))
        (and d
             (ignore-errors
              (with-open-file (i (concatenate 'string d key ".mfasl")
                                 :element-type '(unsigned-byte 8) :if-does-not-exist nil)
                (and i
                     ;; a SHORT read leaves the tail zero, and zero decodes
                     ;; as NIL -- a record cut short would replay as valid
                     (let* ((n (file-length i))
                            (b (make-array n :element-type '(unsigned-byte 8))))
                       (and (eql (read-sequence b i) n) b)))))))))

(defun %fasl-put (key bytes)
  "Publish BYTES as KEY's fasl ATOMICALLY: write a file private to this process,
   then rename(2) it over KEY.mfasl.  Writing KEY.mfasl in place let a process
   loading the same file concurrently -- 32 sweep shards share one cache --
   replay another's half-written record: one of four concurrent loads of the
   ANSI suite came back 53 tests short."
  (let ((d (%fasl-dir)))
    (when d
      (ignore-errors
       (let* ((path (concatenate 'string d key ".mfasl"))
              (tmp (format nil "~a.~a.tmp" path (or (ignore-errors (%sys-getpid)) 0))))
         (ensure-directories-exist path)
         (with-open-file (o tmp :direction :output :element-type '(unsigned-byte 8)
                                :if-exists :supersede :if-does-not-exist :create)
           (write-sequence bytes o))
         (if (eql (%sys-rename tmp path) 0)
             t
             (progn (ignore-errors (delete-file tmp)) nil)))))))

;;; ------------------------------------------------------------------
;;; The load loops: %FASL-OPEN / %FASL-READ / %FASL-EVAL / %FASL-CLOSE.
;;; An FX is a list: (mode key text pos entries cached ok)
;;;   mode :record | :replay   entries: recorded (start end payload), newest first
;;;   cached: the replay queue (or, verifying, the old record to compare)
;;; ------------------------------------------------------------------

(defun %fasl-features-string ()
  (let ((names (mapcar (lambda (f) (if (symbolp f) (symbol-name f) (princ-to-string f))) *features*)))
    (format nil "~{~a~^,~}" (sort names (function string<)))))

(defun %fasl-key (text)
  (%fasl-hash-string
   (format nil "~a|~a|~a|~a|~a"
           (%fasl-compiler-fingerprint)
           (%fasl-hash-string (%fasl-features-string))
           (if *package* (package-name *package*) "")
           (or *fasl-chain* "")
           (%fasl-hash-string text))))

(defun %fasl-active-p ()
  "The cache is in use for this load: switched on, main thread, runtime eval."
  (and (%fasl-mode) (%mvm-on-main-thread-p) (not *static-build-p*)))

(defun %fasl-stream-text (stream)
  "STREAM's whole remaining text when it is a FILE being LOADed and the cache is
   active -- else NIL, and STREAM is left untouched."
  (when (and (typep stream 'file-stream) (%fasl-active-p))
    (with-output-to-string (o)
      (loop
        (let ((c (read-char stream nil nil)))
          (if c (write-char c o) (return nil)))))))

(defun %fasl-open (text)
  "Begin loading TEXT.  NIL when the cache is off (then the caller loads as before)."
  (let ((t0 (get-internal-real-time)))
    (prog1 (%fasl-open-1 text) (%fasl-time :open t0))))

(defun %fasl-open-1 (text)
  (let ((mode (%fasl-mode)))
    (when (and (stringp text) (%fasl-active-p))
      (let* ((t0 (get-internal-real-time))
             (key (prog1 (%fasl-key text) (%fasl-time :open-key t0)))
             (t1 (get-internal-real-time))
             (bytes (prog1 (%fasl-get key) (%fasl-time :open-read t1)))
             (t2 (get-internal-real-time))
             (rec (prog1 (and bytes (catch '%fasl-reject
                                      (handler-case (%fasl-decode bytes) (error (e) nil))))
                    (%fasl-time :open-decode t2))))
        (if (and (consp rec) (eq (car rec) :modus-fasl) (equal (caddr rec) key))
            (if (eq mode :verify)
                (list :record key text 0 nil (cadddr rec) t)
                (progn (%fasl-stat 0) (list :replay key text 0 nil (cadddr rec) t)))
            ;; Nowhere to keep a record (bare metal, no $HOME): do not pay for
            ;; one -- the board spent 3 s of boot recording its shims
            (when (%fasl-dir)
              (%fasl-stat 1) (list :record key text 0 nil nil t)))))))

(defun %fasl-read (fx eof)
  "The next toplevel form, EOF at the end -- or, replaying, a module marker."
  (let ((text (nth 2 fx)))
    (if (eq (car fx) :replay)
        (let ((e (car (nth 5 fx))))
          (if (null e)
              eof
              (progn
                (setf (nth 5 fx) (cdr (nth 5 fx)))
                (if (nth 2 e)
                    (list '%fasl-module-marker (nth 2 e) (nth 0 e) (nth 1 e) (nth 3 e))
                    (progn (%fasl-stat 3)
                           ;; a form COMPILE-FILE wrote itself (externalized
                           ;; literal objects) has no text of its own
                           (if (nth 3 e)
                               (nth 3 e)
                               (values (read-from-string text t nil :start (nth 0 e)))))))))
        (let ((start (nth 3 fx)))
          (multiple-value-bind (form end) (read-from-string text nil eof :start start)
            (setf (nth 3 fx) end)
            (unless (eq form eof)
              (setf (nth 4 fx) (cons (list start end nil) (nth 4 fx))))
            form)))))

(defun %fasl-eval (fx form)
  "EVAL FORM as the load loop would, recording or replaying through FX."
  (cond
    ((and (consp form) (eq (car form) '%fasl-module-marker))
     (let ((p (let ((t0 (get-internal-real-time)))
                (prog1 (catch '%fasl-reject
                         (handler-case (%fasl-prepare (cadr form)) (error (e) "prepare error")))
                  (%fasl-time :prepare t0)))))
       (if (stringp p)
           ;; the module cannot be rebuilt here: compile its source instead
           (progn (%fasl-stat 4)
                  (eval (or (nth 4 form)
                            (values (read-from-string (nth 2 fx) t nil :start (caddr form))))))
           (progn (%fasl-stat 2)
                  (let ((t0 (get-internal-real-time)))
                    (multiple-value-prog1 (eval (list '%fasl-module-marker p))
                      (%fasl-time :run-module t0)))))))
    ((eq (car fx) :record)
     (let ((entry (car (nth 4 fx)))
           (slot (list nil))
           (sv-base *fasl-base*) (sv-outer *fasl-outer*) (sv-slot *fasl-slot*))
       (setq *fasl-base* (or *fasl-depth* 0))
       (setq *fasl-outer* 0)
       (setq *fasl-slot* slot)
       (let ((val nil) (outer 0))
         (unwind-protect
              (setq val (multiple-value-list (eval form)))
           (setq outer *fasl-outer*)
           (setq *fasl-effects* nil)
           (setq *fasl-base* sv-base) (setq *fasl-outer* sv-outer) (setq *fasl-slot* sv-slot))
         ;; exactly one outermost compile, and it recorded: the module IS the form
         (when (and (eql outer 1) (car slot) (consp entry))
           (setf (nth 2 entry) (car slot)))
         (values-list val))))
    (t (eval form))))

(defun %fasl-close (fx ok)
  "End of the file.  OK: every form was read (no read error stopped the load)."
  (let ((t0 (get-internal-real-time)))
    (prog1 (%fasl-close-1 fx ok) (%fasl-time :close t0))))

(defun %fasl-close-1 (fx ok)
  (when fx
    (when (and ok (eq (car fx) :record))
      (let ((entries (reverse (nth 4 fx))))
        (when (nth 5 fx)                 ; verifying against an old record
          (let ((same 0) (diff 0))
            (do ((a entries (cdr a)) (b (nth 5 fx) (cdr b))) ((or (null a) (null b)))
              (if (equalp (nth 2 (car a)) (nth 2 (car b))) (setq same (+ same 1)) (setq diff (+ diff 1))))
            (format *error-output* "~&FASL-VERIFY ~a: ~d same, ~d differ, ~d vs ~d forms~%"
                    (nth 1 fx) same diff (length entries) (length (nth 5 fx)))))
        (dolist (e entries) (if (nth 2 e) (%fasl-stat 2) (%fasl-stat 3)))
        (let* ((t0 (get-internal-real-time))
               (b (prog1 (%fasl-encode (list :modus-fasl 1 (nth 1 fx) entries)) (%fasl-time :close-encode t0)))
               (t1 (get-internal-real-time)))
          (%fasl-put (nth 1 fx) b)
          (%fasl-time :close-write t1))))
    (setq *fasl-chain* (%fasl-hash-string (format nil "~a+~a" (or *fasl-chain* "") (nth 1 fx))))))

(defun fasl-stats ()
  "(:hits :misses :modules :sources :rejected) for this session."
  (let ((s (or *fasl-stats* (list 0 0 0 0 0))))
    (list :hits (nth 0 s) :misses (nth 1 s) :modules (nth 2 s) :sources (nth 3 s) :rejected (nth 4 s)
          :why *fasl-reasons* :ms (mapcar (lambda (p) (cons (car p) (round (* 1000 (cdr p)) internal-time-units-per-second))) *fasl-times*))))

;;; ------------------------------------------------------------------
;;; COMPILE-FILE's output: a COMPILED fasl.
;;;
;;; COMPILE-FILE used to copy the source text to the .fasl, so every LOAD of
;;; it compiled the whole file again -- and the cache above could not help a
;;; second load in one session, because its key chains every file loaded
;;; before (cl-bench LOAD-FASL: twenty loads of one fasl, twenty misses, 0.45 s
;;; each).  A compiled fasl is what CLHS 3.2.2.2 describes: the code the file
;;; compiled to, fixed at COMPILE-FILE time, which LOAD replays without asking
;;; what was loaded before it.
;;;
;;; It is the cache's own record -- per toplevel form a module or the form's
;;; source span -- plus the file's text, behind a magic line.  COMPILE-FILE
;;; produces it by compiling each form WITHOUT RUNNING it (*FASL-COMPILE-ONLY*,
;;; honoured at the one compile the record takes, in %MVM-EVAL-FORMS-2).  What
;;; must happen at compile time does: IN-PACKAGE, DEFPACKAGE and
;;; EVAL-WHEN :COMPILE-TOPLEVEL through %COMPILE-FILE-TOPLEVEL-EFFECTS, and every
;;; form the cache keeps as source because compiling it registered something
;;; (a macro, a struct, a setf expander, a constant ...) is run, so later forms
;;; compile against it -- the compile-time side of DEFMACRO and friends.  Other
;;; forms kept as source (a literal the encoder cannot write) are not run;
;;; LOAD evaluates them from the text, in order.
;;;
;;; A fasl from a different compiler (fingerprint) is loaded from its text,
;;; through the cache, like a source file.
;;; ------------------------------------------------------------------

;; *FASL-COMPILE-ONLY* / *FASL-COMPILE-HANDLED* live in compiler.lisp beside
;; *FASL-TAINT*: cl-eval.lisp and mvm-eval.lisp read them in every image.

(defun %fasl-magic () ";MODUS-FASL 1
")

(defun %fasl-compile-only-here-p ()
  "This compile is COMPILE-FILE's own compile of a toplevel form (not a nested
   EVAL inside a macroexpander or a compile-time run)."
  (and *fasl-compile-only*
       (eql *fasl-depth* (+ (if (integerp *fasl-base*) *fasl-base* 0) 1))))

(defun %fasl-compile-only-skip-p (slot forms taint0)
  "COMPILE-FILE: do not run what this compile built -- it became a module (LOAD
   runs it), it was already run for its compile-time effect, or it is a plain
   form kept as source (LOAD reads and runs it).  Run only a form whose compile
   registered something or whose head is a compile-time definer."
  (and (%fasl-compile-only-here-p)
       ;; CLHS DEFCLASS / DEFINE-CONDITION: at toplevel the compiler must know
       ;; the class for the rest of the file -- a macro's FIND-CLASS with the
       ;; environment, a TYPEP (ANSI FIND-CLASS.24).  So they run now as well,
       ;; and their module replays at LOAD.
       (not (let ((f (car forms)))
              (and (consp f) (symbolp (car f))
                   (member (symbol-name (car f)) '("DEFCLASS" "DEFINE-CONDITION")
                           :test (function string=)))))
       (or (and slot (car slot) t)
           *fasl-compile-handled*
           (not (or (not (eql taint0 *fasl-taint*))
                    (%fasl-source-head-p forms))))))

(defun %fasl-cf-handled-p (form)
  "%COMPILE-FILE-TOPLEVEL-EFFECTS ran all of FORM."
  (and (consp form) (symbolp (car form))
       (let ((h (symbol-name (car form))))
         (or (string= h "IN-PACKAGE") (string= h "DEFPACKAGE")
             (and (string= h "EVAL-WHEN") (consp (cdr form)) (listp (cadr form))
                  (or (member :compile-toplevel (cadr form))
                      (member 'compile (cadr form))))))))

(defun %fasl-load-begin ()
  "A LOAD starts: one run at compile time (an EVAL-WHEN of a file being
   COMPILE-FILE'd) runs its forms -- they are not COMPILE-FILE's to withhold.
   Returns the state for %FASL-LOAD-END."
  (prog1 *fasl-compile-only* (setq *fasl-compile-only* nil)))

(defun %fasl-load-end (saved)
  (setq *fasl-compile-only* saved))

(defun %fasl-slurp (stream)
  (with-output-to-string (o)
    (loop
      (let ((c (read-char stream nil nil)))
        (if c (write-char c o) (return nil))))))

(defun %fasl-text-pack (text)
  "TEXT as the fasl stores it: an (UNSIGNED-BYTE 8) vector when every character
   fits one, which is copied in bulk -- a string is a varint per character, and
   decoding gabriel.lisp's 55 KB that way was a quarter of each LOAD."
  (let ((n (length text)))
    (if (dotimes (i n t) (when (> (char-code (char text i)) 255) (return nil)))
        (let ((v (make-array n :element-type '(unsigned-byte 8))))
          (dotimes (i n) (setf (aref v i) (char-code (char text i))))
          v)
        text)))

(defun %fasl-text-unpack (v)
  (if (stringp v)
      v
      (let* ((n (length v)) (s (make-string n)))
        (dotimes (i n) (setf (char s i) (code-char (aref v i))))
        s)))

;;; ------------------------------------------------------------------
;;; Literal objects in a compiled file: MAKE-LOAD-FORM (CLHS 3.2.4.4).
;;;
;;; A CLOS or structure instance in a form's code (#.(make-instance ...))
;;; cannot be written into the fasl.  COMPILE-FILE asks the object for its
;;; creation and initialization forms and writes them as forms of their own,
;;; ahead of the form that uses it: the creation form stores the object in a
;;; per-file table (%FASL-OBJ-SET), and every reference -- in the form, or in
;;; another object's forms -- is replaced by (%FASL-OBJ-REF key n).  One object
;;; is one table slot, so the file's references stay EQ.  A class is replaced
;;; by (FIND-CLASS 'NAME).
;;;
;;; Order, as CLHS MAKE-LOAD-FORM puts it: an object's creation form runs after
;;; the creation (and, when possible, initialization) of the objects it
;;; references; its initialization form runs as soon after its creation as the
;;; objects it references allow -- one still being created defers it, and
;;; deferred initializations run, most recent first, once they can.
;;; ------------------------------------------------------------------

(defun %fasl-object-marker (v)
  "The marker symbol's name in slot 0 of an instance / class object, else NIL.
   (Such an object is a #x32 array but not SIMPLE-VECTOR-P here.)"
  (and (not (listp v)) (not (numberp v)) (not (characterp v)) (not (symbolp v))
       (not (stringp v)) (not (pathnamep v)) (not (functionp v))
       ;; the length first: an EMPTY vector's SVREF 0 signalled out of the
       ;; IGNORE-ERRORS that used to be all this had (image code) and killed
       ;; COMPILE-FILE of any file holding a #() -- the ANSI suite's own
       ;; ansi-aux.lsp among them
       (let ((n (ignore-errors (%prim-array-length v))))
         (and (integerp n) (> n 0)
              (let ((m (ignore-errors (svref v 0))))
                (and m (symbolp m) (symbol-name m)))))))

(defun %fasl-instance-p (v)
  (let ((m (%fasl-object-marker v)))
    (and m (or (string= m "%CLOS-INSTANCE") (string= m "%STRUCT-INSTANCE")))))

(defun %fasl-class-literal-p (v)
  (and (let ((m (%fasl-object-marker v)))
         (and m (or (string= m "%CLOS-CLASS") (string= m "%CLASS-PROXY"))))
       (let ((n (ignore-errors (class-name v))))
         (and n (symbolp n) (eq (find-class n nil) v)))))

(defun %fasl-has-objects-p (form)
  (let ((n 0))
    (labels ((walk (v d)
               (when (or (> d 200) (> n 20000)) (return-from %fasl-has-objects-p nil))
               (loop
                 (setq n (+ n 1))
                 (cond ((consp v) (walk (car v) (+ d 1)) (setq v (cdr v)))
                       ((or (%fasl-instance-p v) (%fasl-class-literal-p v))
                        (return-from %fasl-has-objects-p t))
                       ((and (simple-vector-p v) (not (stringp v)))
                        (dotimes (i (length v)) (walk (svref v i) (+ d 1)))
                        (return nil))
                       (t (return nil))))))
      (walk form 0)
      nil)))

(defun %fasl-objects-in (form)
  "The instances FORM refers to, in first-reference order."
  (let ((acc nil))
    (labels ((walk (v d)
               (when (< d 200)
                 (loop
                   (cond ((consp v) (walk (car v) (+ d 1)) (setq v (cdr v)))
                         ((%fasl-instance-p v)
                          (unless (member v acc :test (function eq)) (push v acc))
                          (return nil))
                         ((and (simple-vector-p v) (not (stringp v))
                               (not (%fasl-class-literal-p v)))
                          (dotimes (i (length v)) (walk (svref v i) (+ d 1)))
                          (return nil))
                         (t (return nil)))))))
      (walk form 0))
    (nreverse acc)))

(defvar *%fasl-ext-counter* 0)

(defun %fasl-ext-state ()
  "One file's externalization state: (KEY TABLE PRE DEFERRED NEXT), TABLE an
   alist object -> (index . :creating/:created)."
  (setq *%fasl-ext-counter* (+ (if (integerp *%fasl-ext-counter*) *%fasl-ext-counter* 0) 1))
  (list (format nil "~d-~d" (get-universal-time) *%fasl-ext-counter*) nil nil nil 0))

(defun %fasl-ext-entry (xs obj) (cdr (assoc obj (nth 1 xs) :test (function eq))))

(defun %fasl-datum-form (xs d)
  "A form evaluating to datum D, its instances replaced by table references."
  (cond ((%fasl-instance-p d)
         (list '%fasl-obj-ref (nth 0 xs) (car (%fasl-ext-entry xs d))))
        ((%fasl-class-literal-p d)
         (list 'find-class (list 'quote (class-name d))))
        ((not (%fasl-has-objects-p d)) (list 'quote d))
        ((consp d) (list 'cons (%fasl-datum-form xs (car d)) (%fasl-datum-form xs (cdr d))))
        ((simple-vector-p d)
         (cons 'vector (map 'list (lambda (e) (%fasl-datum-form xs e)) d)))
        (t (list 'quote d))))

(defun %fasl-subst-code (xs form)
  "FORM with each literal object replaced: a quoted datum by a form building
   it, a bare object by its table reference."
  (cond ((or (%fasl-instance-p form) (%fasl-class-literal-p form))
         (%fasl-datum-form xs form))
        ((atom form) form)
        ((and (eq (car form) 'quote) (consp (cdr form)))
         (if (%fasl-has-objects-p (cadr form)) (%fasl-datum-form xs (cadr form)) form))
        (t (let ((acc nil) (c form))
             (loop
               (cond ((consp c) (push (%fasl-subst-code xs (car c)) acc) (setq c (cdr c)))
                     (t (return (let ((r (nreverse acc)))
                                  (when c (setf (cdr (last r)) (%fasl-subst-code xs c)))
                                  r)))))))))

(defun %fasl-ext-push (xs form) (setf (nth 2 xs) (cons form (nth 2 xs))))

(defun %fasl-ext-flush (xs)
  "Emit every deferred initialization whose objects now all exist."
  (loop
    (let ((ready nil))
      (dolist (d (nth 3 xs))
        (when (and (null ready)
                   (every (lambda (o) (eq (cdr (%fasl-ext-entry xs o)) :created)) (cadr d)))
          (setq ready d)))
      (unless ready (return nil))
      (setf (nth 3 xs) (remove ready (nth 3 xs) :test (function eq)))
      (%fasl-ext-push xs (%fasl-subst-code xs (car ready))))))

(defun %fasl-ext-emit (xs obj)
  (unless (%fasl-ext-entry xs obj)
    (let ((idx (nth 4 xs)))
      (setf (nth 4 xs) (+ idx 1))
      (setf (nth 1 xs) (cons (cons obj (cons idx :creating)) (nth 1 xs)))
      (multiple-value-bind (create init) (make-load-form obj)
        (dolist (d (%fasl-objects-in create))
          (unless (eq d obj)
            (let ((e (%fasl-ext-entry xs d)))
              (when (and e (eq (cdr e) :creating))
                (error "circular MAKE-LOAD-FORM creation dependency between ~S and ~S" obj d))
              (%fasl-ext-emit xs d))))
        (%fasl-ext-push xs (list '%fasl-obj-set (nth 0 xs) idx (%fasl-subst-code xs create)))
        (setf (cdr (%fasl-ext-entry xs obj)) :created)
        (when init
          (let ((deps (remove obj (%fasl-objects-in init) :test (function eq))))
            (dolist (d deps) (%fasl-ext-emit xs d))
            (let ((waiting (remove-if (lambda (d) (eq (cdr (%fasl-ext-entry xs d)) :created))
                                      deps)))
              (if waiting
                  (setf (nth 3 xs) (cons (list init waiting) (nth 3 xs)))
                  (%fasl-ext-push xs (%fasl-subst-code xs init))))))
        (%fasl-ext-flush xs)))))

(defun %fasl-externalize (form xs)
  "(PRE-FORMS . NEW-FORM) for FORM: the creation / initialization forms of
   the objects it refers to not yet written, then FORM referring to them.
   Anything going wrong (no MAKE-LOAD-FORM method, a circular creation, a
   form the fasl cannot write) restores the state and signals: FORM then
   stays source, as before."
  (let ((saved-table (mapcar (lambda (e) (cons (car e) (cons (cadr e) (cddr e)))) (nth 1 xs)))
        (saved-deferred (nth 3 xs))
        (saved-next (nth 4 xs))
        (ok nil))
    (unwind-protect
         (progn
           (setf (nth 2 xs) nil)
           (dolist (o (%fasl-objects-in form)) (%fasl-ext-emit xs o))
           (let ((r (cons (reverse (nth 2 xs)) (%fasl-subst-code xs form))))
             (dolist (f (cons (cdr r) (car r)))
               (when (stringp (catch '%fasl-reject (%fasl-encode f)))
                 (error "an externalized form cannot be written")))
             (setq ok t)
             r))
      (unless ok
        (setf (nth 1 xs) saved-table)
        (setf (nth 3 xs) saved-deferred)
        (setf (nth 4 xs) saved-next)))))

(defvar *%fasl-object-table* nil)

(defun %fasl-obj-set (key idx v)
  (unless (and (boundp '*%fasl-object-table*) (hash-table-p *%fasl-object-table*))
    (setq *%fasl-object-table* (make-hash-table :test (function equal))))
  (setf (gethash (cons key idx) *%fasl-object-table*) v)
  v)

(defun %fasl-obj-ref (key idx)
  (multiple-value-bind (v found)
      (if (and (boundp '*%fasl-object-table*) (hash-table-p *%fasl-object-table*))
          (gethash (cons key idx) *%fasl-object-table*)
          (values nil nil))
    (unless found (error "a compiled file's literal object ~D was not created" idx))
    v))

(defun %fasl-compile-file (in out)
  "Compile the file IN to a compiled fasl at OUT; T.  NIL (and OUT untouched)
   where this image cannot -- off the main thread, or a build-time compile --
   and the caller writes the source instead."
  (when (and (%mvm-on-main-thread-p) (not *static-build-p*))
    (let* ((text (with-open-file (s in :direction :input) (%fasl-slurp s)))
           (fx (list :record "compile-file" text 0 nil nil t))
           (eof (cons nil nil))
           (sv-only *fasl-compile-only*)
           (sv-handled *fasl-compile-handled*)
           (xs (%fasl-ext-state)))
      (unwind-protect
           (loop
             (let ((form (%fasl-read fx eof)))
               (when (eq form eof) (return nil))
               (%compile-file-toplevel-effects form)
               (setq *fasl-compile-handled* (%fasl-cf-handled-p form))
               (setq *fasl-compile-only* t)
               ;; Literal objects (#.(make-instance ...)) become MAKE-LOAD-FORM
               ;; creation / initialization forms of their own, ahead of FORM.
               (let ((ext (handler-case (and (%fasl-has-objects-p form)
                                             (%fasl-externalize form xs))
                            (error (c) nil))))
                 (when ext
                   (let ((own (car (nth 4 fx))))
                     (setf (nth 4 fx) (cdr (nth 4 fx)))
                     (dolist (pre (car ext))
                       (setf (nth 4 fx) (cons (list (nth 0 own) (nth 0 own) nil pre)
                                              (nth 4 fx)))
                       (handler-case (%fasl-eval fx pre) (error (c) nil)))
                     (setq form (cdr ext))
                     (setf (nth 4 fx) (cons (list (nth 0 own) (nth 1 own) nil form)
                                            (nth 4 fx))))))
               ;; A form that does not compile is left as source: LOAD meets
               ;; the error where the source-copying COMPILE-FILE let it.
               (handler-case (%fasl-eval fx form)
                 (error (c)
                   (let ((e (car (nth 4 fx))))
                     (when (consp e) (setf (nth 2 e) nil)))))
               (setq *fasl-compile-only* sv-only)))
        (setq *fasl-compile-only* sv-only)
        (setq *fasl-compile-handled* sv-handled))
      (let ((m (%fasl-magic))
            (b (%fasl-encode (list :modus-compiled-fasl 1 (%fasl-compiler-fingerprint)
                                   (%fasl-text-pack text) (reverse (nth 4 fx))))))
        (with-open-file (o out :direction :output :element-type '(unsigned-byte 8)
                               :if-exists :supersede :if-does-not-exist :create)
          ;; Not WRITE-BYTE: a board's one-argument console WRITE-BYTE can
          ;; be the definition that wins in an image (CLAUDE.md).
          (let ((mb (make-array (length m) :element-type '(unsigned-byte 8))))
            (dotimes (k (length m)) (setf (aref mb k) (char-code (char m k))))
            (write-sequence mb o))
          (write-sequence b o)))
      t)))

(defun %fasl-compiled-fx (path)
  "PATH is a compiled fasl: the load loop's FX for it -- a replay, or (another
   compiler's fasl) its text loaded as source through the cache.  Else NIL."
  (let ((m (%fasl-magic)))
    (ignore-errors
     (with-open-file (i path :element-type '(unsigned-byte 8) :if-does-not-exist nil)
       (when i
         (let ((n (file-length i)) (k (length m)))
           (when (> n k)
             (let ((b (make-array n :element-type '(unsigned-byte 8))))
               (when (and (eql (read-sequence b i :end k) k)
                          (dotimes (j k t)
                            (unless (eql (aref b j) (char-code (char m j))) (return nil)))
                          (eql (read-sequence b i :start k) n))
                 (let ((rec (%fasl-dec (cons b k) (list nil))))
                   (when (and (consp rec) (eq (car rec) :modus-compiled-fasl))
                     (let ((text (%fasl-text-unpack (nth 3 rec))))
                       (if (equal (nth 2 rec) (%fasl-compiler-fingerprint))
                           (progn (%fasl-stat 0)
                                  (list :replay (concatenate 'string "compiled-" (%fasl-hash-string text))
                                        text 0 nil (nth 4 rec) t))
                           (or (%fasl-open text)
                               (list :plain nil text 0 nil nil t)))))))))))))))
