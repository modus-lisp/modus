(defasm get-fp (:mov x0 x29) (:ret))
(defstring s-bt "macho-e2e: wait on a page-0 address; return addresses:")
(defun impl-c-os-sync-wait (ua v sz fl)
  (when (u< ua 4096)                     ; a wait nothing can wake: say from where
    (say (addr s-bt))
    (let ((fp (get-fp)) (n 0))
      (while (and (< n 40) (u>= fp 4096))
        (say (addr s-sp)) (say-hex (ld64 fp 8))
        (setq fp (ld64 fp)) (setq n (+ n 1))))
    (say (addr s-nl)))
  (let ((r (sys 98 ua 128 v 0)))
    (if (= r -11) 0 (lin r))))
(defun impl-c-os-sync-wait-timeout (ua v sz fl clk ns)
  (with-buffers ((ts 16))
    (st64 ts (udiv ns 1000000000)) (st64 ts (urem ns 1000000000) 8)
    (let ((r (sys 98 ua 128 v ts)))
      (if (= r -11) 0 (lin r)))))
(defun impl-c-os-sync-wake-any (ua sz fl) (if (> (sys 98 ua 129 1) 0) 0 (progn (st32 (addr e-errno) 2) -1)))
(defun impl-c-os-sync-wake-all (ua sz fl) (if (> (sys 98 ua 129 #x7FFFFFFF) 0) 0 (progn (st32 (addr e-errno) 2) -1)))
