                                 WHEN (OR (EQUAL "" S2) (NOT (EQUAL "" S1)))
                                 COLLECT (LIST X S1 S2))) 'NIL) (t (c) (%test-crash-fail-c 25986 c)))
  (handler-case (run-test 25987 (lambda () (LOOP FOR X IN *UNIVERSE*
                                 FOR (S1 S2) = (MULTIPLE-VALUE-LIST
