(defun fa (x y) (list (+ x y) (- x y) (* x y) (/ x y) (sqrt (abs x)) (< x y) (= x y) (> x y) (float (round x) 1d0)))
(defun fs (x y) (declare (single-float x y)) (list (+ x y) (- x y) (* x y) (/ x y) (coerce x 'double-float)))
(defun ft (a) (let ((s 0d0)) (dotimes (i (length a) s) (setq s (+ s (* (aref a i) 1.5d0))))))
(defun fv (n) (let ((v (make-array n :element-type 'single-float :initial-element 0.0))) (dotimes (i n) (setf (aref v i) (* 0.5 i))) (let ((s 0.0)) (dotimes (i n s) (incf s (aref v i))))))
(defun fm (n) (let ((x 0d0) (y 0d0) (k 0)) (declare (double-float x y)) (loop while (and (< k n) (< (+ (* x x) (* y y)) 4d0)) do (psetq x (+ (- (* x x) (* y y)) -0.5d0) y (+ (* 2d0 x y) 0.25d0)) (incf k)) (list k x y)))
(dotimes (i 200) (fa 1.5d0 2.25d0) (fs 1.5 2.25) (ft #(1d0 2d0)) (fv 10) (fm 50))
(print (list :fa (fa 1.5d0 2.25d0) (fa -3d0 0.5d0) (fa 1d300 1d-300)))
(print (list :fs (fs 1.5 2.25) (fs 3.0 -7.0)))
(print (list :ft (ft (vector 1d0 2d0 3.5d0)) :fv (fv 1000) :fm (fm 100)))
(print (list :mixed (+ 1 2.5d0) (* 3 0.1d0) (float 7) (/ 1d0 3) (expt 2d0 0.5) (exp 1d0) (log 10d0) (sin 1d0)))
(print (list :edge (/ 1d0 0d0) (- (/ 1d0 0d0)) (handler-case (/ 0d0 0d0) (error () :nan-err)) most-positive-double-float least-positive-double-float -0d0 (* -1d0 0d0)))
(print (list :cmp (< 1d0 2d0) (< 2d0 1d0) (= 1d0 1d0) (eql 0d0 -0d0) (= 0d0 -0d0) (max 1d0 2d0 -3d0) (min 1.5 0.5)))
(print (list :fmt (format nil "~,3F ~E ~A" pi 12345.678d0 1.1)))
