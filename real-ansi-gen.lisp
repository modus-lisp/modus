(DEFMACRO DEF-OPEN-OUTPUT-TEST
          (NAME ARGS FORM EXPECTED
           &REST KEYARGS
           &KEY (ELEMENT-TYPE 'CHARACTER)
           (BUILD-FORM
            `(DOTIMES (I 10)
              ,(COND
                ((SUBTYPEP ELEMENT-TYPE 'INTEGER)
                 `(WRITE-BYTE
                   (FUNCALL
                    (THE FUNCTION (GENERATOR-FOR-ELEMENT-TYPE ',ELEMENT-TYPE))
                    I)
                   S))
                ((SUBTYPEP ELEMENT-TYPE 'CHARACTER)
                 `(WRITE-CHAR
