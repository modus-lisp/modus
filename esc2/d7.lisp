(defun say (k v) (princ (concatenate (quote string) k "=" (princ-to-string v))) (terpri) (finish-output))
(defun hx (n) (format nil "~X" n))
(defun rd32 (a) (mem-ref a :u32))
(defun wr32 (a v) (setf (mem-ref a :u32) v))
(defun badread (n) (mem-ref n :u64))
(defun fslots ()
  (list :rip (concatenate (quote string) (hx (rd32 #x10000C34)) "_" (hx (rd32 #x10000C30)))
        :rsp (concatenate (quote string) (hx (rd32 #x10000C3C)) "_" (hx (rd32 #x10000C38)))
        :site (concatenate (quote string) (hx (rd32 #x10000C44)) "_" (hx (rd32 #x10000C40)))
        :rax (concatenate (quote string) (hx (rd32 #x10000C4C)) "_" (hx (rd32 #x10000C48)))
        :addr (concatenate (quote string) (hx (rd32 #x10000C54)) "_" (hx (rd32 #x10000C50)))))
(defun fclear () (wr32 #x10000C30 0) (wr32 #x10000C34 0) (wr32 #x10000C38 0) (wr32 #x10000C3C 0)
  (wr32 #x10000C40 0) (wr32 #x10000C44 0) (wr32 #x10000C48 0) (wr32 #x10000C4C 0)
  (wr32 #x10000C50 0) (wr32 #x10000C54 0) 0)
(fclear)
(say "SEGV" (handler-case (badread (* 2 #x60000000000)) (t (c) (list :ERR c))))
(say "f" (fslots))
(say "END" "ok")
