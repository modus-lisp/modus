(DEFMACRO DEF-OPEN-PROBE-TEST
          (NAME ARGS FORM
           &KEY (BUILD-FORM NIL BUILD-FORM-P) (PATHNAME "tmp.dat"))
  (UNLESS BUILD-FORM-P
    (SETF BUILD-FORM
            `(LET ((S (OPEN PN :DIRECTION :OUTPUT :IF-EXISTS :SUPERSEDE)))
               (WHEN S
                 (LET ((%WOF-RESULT (PROGN)))
                   (CLOSE S)
                   %WOF-RESULT)))))
  `(DEFTEST ,NAME
    (LET ((PN ,PATHNAME))
      (DELETE-ALL-VERSIONS PN)
      ,BUILD-FORM
      (LET ((S (OPEN PN :DIRECTION :PROBE ,@ARGS)))
        (VALUES
         ,(IF BUILD-FORM
              `(AND (TYPEP S 'FILE-STREAM) (NOT (OPEN-STREAM-P S)))
              `(NOT S))
         ,FORM)))
    T T))
