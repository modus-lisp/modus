;;;; bulk-test.lisp -- REPLACE / FILL against a reference, then timings.
;;;; Portable CL: run it under SBCL to check the test, under modus to check modus.
(defvar *fails* 0)
(defvar *checks* 0)
(defvar *seed* 12345)
(defun rnd (n) (setq *seed* (mod (+ (* *seed* 1103515245) 12345) 2147483648)) (mod (ash *seed* -8) n))
(defun note (name ok)
  (incf *checks*)
  (unless ok (incf *fails*) (when (< *fails* 20) (format t "FAIL ~A~%" name))))
(defun mk (kind n)
  (case kind
    (:words (let ((v (make-array n))) (dotimes (i n v) (setf (aref v i) (case (rnd 4) (0 i) (1 (list i)) (2 (format nil "s~D" i)) (t (- i)))))))
    (:bytes (let ((v (make-array n :element-type '(unsigned-byte 8)))) (dotimes (i n v) (setf (aref v i) (rnd 256)))))
    (:string (let ((v (make-string n))) (dotimes (i n v) (setf (char v i) (code-char (+ 97 (rnd 26)))))))))
(defun cp (v) (let ((w (copy-seq v))) w))
(defun ref-replace (d s s1 e1 s2 e2)
  (let* ((n (min (- e1 s1) (- e2 s2))) (tmp (loop for k below n collect (aref s (+ s2 k)))))
    (loop for k below n for x in tmp do (setf (aref d (+ s1 k)) x)) d))
(defun same (a b) (and (= (length a) (length b)) (every #'eql a b)))
(defun one-replace (kind n samep)
  (let* ((d (mk kind n)) (s (if samep d (mk kind n)))
         (s1 (rnd (1+ n))) (e1 (+ s1 (rnd (1+ (- n s1)))))
         (s2 (rnd (1+ n))) (e2 (+ s2 (rnd (1+ (- n s2)))))
         (rd (cp d)) (rs (if samep rd (cp s))))
    (ref-replace rd rs s1 e1 s2 e2)
    (replace d s :start1 s1 :end1 e1 :start2 s2 :end2 e2)
    (note (format nil "replace ~A n=~D same=~A ~D-~D <- ~D-~D" kind n samep s1 e1 s2 e2) (same d rd))
    (unless samep (note (format nil "replace src intact ~A" kind) (same s rs)))))
(defun one-fill (kind n)
  (let* ((v (mk kind n)) (s (rnd (1+ n))) (e (+ s (rnd (1+ (- n s)))))
         (item (case kind (:words (if (zerop (rnd 2)) (list 'x) (rnd 1000))) (:bytes (if (zerop (rnd 3)) 0 (rnd 256))) (:string #\Q)))
         (r (cp v)))
    (loop for i from s below e do (setf (aref r i) item))
    (fill v item :start s :end e)
    (note (format nil "fill ~A n=~D ~D-~D ~S" kind n s e item) (same v r))))
(dolist (kind '(:words :bytes :string))
  (dotimes (n 40) (dotimes (k 12) (one-replace kind n nil) (one-replace kind n t) (one-fill kind n)))
  (dolist (n '(255 256 257 1000 4099)) (dotimes (k 20) (one-replace kind n nil) (one-replace kind n t) (one-fill kind n))))
;; whole-vector defaults and an overlapping shift each way
(let ((v (mk :words 100)) (r nil)) (setq r (cp v)) (replace v v :start1 1) (ref-replace r (cp r) 1 100 0 100) (note "shift up words" (same v r)))
(let ((v (mk :bytes 100)) (r nil)) (setq r (cp v)) (replace v v :start2 1) (ref-replace r (cp r) 0 100 1 100) (note "shift down bytes" (same v r)))
;; an END past the length must not be filled silently past the vector
(note "fill end>len signals"
      (handler-case (let ((v (make-array 5 :initial-element 0))) (fill v 1 :end 9) nil) (error () t)))
(format t "BULK-TEST checks=~D fails=~D~%" *checks* *fails*)
;; timings (ns per element; GET-INTERNAL-REAL-TIME units)
(defun ns-per (thunk elems reps)
  (let ((t0 (get-internal-real-time)))
    (dotimes (i reps) (funcall thunk))
    (/ (* 1e9 (- (get-internal-real-time) t0)) (* internal-time-units-per-second elems reps))))
(let ((a (make-array 40000 :initial-element 0)) (b (make-array 40000 :initial-element 5))
      (u (make-array 40000 :element-type '(unsigned-byte 8))) (w (make-array 40000 :element-type '(unsigned-byte 8))))
  (format t "TIME fill-words ~,2F ns  replace-words ~,2F ns  fill-u8 ~,2F ns  replace-u8 ~,2F ns  fill-rows ~,2F ns~%"
          (ns-per (lambda () (fill a 7)) 40000 50)
          (ns-per (lambda () (replace a b)) 40000 50)
          (ns-per (lambda () (fill u 9)) 40000 50)
          (ns-per (lambda () (replace u w)) 40000 50)
          (ns-per (lambda () (dotimes (r 150) (fill a 3 :start (* r 266) :end (+ (* r 266) 266)))) 39900 50)))
