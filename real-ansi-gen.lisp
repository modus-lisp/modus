                                                          (IF MINCOL
                                                              (FORMAT NIL
                                                                      "~~~d,"
                                                                      MINCOL)
                                                              "~,")
                                                          (IF PADCHAR
                                                              (FORMAT NIL
                                                                      "'~c,"
                                                                      PADCHAR)
                                                              ",")
                                                          (IF COMMACHAR
