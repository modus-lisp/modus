  (puthash 184469789 *macro-table* (LAMBDA (FORM)
                                     (LET* ((TEST (CADR FORM))
                                            (TAIL (CDDR FORM))
                                            (PLACES
                                             (IF (AND (CONSP TAIL)
                                                      (LISTP (CAR TAIL)))
                                                 (CAR TAIL)
                                                 NIL))
                                            (DATUM-ARGS
                                             (IF (CONSP TAIL)
                                                 (CDR TAIL)
                                                 NIL))
                                            (RV (%MVM-GENSYM "ASSERTR"))
                                            (SV (%MVM-GENSYM "ASSERTV"))
                                            (ERR-FORM
                                             (IF DATUM-ARGS
                                                 `(ERROR ,@DATUM-ARGS)
                                                 `(ERROR "Assertion failed: ~S"
                                                         ',TEST))))
                                       (IF (NULL PLACES)
                                           `(LOOP (WHEN ,TEST (RETURN NIL))
                                                  (RESTART-CASE ,ERR-FORM
                                                    (CONTINUE NIL NIL)))
                                           (LET ((CLAUSES NIL)
                                                 (DISPATCH NIL)
                                                 (I 0)
                                                 (PS PLACES))
                                             (LOOP
                                              (WHEN (NULL PS) (RETURN NIL))
                                              (PUSH
                                               `(STORE-VALUE (,SV)
                                                             (LIST ,I ,SV))
                                               CLAUSES)
                                              (PUSH
                                               `((EQL (CAR ,RV) ,I)
                                                 (SETF ,(CAR PS) (CADR ,RV)))
                                               DISPATCH)
                                              (SETQ I (+ I 1))
                                              (SETQ PS (CDR PS)))
                                             `(LOOP (WHEN ,TEST (RETURN NIL))
                                                    (LET ((,RV
                                                           (RESTART-CASE ,ERR-FORM
                                                             (CONTINUE NIL NIL)
                                                             ,@(NREVERSE
                                                                CLAUSES))))
                                                      (WHEN (CONSP ,RV)
                                                        (COND
                                                         ,@(NREVERSE DISPATCH)
                                                         (T NIL)))
                                                      NIL)))))))
