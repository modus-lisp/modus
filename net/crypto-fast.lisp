           (setq f1 (%w32 (w32-hi16 (w32-ref w-r1)))) (setq g1 (%w32 (w32-lo16 (w32-ref w-r1))))
           (setq f2 (%w32 (w32-hi16 (w32-ref w-r2)))) (setq g2 (%w32 (w32-lo16 (w32-ref w-r2))))
           (setq f3 (%w32 (w32-hi16 (w32-ref w-r3)))) (setq g3 (%w32 (w32-lo16 (w32-ref w-r3))))
           (setq f4 (%w32 (w32-hi16 (w32-ref w-r4)))) (setq g4 (%w32 (w32-lo16 (w32-ref w-r4))))
           (setq f5 (%w32 (w32-hi16 (w32-ref w-r5)))) (setq g5 (%w32 (w32-lo16 (w32-ref w-r5))))
           (setq f6 (%w32 (w32-hi16 (w32-ref w-r6)))) (setq g6 (%w32 (w32-lo16 (w32-ref w-r6))))
           (setq f7 (%w32 (w32-hi16 (w32-ref w-r7)))) (setq g7 (%w32 (w32-lo16 (w32-ref w-r7))))
           (setq f8 (%w32 (w32-hi16 (w32-ref w-r8)))) (setq g8 (%w32 (w32-lo16 (w32-ref w-r8))))
           (setq f9 (%w32 (w32-hi16 (w32-ref w-r9)))) (setq g9 (%w32 (w32-lo16 (w32-ref w-r9))))
