;; === copy-symbol.lsp ===
(IN-PACKAGE "CL-TEST")
(defun run-init-copy-symbol ()
  (handler-case (IN-PACKAGE "CL-TEST") (t (c) nil))
)
(defun run-ansi-copy-symbol-chunk-1 ()
  (handler-case (run-test 15563 (lambda () (NOTNOT-MV
                            (EVERY
                             #'(LAMBDA (X)
                                 (LET ((Y (COPY-SYMBOL X)))
                                   (AND (NULL (SYMBOL-PLIST Y)) (SYMBOLP Y)
                                        (NOT (BOUNDP Y)) (NOT (FBOUNDP Y))
                                        (NULL (SYMBOL-PACKAGE Y))
                                        (STRING= (SYMBOL-NAME X)
                                                 (SYMBOL-NAME Y))
                                        (SYMBOLP (COPY-SYMBOL Y)))))
                             '(NIL T A B |a| |123|)))) 'T) (t (c) (%test-crash-fail-c 15563 c)))
  (handler-case (run-test 15564 (lambda () (PROGN
                            (SET-SYMBOL-PLIST '|foo| '(A B C D))
                            (MAKUNBOUND '|foo|)
                            (NOTNOT-MV
                             (EVERY
                              #'(LAMBDA (X)
                                  (LET ((Y (COPY-SYMBOL X T)))
                                    (AND
                                     (EQUAL (SYMBOL-PLIST Y) (SYMBOL-PLIST X))
                                     (SYMBOLP Y)
                                     (IF (BOUNDP X)
                                         (BOUNDP Y)
                                         (NOT (BOUNDP Y)))
                                     (IF (FBOUNDP X)
                                         (FBOUNDP Y)
                                         (NOT (FBOUNDP Y)))
                                     (NULL (SYMBOL-PACKAGE Y))
                                     (STRING= (SYMBOL-NAME X)
                                              (SYMBOL-NAME Y)))))
                              '(NIL T A B |foo| |a| |123|))))) 'T) (t (c) (%test-crash-fail-c 15564 c)))
  (handler-case (run-test 15565 (lambda () (PROGN
                            (SET-SYMBOL-PLIST '|foo| '(A B C D))
                            (SETF (SYMBOL-VALUE '|a|) 12345)
                            (NOTNOT-MV
                             (EVERY
                              #'(LAMBDA (X)
                                  (LET ((Y (COPY-SYMBOL X T)))
                                    (AND
                                     (EQL (LENGTH (SYMBOL-PLIST Y))
                                          (LENGTH (SYMBOL-PLIST X)))
                                     (EVERY #'EQ (SYMBOL-PLIST Y)
                                            (SYMBOL-PLIST X))
                                     (SYMBOLP Y)
                                     (IF (BOUNDP X)
                                         (EQT (SYMBOL-VALUE X)
                                          (SYMBOL-VALUE Y))
                                         (NOT (BOUNDP Y)))
                                     (IF (FBOUNDP X)
                                         (FBOUNDP Y)
                                         (NOT (FBOUNDP Y)))
                                     (NULL (SYMBOL-PACKAGE Y))
                                     (STRING= (SYMBOL-NAME X) (SYMBOL-NAME Y))
                                     (EQL (LENGTH (SYMBOL-PLIST X))
                                          (LENGTH (SYMBOL-PLIST Y))))))
                              '(NIL T A B |foo| |a| |123|))))) 'T) (t (c) (%test-crash-fail-c 15565 c)))
  (handler-case (run-test 15566 (lambda () (EQT (COPY-SYMBOL 'A) (COPY-SYMBOL 'A))) 'NIL) (t (c) (%test-crash-fail-c 15566 c)))
  (handler-case (run-test-mv 15567 (lambda () (multiple-value-list (LET ((I 0) X Y (S '#:|x|))
                                                     (LET ((S2
                                                            (COPY-SYMBOL
                                                             (PROGN
                                                              (SETF X (INCF I))
                                                              S)
                                                             (PROGN
                                                              (SETF Y (INCF I))
                                                              NIL))))
                                                       (VALUES (SYMBOL-NAME S2)
                                                               (EQ S S2) I X
                                                               Y))))) '("x" NIL
                                                                        2 1 2)) (t (c) (%test-crash-fail-c 15567 c)))
  (handler-case (run-test 15568 (lambda () (HANDLER-CASE (PROGN (COPY-SYMBOL) NIL)
                                         (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 15568 c)))
  (handler-case (run-test 15569 (lambda () (HANDLER-CASE (PROGN (COPY-SYMBOL 'A T 'FOO) NIL)
                                         (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 15569 c)))
)
(defun run-ansi-copy-symbol ()
  (handler-case (IN-PACKAGE "CL-TEST") (t (c) nil))
  (%try-chunk "copy-symbol" 11295425 1 #'run-ansi-copy-symbol-chunk-1)
)

