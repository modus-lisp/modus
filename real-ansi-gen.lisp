;; === describe.lsp ===
(DEFUN HARNESS-FOR-DESCRIBE (FN)
  (LET (S1 S2)
    (LET ((*STANDARD-OUTPUT* (MAKE-STRING-OUTPUT-STREAM)))
      (DECLARE (SPECIAL *STANDARD-OUTPUT*))
      (LET ((%WOS-RESULT
             (PROGN
              (LET ((TIO-INPUT (MAKE-STRING-INPUT-STREAM "X")))
                (LET ((%WOS-RESULT
                       (PROGN
                        (LET ((TIO-OUTPUT (MAKE-STRING-OUTPUT-STREAM)))
                          (LET ((%WOS-RESULT
                                 (PROGN
                                  (LET ((*TERMINAL-IO*
                                         (MAKE-TWO-WAY-STREAM TIO-INPUT
                                                              TIO-OUTPUT)))
                                    (DECLARE (SPECIAL *TERMINAL-IO*))
                                    (LET ((%WOS-RESULT
                                           (PROGN
                                            (LET ((*PRINT-CIRCLE* T)
                                                  (*PRINT-READABLY* NIL))
                                              (DECLARE
                                               (SPECIAL *PRINT-CIRCLE*
                                                *PRINT-READABLY*))
                                              (ASSERT
                                               (NULL
                                                (MULTIPLE-VALUE-LIST
                                                 (FUNCALL FN))))))))
                                      (CLOSE *TERMINAL-IO*)
                                      %WOS-RESULT))
                                  (SETQ S2
                                          (GET-OUTPUT-STREAM-STRING
                                           TIO-OUTPUT)))))
                            (CLOSE TIO-OUTPUT)
                            %WOS-RESULT))
                        (ASSERT (EQUAL (READ-CHAR TIO-INPUT) #\X)))))
                  (CLOSE TIO-INPUT)
                  %WOS-RESULT))
              (SETQ S1 (GET-OUTPUT-STREAM-STRING *STANDARD-OUTPUT*)))))
        (CLOSE *STANDARD-OUTPUT*)
        %WOS-RESULT))
    (VALUES S1 S2)))
(DEFSKIP DESCRIBE.5)
(defun run-init-describe ()
  nil
)
(defun run-ansi-describe-chunk-1 ()
  (handler-case (run-test 25984 (lambda () (LOOP FOR X IN *UNIVERSE*
                                 FOR (S1 S2) = (MULTIPLE-VALUE-LIST
                                                (HARNESS-FOR-DESCRIBE
                                                 #'(LAMBDA () (DESCRIBE X))))
                                 WHEN (AND (EQUAL S1 "") (EQUAL S2 ""))
                                 COLLECT X)) 'NIL) (t (c) (%test-crash-fail-c 25984 c)))
  (handler-case (run-test 25985 (lambda () (LOOP FOR X IN *UNIVERSE*
                                 FOR S1 = NIL
