;;;; word-boundary.lisp -- integer ops at the machine-word boundaries.
;;;;
;;;; Run: ./modus --script test/word-boundary.lisp   (any CLI: x64, i386, RV32)
;;;;
;;;; Each op is evaluated through mvm-eval on operands around 2^29, 2^30 and
;;;; 2^31: fixnum-sized on the 62-bit tower, the WORD EDGE on the 30-bit one,
;;;; where a fixnum's machine word no longer fits a Lisp fixnum.  EXPECTED
;;;; values were generated by SBCL.  Every case binds x to a LITERAL so the
;;;; compiler knows its width and takes the typed fast paths -- through a
;;;; lambda parameter the width is unknown and the guarded path hid the bug.  Before the
;;;; interpreter's word ops became exact (interp.lisp, %%MVM-WORD), a 30-bit
;;;; port got (ash 16388 16), (ash x 30) and every tag test on a fixnum >= 2^29
;;;; wrong.
;;;;
;;;; ONE TOP-LEVEL FORM PER OP, not per case: i386 --script dies at its first
;;;; collection during a long script (pre-existing, open), and 624 top-level
;;;; forms allocate enough to reach it.

(defvar *wb-fail* 0)
(defvar *wb-n* 0)
(defun wb-same (got want)
  ;; = for numbers: -2^fixnum-bits is a machine word but the runtime keeps it a
  ;; BIGNUM (most-negative-fixnum is never a fixnum), while raw ops such as
  ;; (logand x -2) produce it as a raw word, natively as well as interpreted.
  (if (and (numberp got) (numberp want)) (= got want) (equal got want)))
(defun wb (name gots xs wants)
  (loop for x in xs for want in wants for got in gots
        do (progn
             (setq *wb-n* (+ *wb-n* 1))
             (unless (wb-same got want)
               (setq *wb-fail* (+ *wb-fail* 1))
               (format t "~&FAIL ~S x=~S got ~S want ~S~%%" name x got want)))))
