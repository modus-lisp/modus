                                              (HARNESS-FOR-DESCRIBE
                                               #'(LAMBDA () (DESCRIBE X S))))
                                            (GET-OUTPUT-STREAM-STRING S))
                                 WHEN (OR (EQUAL S3 "") (NOT (EQUAL "" S2))
                                          (NOT (EQUAL "" S1)))
                                 COLLECT (LIST X S1 S2 S3))) 'NIL) (t (c) (%test-crash-fail-c 25985 c)))
  (handler-case (run-test 25986 (lambda () (LOOP FOR X IN *UNIVERSE*
