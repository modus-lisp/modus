;;;; test/gc-straddle-natrium.lisp -- driven by test/run-gc-straddle-natrium.sh; see there.
(let ((offs (sb-ext:posix-getenv "CG_OFF")))
  (when (and offs (> (length offs) 0))
    (let ((start 0))
      (loop (let ((c (position #\, offs :start start)))
              (setf (symbol-value (intern (subseq offs start c))) :off)
              (if c (setq start (+ c 1)) (return)))))))
(require :asdf)
(push (pathname (concatenate 'string (sb-ext:posix-getenv "NATRIUM_DIR") "/")) asdf:*central-registry*)
(asdf:load-system "natrium/test")
(defvar *det-state* 7)
(defun det-entropy (n)
  (let ((v (make-array n :element-type '(unsigned-byte 8) :initial-element 0)))
    (dotimes (i n v)
      (setq *det-state* (mod (+ (* *det-state* 6364136223846793005) 1442695040888963407) 18446744073709551616))
      (setf (aref v i) (ldb (byte 8 56) *det-state*)))))
(setq natrium::*os-entropy* (function det-entropy))
(setq natrium::*default-drbg* nil)
(format t "~&RUNALL-RESULT ~a~%" (handler-case (progn (jit-eager '(natrium.test::run-all)) :ok) (error (e) (list :error (type-of e)))))
(format t "~&WP-RESULT ~a~%" (handler-case (progn (jit-eager '(natrium.test::run-wycheproof)) :ok) (error (e) (list :error (type-of e)))))
