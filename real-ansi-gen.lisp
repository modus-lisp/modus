(DEFUN PRINC.SYMBOL.FN (SYM CASE *PRINT-CASE* EXPECTED)
  (%SET-READTABLE-CASE *READTABLE* CASE)
  (LET ((STR
         (LET ((S (MAKE-STRING-OUTPUT-STREAM)))
