                    I)
                   S)))))
           &ALLOW-OTHER-KEYS)
  `(DEF-OPEN-TEST ,NAME (:DIRECTION :OUTPUT ,@ARGS)
                  (PROGN ,BUILD-FORM (ASSERT (OUTPUT-STREAM-P S)) ,FORM)
                  ,EXPECTED :BUILD-FORM NIL ,@KEYARGS))
