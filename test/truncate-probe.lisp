;;; truncate-probe.lisp -- TRUNCATE's contract, against SBCL.
(defun p (l v) (format t "~a ~s~%" l v))
(dolist (c '((100 7) (-100 7) (100 -7) (-100 -7) (7 100) (0 7) (14 1) (1 14)
             (1000000000000 7) (4611686018427387903 3) (-4611686018427387904 3)))
  (format t "t2 ~a ~a -> ~s~%" (first c) (second c)
          (multiple-value-list (truncate (first c) (second c)))))
(p "1arg-int"    (multiple-value-list (truncate 100)))
(p "1arg-neg"    (multiple-value-list (truncate -100)))
(p "1arg-ratio"  (multiple-value-list (truncate 79/10)))
(p "1arg-nratio" (multiple-value-list (truncate -79/10)))
(p "ratio2"      (multiple-value-list (truncate 7/2 1/2)))
(p "bignum"      (multiple-value-list (truncate (* 123456789 987654321) 1000)))
(p "big-by-big"  (multiple-value-list (truncate (* 123456789 987654321) (* 12345 54321))))
(p "float1"      (multiple-value-list (truncate 5.5)))
(p "float2"      (multiple-value-list (truncate 100.0 7.0)))
(p "mixed"       (multiple-value-list (truncate 100 7.0)))
(p "floor-check" (multiple-value-list (floor -100 7)))
(p "rem-check"   (rem -100 7))
(p "mod-check"   (mod -100 7))
(p "round-check" (multiple-value-list (round 100 7)))
(p "ceil-check"  (multiple-value-list (ceiling 100 7)))
