                             (LOOP FOR MINCOL = (AND (COIN) (RANDOM 50))
                                   FOR PADCHAR = (AND (COIN)
                                                      (RANDOM-FROM-SEQ
                                                       +STANDARD-CHARS+))
                                   FOR COMMACHAR = (AND (COIN)
                                                        (RANDOM-FROM-SEQ
                                                         +STANDARD-CHARS+))
                                   FOR COMMAINT = (AND (COIN) (1+ (RANDOM 10)))
                                   FOR K = (ASH 1 (+ 2 (RANDOM 30)))
                                   FOR X = (- (RANDOM (+ K K)) K)
