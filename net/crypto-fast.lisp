           (setq w-g1 (%w32 (w32-raw (w32-from-fix g1))))
           (setq w-g2 (%w32 (w32-raw (w32-from-fix g2))))
           (setq w-g3 (%w32 (w32-raw (w32-from-fix g3))))
           (setq w-g4 (%w32 (w32-raw (w32-from-fix g4))))
           (setq w-g5 (%w32 (w32-raw (w32-from-fix g5))))
           (setq w-g6 (%w32 (w32-raw (w32-from-fix g6))))
           (setq w-g7 (%w32 (w32-raw (w32-from-fix g7))))
           (setq w-g8 (%w32 (w32-raw (w32-from-fix g8))))
           (setq w-g9 (%w32 (w32-raw (w32-from-fix g9))))
           (setq w-g1-19 (%w32 (w32-raw (w32-mul (w32-li 19) (w32-ref w-g1)))))
           (setq w-g2-19 (%w32 (w32-raw (w32-mul (w32-li 19) (w32-ref w-g2)))))
           (setq w-g3-19 (%w32 (w32-raw (w32-mul (w32-li 19) (w32-ref w-g3)))))
           (setq w-g4-19 (%w32 (w32-raw (w32-mul (w32-li 19) (w32-ref w-g4)))))
           (setq w-g5-19 (%w32 (w32-raw (w32-mul (w32-li 19) (w32-ref w-g5)))))
           (setq w-g6-19 (%w32 (w32-raw (w32-mul (w32-li 19) (w32-ref w-g6)))))
           (setq w-g7-19 (%w32 (w32-raw (w32-mul (w32-li 19) (w32-ref w-g7)))))
           (setq w-g8-19 (%w32 (w32-raw (w32-mul (w32-li 19) (w32-ref w-g8)))))
