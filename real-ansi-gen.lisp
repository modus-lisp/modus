
;; === acons.lsp ===
(defun run-init-acons ()
  nil
)
(defun run-ansi-acons-chunk-1 ()
  (handler-case (run-test 10001 (lambda () (LET* ((X (COPY-TREE '((C . D) (E . F))))
                                  (XCOPY (MAKE-SCAFFOLD-COPY X))
                                  (RESULT (ACONS 'A 'B X)))
                             (AND (CHECK-SCAFFOLD-COPY X XCOPY)
                                  (EQT (CDR RESULT) X) RESULT))) '((A . B)
                                                                   (C . D)
                                                                   (E . F))) (t (c) (%test-crash-fail-c 10001 c)))
  (handler-case (run-test 10002 (lambda () (ACONS 'A 'B NIL)) '((A . B))) (t (c) (%test-crash-fail-c 10002 c)))
  (handler-case (run-test 10003 (lambda () (ACONS 'A 'B 'C)) '((A . B) . C)) (t (c) (%test-crash-fail-c 10003 c)))
  (handler-case (run-test 10004 (lambda () (ACONS '((A B)) '(((C D) E) F) '((1 . 2)))) '((((A
                                                                            B))
                                                                          ((C
                                                                            D)
                                                                           E)
                                                                          F)
                                                                         (1
                                                                          . 2))) (t (c) (%test-crash-fail-c 10004 c)))
  (handler-case (run-test 10005 (lambda () (ACONS "ancd" 1.143 NIL)) '(("ancd" . 1.143))) (t (c) (%test-crash-fail-c 10005 c)))
  (handler-case (run-test 10006 (lambda () (ACONS #\R :FOO :BAR)) '((#\R . :FOO) . :BAR)) (t (c) (%test-crash-fail-c 10006 c)))
  (handler-case (run-test 10007 (lambda () (MACROLET ((%M (Z)
                                        Z))
                             (ACONS 'A 'B '(C)))) '((A . B) C)) (t (c) (%test-crash-fail-c 10007 c)))
  (handler-case (run-test 10008 (lambda () (MACROLET ((%M (Z)
                                        Z))
                             (ACONS 'A 'B '(C)))) '((A . B) C)) (t (c) (%test-crash-fail-c 10008 c)))
)
(defun run-ansi-acons-chunk-2 ()
  (handler-case (run-test 10009 (lambda () (MACROLET ((%M (Z)
                                        Z))
                             (ACONS 'A 'B '(C)))) '((A . B) C)) (t (c) (%test-crash-fail-c 10009 c)))
  (handler-case (run-test-mv 10010 (lambda () (multiple-value-list (LET ((I 0) X Y Z)
                                                     (VALUES
                                                      (ACONS
                                                       (PROGN
                                                        (SETF X (INCF I))
                                                        'A)
                                                       (PROGN
                                                        (SETF Y (INCF I))
                                                        'B)
                                                       (PROGN
                                                        (SETF Z (INCF I))
                                                        '((C . D))))
                                                      I X Y Z)))) '(((A . B)
                                                                     (C . D))
                                                                    3 1 2 3)) (t (c) (%test-crash-fail-c 10010 c)))
  (handler-case (run-test 10011 (lambda () (HANDLER-CASE (PROGN (ACONS) NIL) (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 10011 c)))
  (handler-case (run-test 10012 (lambda () (HANDLER-CASE (PROGN (ACONS 'A) NIL) (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 10012 c)))
  (handler-case (run-test 10013 (lambda () (HANDLER-CASE (PROGN (ACONS 'A 'B) NIL)
                                         (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 10013 c)))
  (handler-case (run-test 10014 (lambda () (HANDLER-CASE (PROGN (ACONS 'A 'B 'C 'D) NIL)
                                         (ERROR (C) T))) 'T) (t (c) (%test-crash-fail-c 10014 c)))
)
(defun run-ansi-acons ()
  (%try-chunk "acons" 15828927 1 #'run-ansi-acons-chunk-1)
  (%try-chunk "acons" 15828927 2 #'run-ansi-acons-chunk-2)
)

