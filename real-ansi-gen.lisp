                     (IF (< 1 (LENGTH %MVB*-TMP))
                         (NTH 1 %MVB*-TMP)
                         NIL)))
                (AND (NULL SYM1) (NULL STATUS1)
                     (STRING= (SYMBOL-NAME SYM2) SNAME)
                     (EQT (SYMBOL-PACKAGE SYM2) P) (EQT STATUS2 :INTERNAL)
                     (PROGN (DELETE-PACKAGE P) T))))))))
    T))
