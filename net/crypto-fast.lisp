              (typep f8 'fixnum) (typep f9 'fixnum) (typep g0 'fixnum) (typep g1 'fixnum)
              (typep g2 'fixnum) (typep g3 'fixnum) (typep g4 'fixnum) (typep g5 'fixnum)
              (typep g6 'fixnum) (typep g7 'fixnum) (typep g8 'fixnum) (typep g9 'fixnum)
