(DEFMACRO DEF-READ-SEQUENCE-BV-TEST (NAME INIT ARGS &REST EXPECTED)
  `(DEFTEST ,NAME
    (PROGN
     (LET (OS)
       (UNWIND-PROTECT
           (PROGN
            (SETQ OS
                    (OPEN "temp.dat" :DIRECTION :OUTPUT :ELEMENT-TYPE
                          '(UNSIGNED-BYTE 8) :IF-EXISTS :SUPERSEDE))
            (LOOP FOR I IN '(0 1 1 0 0 1 1 0 1 0 1 1 1 0)
                  DO (WRITE-BYTE I OS)))
         (WHEN OS (CLOSE OS))))
     (LET (IS (BV (COPY-SEQ ,INIT)))
       (UNWIND-PROTECT
           (PROGN
            (SETQ IS
                    (OPEN "temp.dat" :DIRECTION :INPUT :ELEMENT-TYPE
                          '(UNSIGNED-BYTE 8)))
            (VALUES (READ-SEQUENCE BV IS ,@ARGS) BV))
         (WHEN IS (CLOSE IS)))))
    ,@EXPECTED))
