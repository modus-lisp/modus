(defun rde2 (path)
  (let* ((src (tar-bytes-to-string (%it-slurp-bytes path)))
         (n (length src))
         (s (make-string-input-stream src))
         (i 0) (p *package*))
    (princ "BEGIN ") (princ path) (terpri) (finish-output)
    (loop
      (let* ((pos (handler-case (file-position s) (t (c) -1))))
        (princ "  F") (princ i) (princ "@") (princ pos) (terpri) (finish-output)
        (let ((r (handler-case (read s nil :rd-eof)
                   (t (c) (list :RD-ERR (handler-case (type-of c) (t (c2) :UNKNOWN)))))))
          (when (eq r :rd-eof) (princ "  EOF") (terpri) (setq *package* p) (finish-output) (return :ok))
          (when (and (consp r) (eq (car r) :RD-ERR))
            (princ "   READFAIL cond=") (princ (cadr r)) (terpri)
            (princ "   CTX<<<") (princ (subseq src pos (min n (+ pos 200)))) (princ ">>>") (terpri)
            (setq *package* p) (finish-output) (return :readfail))
          (let ((e (handler-case (progn (eval r) nil)
                     (t (c) (handler-case (type-of c) (t (c2) :UNKNOWN))))))
            (when e (princ "   EVALERR ") (princ e) (terpri) (finish-output)))
          (setq i (+ i 1)))))))
