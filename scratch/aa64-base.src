(defun %init-runtime-macros-18 ()
  (puthash 140884724 *macro-table* (LAMBDA (FORM)
                                     (LET* ((NAME (CADR FORM))
                                            (PARENTS
                                             (OR (CADDR FORM) '(CONDITION)))
                                            (SLOT-SPECS (OR (CADDDR FORM) NIL))
                                            (OPTIONS (CDDDDR FORM))
                                            (PARSED-SLOTS
                                             (MAPCAR
                                              (LAMBDA (SPEC)
                                                (IF (ATOM SPEC)
                                                    (LIST SPEC NIL :NO-INITFORM
                                                          NIL)
                                                    (LET ((SNAME (CAR SPEC))
                                                          (OPTS (CDR SPEC))
                                                          (INITARGS NIL)
                                                          (INITFORM
                                                           :NO-INITFORM)
                                                          (READERS NIL))
                                                      (LOOP
                                                       (WHEN (NULL OPTS)
                                                         (RETURN))
                                                       (LET ((K (CAR OPTS))
                                                             (V (CADR OPTS)))
                                                         (COND
                                                          ((EQ K :INITARG)
                                                           (SETF INITARGS
                                                                   (APPEND
                                                                    INITARGS
                                                                    (LIST V))))
                                                          ((EQ K :INITFORM)
                                                           (SETF INITFORM V))
                                                          ((OR (EQ K :READER)
                                                               (EQ K
                                                                   :ACCESSOR))
                                                           (SETF READERS
                                                                   (APPEND
                                                                    READERS
                                                                    (LIST
                                                                     V)))))
                                                         (SETF OPTS
                                                                 (CDDR OPTS))))
                                                      (LIST SNAME INITARGS
                                                            INITFORM
                                                            READERS))))
                                              SLOT-SPECS))
                                            (SLOT-DESCRIPTORS
                                             (MAPCAR
                                              (LAMBDA (P)
                                                (LIST (FIRST P) (SECOND P)
                                                      (THIRD P)))
                                              PARSED-SLOTS))
                                            (FIND-OPT
                                             (LAMBDA (KEY)
                                               (LET ((FOUND NIL) (CUR OPTIONS))
                                                 (LOOP
                                                  (WHEN (NULL CUR)
                                                    (RETURN FOUND))
                                                  (LET ((O (CAR CUR)))
                                                    (WHEN
                                                        (AND (CONSP O)
                                                             (EQ (CAR O) KEY))
                                                      (SETQ FOUND (CDR O))
                                                      (RETURN FOUND)))
                                                  (SETQ CUR (CDR CUR))))))
                                            (DEFAULT-INITARGS-OPT
                                             (FUNCALL FIND-OPT
                                                      :DEFAULT-INITARGS))
                                            (REPORT-OPT
                                             (FUNCALL FIND-OPT :REPORT))
                                            (DEFAULT-INITARGS-ARG
                                             (IF DEFAULT-INITARGS-OPT
                                                 (LIST 'QUOTE
                                                       DEFAULT-INITARGS-OPT)
                                                 NIL))
                                            (REPORT-FN-ARG
                                             (COND ((NULL REPORT-OPT) NIL)
                                                   ((AND
                                                     (CONSP (CAR REPORT-OPT))
                                                     (EQ (CAAR REPORT-OPT)
                                                         'LAMBDA))
                                                    (LIST 'QUOTE
                                                          (CAR REPORT-OPT)))
                                                   ((SYMBOLP (CAR REPORT-OPT))
                                                    (LIST 'QUOTE
                                                          (CAR REPORT-OPT)))
                                                   ((STRINGP (CAR REPORT-OPT))
                                                    `(LAMBDA (C S)
                                                       (DECLARE (IGNORE C))
                                                       (WRITE-STRING
                                                        ,(CAR REPORT-OPT) S)))
                                                   (T NIL)))
                                            (DEF-CALL
                                             `(%DEFINE-CONDITION ',NAME
                                               ',PARENTS ',SLOT-DESCRIPTORS
                                               ,DEFAULT-INITARGS-ARG
                                               ,REPORT-FN-ARG))
                                            (READER-DEFUNS
                                             (LET ((ACC NIL))
                                               (DOLIST
                                                   (P PARSED-SLOTS
                                                      (NREVERSE ACC))
                                                 (LET ((SNAME (FIRST P))
                                                       (READERS (FOURTH P)))
                                                   (DOLIST (R READERS)
                                                     (PUSH
                                                      `(UNLESS
                                                           (%COND-INSTALL-READER
                                                            ',R ',NAME ',SNAME)
                                                         (DEFUN ,R (C)
                                                           (%CONDITION-SLOT C
                                                            ',SNAME)))
                                                      ACC)))))))
                                       `(PROGN ,DEF-CALL ,@READER-DEFUNS))))
