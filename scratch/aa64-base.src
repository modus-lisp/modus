                                    (LET ((KEYFORM (CADR FORM))
                                          (CLAUSES (CDDR FORM))
                                          (TMP (%MVM-GENSYM "ECASE")))
                                      `(LET ((,TMP ,KEYFORM))
                                         (COND
                                          ,@(LET ((OUT NIL))
                                              (DOLIST (CLAUSE CLAUSES)
                                                (LET* ((KEYS (CAR CLAUSE))
                                                       (BODY (CDR CLAUSE))
                                                       (EFFECTIVE-BODY
                                                        (OR BODY '(NIL))))
                                                  (COND ((NULL KEYS) NIL)
                                                        ((LISTP KEYS)
                                                         (PUSH
                                                          `((OR
                                                             ,@(MAPCAR
                                                                (LAMBDA (K)
                                                                  `(EQL ,TMP
                                                                        ',K))
                                                                KEYS))
                                                            ,@EFFECTIVE-BODY)
                                                          OUT))
                                                        (T
                                                         (PUSH
                                                          `((EQL ,TMP ',KEYS)
                                                            ,@EFFECTIVE-BODY)
                                                          OUT)))))
                                              (NREVERSE OUT))
                                          (T (%SIGNAL-TYPE-ERROR)))))))
  nil)
