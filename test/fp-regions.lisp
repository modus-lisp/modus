;;; FP regions (compiler.lisp %FP-REGION-REWRITE): a call-free loop inside a scope that has calls keeps the
;;; scope's float variables in FP registers, copying them in at its start and the assigned ones back at its
;;; end.  A call anywhere in a scope boxed every float local in it: cl-bench FFT's butterfly loop allocated a
;;; float per assignment.  Values checked on SBCL too; on modus the loop's disassembly shows it unboxed.
;;; Run: ./modus --script THIS
(defpackage :fp-regions-test (:use :cl))
(in-package :fp-regions-test)
(defvar *fails* 0)
(defvar *checks* 0)
(defmacro check (name form expect)
  `(let ((got (handler-case ,form (error () :error))))
     (incf *checks*)
     (unless (equalp got ,expect)
       (incf *fails*)
       (format t "FAIL ~a: got ~s want ~s~%" ,name got ,expect))))
(defvar *forms* (make-hash-table))
(defmacro defk (name args &body body)
  `(progn (setf (gethash ',name *forms*) '(lambda ,args ,@body)) (defun ,name ,args ,@body)))
(defun count-of (name what)
  #+modus (let ((s (with-output-to-string (*standard-output*) (disassemble (gethash name *forms*)))) (n 0) (p 0))
            (loop (let ((i (search what s :start2 p))) (unless i (return n)) (incf n) (setq p (1+ i)))))
  #-modus (progn name what 0))

;; the shape: floats bound at the top, a call (SIN) outside the loop, the loop assigns two and reads one
(defk accum (n)
  (declare (fixnum n))
  (let ((s 0.0) (p 1.0) (w (sin 0.5)))
    (declare (single-float s p w))
    (dotimes (i n) (setq s (+ s (* w p)) p (* p 0.5)))
    (list s p w (cos 0.0))))
(check "accum" (accum 10) (let ((s 0.0) (p 1.0) (w (sin 0.5))) (dotimes (i 10) (setq s (+ s (* w p)) p (* p 0.5))) (list s p w 1.0)))
(check "accum zero trips" (accum 0) (list 0.0 1.0 (sin 0.5) 1.0))
(defk dbl (n)
  (declare (fixnum n))
  (let ((x 1d0) (y 0d0) (k (sqrt 2d0)))
    (declare (double-float x y k))
    (do ((i 0 (1+ i))) ((>= i n)) (setq y (+ y (* x k)) x (/ x 2d0)))
    (list x y (exp 0d0))))
(check "double" (dbl 5) (let ((x 1d0) (y 0d0) (k (sqrt 2d0))) (dotimes (i 5) (setq y (+ y (* x k)) x (/ x 2d0))) (list x y 1d0)))
;; RETURN with a value from inside the region: the copies go back before the value is returned
(defk early (n)
  (declare (fixnum n))
  (let ((s 0.0) (c (sin 0.0)))
    (declare (single-float s c))
    (let ((r (dotimes (i n :done) (setq s (+ s 1.5 c)) (when (> s 4.0) (return :out)))))
      (list r s (sin 0.0)))))
(check "return from the region" (list (early 10) (early 2)) (list (list :out 4.5 0.0) (list :done 3.0 0.0)))
;; a GO out of the loop: the rewrite must not apply (the copy back would be skipped)
(defk goes (n)
  (declare (fixnum n))
  (let ((s 0.0) (q (sin 0.0)))
    (declare (single-float s q))
    (tagbody
       (dotimes (i n) (setq s (+ s 2.0 q)) (when (> i 2) (go out)))
     out)
    (list s (cos 0.0))))
(check "GO out of the loop" (goes 10) (list 8.0 1.0))
;; the loop rebinds one of the names: that one is left alone, and its outer value is untouched
(defk shadowed (n)
  (declare (fixnum n))
  (let ((s 1.0) (k 2.0) (z (sin 0.0)))
    (declare (single-float s k z))
    (dotimes (i n) (let ((k 10.0)) (declare (single-float k)) (setq s (+ s k z))))
    (list s k (cos 0.0))))
(check "shadowed name" (shadowed 3) (list 31.0 2.0 1.0))
;; a macro of the program's own inside the loop: no rewrite (its expansion names S)
(defmacro bump-s () 's)
(defk with-macro (n)
  (declare (fixnum n))
  (let ((s 0.0) (z (sin 0.0)))
    (declare (single-float s z))
    (dotimes (i n) (setq s (+ (bump-s) 1.0 z)))
    (list s (cos 0.0))))
(check "user macro" (with-macro 4) (list 4.0 1.0))
;; only read: no copy back, the outer value is the same
(defk read-only (n)
  (declare (fixnum n))
  (let ((k 1.5) (acc 0) (z (sin 0.0)))
    (declare (single-float k z) (fixnum acc))
    (dotimes (i n) (when (> (+ k z) 1.0) (setq acc (+ acc 1))))
    (list acc k (cos 0.0))))
(check "read only" (read-only 7) (list 7 1.5 1.0))

#+modus (check "accum's loop keeps its floats in registers" (> (count-of 'accum "FP-MOV") 0) t)

(format t "fp-regions: ~d checks, ~d failed~%" *checks* *fails*)
(if (zerop *fails*) (format t "PASS~%") (format t "FAIL~%"))
