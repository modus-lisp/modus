  (handler-case (IN-PACKAGE "CL-TEST") (t (c) nil))
)
(defun run-ansi-subtypep-complex-chunk-1 ()
  (handler-case (run-test-mv 25142 (lambda () (multiple-value-list (SUBTYPEP* 'COMPLEX 'NUMBER))) '(T
                                                                                    T)) (t (c) (%test-crash-fail-c 25142 c)))
  (handler-case (run-test-mv 25143 (lambda () (multiple-value-list (SUBTYPEP* 'NUMBER 'COMPLEX))) '(NIL
                                                                                    T)) (t (c) (%test-crash-fail-c 25143 c)))
  (handler-case (run-test 25144 (lambda () (MAPCAN #'CHECK-NOT-COMPLEX-TYPE
                                   '(BIT UNSIGNED-BYTE INTEGER RATIONAL RATIO
                                         REAL FLOAT SHORT-FLOAT SINGLE-FLOAT
                                         DOUBLE-FLOAT LONG-FLOAT FIXNUM BIGNUM))) 'NIL) (t (c) (%test-crash-fail-c 25144 c)))
  (handler-case (run-test 25145 (lambda () (LOOP FOR I FROM 1 TO 100
                                 NCONC (CHECK-NOT-COMPLEX-TYPE
                                        `(UNSIGNED-BYTE ,I)))) 'NIL) (t (c) (%test-crash-fail-c 25145 c)))
  (handler-case (run-test 25146 (lambda () (LOOP FOR I FROM 1 TO 100
                                 NCONC (CHECK-NOT-COMPLEX-TYPE
                                        `(SIGNED-BYTE ,I)))) 'NIL) (t (c) (%test-crash-fail-c 25146 c)))
  (handler-case (run-test 25147 (lambda () (LET ((TYPES '(COMPLEX (COMPLEX) (COMPLEX *))))
                             (LOOP FOR TP1 IN TYPES
                                   NCONC (LOOP FOR TP2 IN TYPES
                                               FOR RESULT = (MULTIPLE-VALUE-LIST
                                                             (SUBTYPEP* TP1
                                                              TP2))
                                               UNLESS (EQUAL RESULT '(T T))
                                               COLLECT (LIST TP1 TP2 RESULT))))) 'NIL) (t (c) (%test-crash-fail-c 25147 c)))
  (handler-case (run-test 25148 (lambda () (LET ((TYPES
                                  (REVERSE
                                   '(BIT FIXNUM BIGNUM INTEGER UNSIGNED-BYTE
                                         RATIONAL RATIO SHORT-FLOAT
                                         SINGLE-FLOAT DOUBLE-FLOAT LONG-FLOAT
                                         FLOAT REAL)))
                                 (FLOAT-TYPES
                                  (REMOVE-DUPLICATES
                                   '(SHORT-FLOAT SINGLE-FLOAT DOUBLE-FLOAT
                                     LONG-FLOAT)
                                   :TEST
                                   #'(LAMBDA (T1 T2)
                                       (EQL (COERCE 0 T1) (COERCE 0 T2))))))
                             (LOOP FOR I IN '(1 2 3 4 6 8 13 16 17 28 29 31 32
                                              48 64)
                                   DO (PUSH `(UNSIGNED-BYTE ,I) TYPES)
                                   DO (PUSH `(SIGNED-BYTE ,I) TYPES)
                                   DO (LOOP FOR FTP IN FLOAT-TYPES
                                            DO (PUSH
                                                `(,FTP ,(COERCE 0 FTP)
                                                  ,(COERCE I FTP))
                                                TYPES)
                                            DO (PUSH
                                                `(,FTP (,(COERCE (- I) FTP))
                                                  ,(COERCE I FTP))
                                                TYPES))
                                   DO (PUSH
                                       `(FLOAT ,(COERCE 0 'SINGLE-FLOAT)
                                               ,(COERCE I 'SINGLE-FLOAT))
                                       TYPES))
                             (SETQ TYPES (REVERSE TYPES))
                             (LET ((RESULTS
                                    (MAPCAN
                                     #'(LAMBDA (T1)
